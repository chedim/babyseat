 {
  "name": "a family's declared methods: a read passes",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "tests/specs/fixtures/door_std_demo.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/demo",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "192.168.1.9:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner",
      "name": "Owner"
     },
     "auth_error": null
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.method",
    "equals": "GET"
   }
  ]
 },
 {
  "name": "a method the family did not declare is a 405 with allow",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "tests/specs/fixtures/door_std_demo.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/demo",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "192.168.1.9:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner",
      "name": "Owner"
     },
     "auth_error": null
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 405
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.allow",
    "equals": "GET"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.error",
    "equals": "method not allowed"
   }
  ]
 },
