[
 {
  "name": "facts is the launcher's dict",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "facts": {
      "seat_version": "1.0",
      "seat_name": "Nebo"
     }
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/x",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "192.168.1.9:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner",
      "name": "Owner"
     },
     "auth_error": null
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "facts.seat_version",
    "equals": "1.0"
   },
   {
    "eid": "Request:1",
    "prop": "facts.seat_name",
    "equals": "Nebo"
   }
  ]
 },
