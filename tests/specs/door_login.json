[
 {
  "name": "a valid person's token becomes the cookie",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f"
  ],
  "given": [
   {
    "eid": "Http:door",
    "class": "Http",
    "props": {}
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "query": "",
     "peer": "192.168.1.20:5000",
     "authed": false,
     "auth_error": "no token"
    }
   }
  ],
  "writes": [
   {
    "eid": "Http:door",
    "prop": "listen",
    "value": {
     "id": "l",
     "port": 0,
     "secret_file": "tests/specs/fixtures/jwt.secret"
    }
   },
   {
    "eid": "Request:1",
    "prop": "http",
    "value": "Http:door"
   },
   {
    "eid": "Request:1",
    "prop": "method",
    "value": "POST"
   },
   {
    "eid": "Request:1",
    "prop": "headers",
    "value": {
     "content-type": "application/json"
    }
   },
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvd25lciIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwLCJuYW1lIjoiT3duZXIifQ.AaVTM8jSb9mpYU5XQGs0zoUVw2_kMPZ-lSDhe6s9YTw\"}"
   },
   {
    "eid": "Request:1",
    "prop": "path",
    "value": "/ui/login"
   }
  ],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.ok",
    "equals": true
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.who.sub",
    "equals": "owner"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.who.name",
    "equals": "Owner"
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.cache-control",
    "equals": "no-store"
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.set-cookie",
    "contains": "membrane_jwt_23a8086e=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvd25lciIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwLCJuYW1lIjoiT3duZXIifQ.AaVTM8jSb9mpYU5XQGs0zoUVw2_kMPZ-lSDhe6s9YTw; Path=/; Max-Age="
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.set-cookie",
    "contains": "; HttpOnly; SameSite=Strict"
   }
  ]
 },
 {
  "name": "behind an https proxy the cookie is Secure",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f"
  ],
  "given": [
   {
    "eid": "Http:door",
    "class": "Http",
    "props": {}
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "query": "",
     "peer": "192.168.1.20:5000",
     "authed": false,
     "auth_error": "no token"
    }
   }
  ],
  "writes": [
   {
    "eid": "Http:door",
    "prop": "listen",
    "value": {
     "id": "l",
     "port": 0,
     "secret_file": "tests/specs/fixtures/jwt.secret"
    }
   },
   {
    "eid": "Request:1",
    "prop": "http",
    "value": "Http:door"
   },
   {
    "eid": "Request:1",
    "prop": "method",
    "value": "POST"
   },
   {
    "eid": "Request:1",
    "prop": "headers",
    "value": {
     "content-type": "application/json",
     "x-forwarded-proto": "https"
    }
   },
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvd25lciIsImV4cCI6NDEwMjQ0NDgwMCwiaWF0IjoxNzAwMDAwMDAwLCJuYW1lIjoiT3duZXIifQ.AaVTM8jSb9mpYU5XQGs0zoUVw2_kMPZ-lSDhe6s9YTw\"}"
   },
   {
    "eid": "Request:1",
    "prop": "path",
    "value": "/ui/login"
   }
  ],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.set-cookie",
    "contains": "; Secure"
   }
  ]
 },
