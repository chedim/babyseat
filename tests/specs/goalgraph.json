 {
  "name": "goalgraph: a finished task keeps a result entity and its receipt",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
    "props": {
     "status": "open"
    }
   },
   {
    "eid": "Task:gx:a",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "status": "running",
     "title": "first"
    }
   }
  ],
  "writes": [
   {
    "eid": "Task:gx:a",
    "prop": "finish",
    "value": {
     "verdict": "done",
     "detail": "did it"
    }
   }
  ],
  "expect": [
   {
    "eid": "Task:gx:a",
    "prop": "status",
    "equals": "done"
   },
   {
    "eid": "Task:gx:a",
    "prop": "receipt",
    "equals": "did it"
   },
   {
    "eid": "Task:gx:a",
    "prop": "runs",
    "equals": 1
   },
   {
    "eid": "Task:gx:a",
    "prop": "result",
    "equals": "Result:gx:a:1"
   },
   {
    "eid": "Result:gx:a:1",
    "prop": "outcome",
    "equals": "done"
   },
   {
    "eid": "Result:gx:a:1",
    "prop": "task",
    "equals": "Task:gx:a"
   }
  ]
 },
