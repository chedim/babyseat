 {
  "name": "goalgraph: the planner is told the goal, why it was called and every node of the graph",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
    "props": {
     "status": "open",
     "text": "ship it",
     "replan": "task Task:gx:a done"
    }
   },
   {
    "eid": "Task:gx:a",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "title": "build",
     "status": "done",
     "receipt": "built ok"
    }
   },
   {
    "eid": "Task:gx:c",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "title": "lint",
     "status": "running",
     "blocks": [
      "Task:gx:b"
     ]
    }
   },
   {
    "eid": "Task:gx:b",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "title": "test",
     "status": "open"
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Goal:gx",
    "prop": "planner_text",
    "contains": "You are the PLANNER for goal Goal:gx: ship it"
   },
   {
    "eid": "Goal:gx",
    "prop": "planner_text",
    "contains": "- task Task:gx:a [done] build -- receipt: built ok"
   },
   {
    "eid": "Goal:gx",
    "prop": "planner_text",
    "contains": "- task Task:gx:b [open] test (waits on Task:gx:c)"
   },
   {
    "eid": "Goal:gx",
    "prop": "planner_text",
    "contains": "FULFILLED"
   }
  ]
 },
