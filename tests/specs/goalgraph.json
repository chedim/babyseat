    "eid": "Goal:gx",
    "prop": "plan",
    "value": {
     "tasks": [
      {
       "key": "a",
       "title": "first"
      },
      {
       "key": "b",
       "title": "second",
       "after": [
        "a"
       ]
      }
     ]
    }
   },
   {
    "eid": "Task:gx:a",
    "prop": "status",
    "value": "done"
   }
  ],
  "expect": [
   {
    "eid": "Task:gx:b",
    "prop": "status",
    "equals": "owed"
   }
  ]
 },
 {
  "name": "goalgraph: a plan whose edges close a cycle is refused whole",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
    "props": {
     "status": "open"
    }
   }
  ],
  "writes": [
   {
    "eid": "Goal:gx",
    "prop": "plan",
    "value": {
     "tasks": [
      {
       "key": "a",
       "after": [
        "b"
       ]
      },
      {
       "key": "b",
       "after": [
        "a"
       ]
      }
     ]
    }
   }
  ],
  "expect": [
   {
    "eid": "Goal:gx",
    "prop": "plan_result",
    "equals": {
     "ok": false,
     "error": "refused: these edges close a cycle: Task:gx:b -> Task:gx:a"
    }
   }
  ]
 },
 {
  "name": "goalgraph: a stuck task listed again is retried, a done one only with redo",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
    "props": {
     "status": "open"
    }
   },
   {
    "eid": "Task:gx:a",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "status": "stuck"
    }
   },
   {
    "eid": "Task:gx:b",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "status": "done"
    }
   },
   {
    "eid": "Task:gx:c",
    "class": "Task",
    "props": {
     "goal": "Goal:gx",
     "status": "done"
    }
   }
  ],
  "writes": [
   {
    "eid": "Goal:gx",
    "prop": "plan",
    "value": {
     "tasks": [
      {
       "key": "a"
      },
      {
       "key": "b"
      },
      {
       "key": "c",
       "redo": true
      }
     ]
    }
   }
  ],
  "expect": [
   {
    "eid": "Goal:gx",
    "prop": "plan_result",
    "equals": {
     "ok": true,
     "tasks": [],
     "reopened": [
      "Task:gx:a",
      "Task:gx:c"
     ]
    }
   },
   {
    "eid": "Task:gx:b",
    "prop": "status",
    "equals": "done"
   },
   {
    "eid": "Task:gx:a",
    "prop": "status",
    "equals": "owed"
   }
  ]
 },
