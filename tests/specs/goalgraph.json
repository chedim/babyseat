[
 {
  "name": "goalgraph: a plan makes its tasks, the one with nothing in its way is owed, the next waits",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
    "props": {
     "status": "open"
    }
   }
  ],
  "writes": [
   {
    "eid": "Goal:gx",
    "prop": "plan",
    "value": {
     "tasks": [
      {
       "key": "a",
       "title": "first"
      },
      {
       "key": "b",
       "title": "second",
       "after": [
        "a"
       ]
      }
     ]
    }
   }
  ],
  "expect": [
   {
    "eid": "Goal:gx",
    "prop": "plan_result",
    "equals": {
     "ok": true,
     "tasks": [
      "Task:gx:a",
      "Task:gx:b"
     ],
     "reopened": []
    }
   },
   {
    "eid": "Task:gx:a",
    "prop": "status",
    "equals": "owed"
   },
   {
    "eid": "Task:gx:b",
    "prop": "status",
    "equals": "open"
   },
   {
    "eid": "Task:gx:b",
    "prop": "open_blockers",
    "equals": 1
   },
   {
    "eid": "Task:gx:a",
    "prop": "blocks",
    "equals": [
     "Task:gx:b"
    ]
   }
  ]
 },
 {
  "name": "goalgraph: a task that ends frees what it blocks",
  "packs": [
   "membrane/packs/goalgraph.c1f"
  ],
  "given": [
   {
    "eid": "Goal:gx",
    "class": "Goal",
