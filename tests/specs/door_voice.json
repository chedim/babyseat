    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/membrane/voice",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "alice",
     "claims": {
      "sub": "alice"
     }
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 405
   },
   {
    "eid": "Request:1",
    "prop": "reply.headers.allow",
    "equals": "POST"
   }
  ]
 },
