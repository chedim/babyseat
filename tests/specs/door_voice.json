 {
  "name": "POST /ui/log appends the line to page-voice.log and answers 204",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/door_voice.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "facts": {
      "seat_data_dir": "/d"
     }
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/ui/log",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "alice",
     "claims": {
      "sub": "alice"
     },
     "conn": 7
    }
   }
  ],
  "writes": [
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"t\":1,\"heard\":\"hey\"}"
   }
  ],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 204
   },
   {
    "eid": "File:7",
    "prop": "path",
    "equals": "/d/page-voice.log"
   },
   {
    "eid": "File:7",
    "prop": "write_result.id",
    "equals": "w"
   }
  ]
 },
