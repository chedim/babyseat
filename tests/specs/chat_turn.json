   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/chat.c1f",
   "membrane/packs/chat_turn.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "chat_claude_bin": "/opt/fake/claude"
    }
   },
   {
    "eid": "Http:door",
    "class": "Http",
    "props": {
     "listen_result": {
      "port": 4321,
      "rc": 0,
      "host": "127.0.0.1"
     }
    }
   },
   {
    "eid": "membrane::Banner:owner:main",
    "class": "Banner",
    "props": {
     "chat": "main",
     "owner": "owner"
    }
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chatmessage"
     ],
     "text": "hi"
    }
   },
   {
    "eid": "membrane::Chat:message:1-1:turn",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chatturn"
     ],
     "message": "membrane::Chat:message:1-1",
     "state": "running"
    }
   },
   {
    "eid": "membrane::Command:chat:1-1",
    "class": "Command",
    "props": {}
   }
  ],
  "writes": [
   {
    "eid": "membrane::Command:chat:1-1",
    "prop": "run_result",
    "value": {
     "id": "1-1",
     "status": "ok",
     "rc": 0,
     "head": "",
     "stdout": "{\"type\": \"system\", \"subtype\": \"init\", \"session_id\": \"s1\", \"tools\": [\"mcp__membrane__entity_read\"]}\n{\"type\": \"stream_event\", \"event\": {\"type\": \"content_block_delta\", \"delta\": {\"type\": \"text_delta\", \"text\": \"Hel\"}}}\n{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"text\", \"text\": \"Let me look.\"}, {\"type\": \"tool_use\", \"id\": \"tu1\", \"name\": \"mcp__membrane__entity_read\", \"input\": {\"spec\": \"Goal:a\"}}]}}\n{\"type\": \"user\", \"message\": {\"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"tu1\", \"content\": [{\"type\": \"text\", \"text\": \"Goal:a (Goal) {}\"}]}]}}\n{\"type\": \"assistant\", \"message\": {\"content\": [{\"type\": \"tool_use\", \"id\": \"tu2\", \"name\": \"mcp__membrane__entity_write\", \"input\": {\"spec\": \"Goal:a\", \"prop\": \"status\", \"value\": \"open\"}}, {\"type\": \"text\", \"text\": \"Done.\"}]}}\n{\"type\": \"user\", \"message\": {\"content\": [{\"type\": \"tool_result\", \"tool_use_id\": \"tu2\", \"content\": \"wrote Goal:a.status\", \"is_error\": false}]}}\n{\"type\": \"result\", \"subtype\": \"success\", \"is_error\": false, \"result\": \"All done: Goal:a is open.\", \"num_turns\": 3, \"session_id\": \"s1\"}\n",
     "stderr": ""
    }
   }
  ],
  "expect": [
   {
    "eid": "membrane::Chat:message:1-1:turn",
    "prop": "status",
    "equals": "done"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:response",
    "prop": "text",
    "equals": "All done: Goal:a is open."
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:response",
    "prop": "error",
    "equals": false
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "tools_run",
    "equals": [
     "entity_read",
     "entity_write"
    ]
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu1",
    "prop": "name",
    "equals": "mcp__membrane__entity_read"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu1",
    "prop": "input.spec",
    "equals": "Goal:a"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu1",
    "prop": "result",
    "contains": "Goal:a (Goal)"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu2",
    "prop": "name",
    "equals": "mcp__membrane__entity_write"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu2",
    "prop": "input.prop",
    "equals": "status"
   },
   {
    "eid": "membrane::Chat:message:1-1:turn:tool:tu2",
    "prop": "result",
    "equals": "wrote Goal:a.status"
   }
  ]
 },
