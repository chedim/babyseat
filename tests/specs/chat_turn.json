    "prop": "argv.4",
    "equals": "--output-format"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.5",
    "equals": "stream-json"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.6",
    "equals": "--verbose"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.7",
    "equals": "--include-partial-messages"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.8",
    "equals": "--tools"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.9",
    "equals": ""
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.10",
    "equals": "--strict-mcp-config"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.11",
    "equals": "--mcp-config"
   },
   {
    "eid": "membrane::Chat:message:1-1",
    "prop": "argv.12",
    "equals": "{\"mcpServers\":{\"membrane\":{\"type\":\"http\",\"url\":\"http://127.0.0.1:4321/mcp\"}}}"
   },
