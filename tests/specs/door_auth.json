     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5000",
     "authed": false,
     "auth_error": "no token"
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 401
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.error.type",
    "equals": "unauthorized"
   }
  ]
 },
