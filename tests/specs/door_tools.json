    "eid": "Request:1",
    "prop": "reply.body.result.isError",
    "equals": false
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.content.0.type",
    "equals": "text"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.content.0.text",
    "contains": "wrote Scratch:a.color"
   },
   {
    "eid": "Scratch:a",
    "prop": "color",
    "equals": {
     "r": [
      1,
      2
     ]
    }
   }
  ]
 },
