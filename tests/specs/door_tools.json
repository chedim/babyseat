[
 {
  "name": "initialize answers the server's name, the tools capability and echoes the client's protocol version",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/store.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/door_tools.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "seat_version": "9.9",
     "facts": {
      "seat_version": "9.9"
     }
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/mcp",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"claude\", \"version\": \"1\"}}}",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.id",
    "equals": 1
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.jsonrpc",
    "equals": "2.0"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.protocolVersion",
    "equals": "2025-06-18"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.serverInfo.name",
    "equals": "membrane"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.serverInfo.version",
    "equals": "9.9"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.result.capabilities.tools.listChanged",
    "equals": false
   }
  ]
 },
