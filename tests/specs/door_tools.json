 {
  "name": "entity_write sets one property of an entity, and the reply says so",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/store.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/door_tools.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "seat_version": "9.9",
     "facts": {
      "seat_version": "9.9"
     }
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/mcp",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   },
   {
    "eid": "Scratch:a",
    "class": "Scratch",
    "props": {}
   }
  ],
  "writes": [
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"jsonrpc\": \"2.0\", \"id\": 5, \"method\": \"tools/call\", \"params\": {\"name\": \"entity_write\", \"arguments\": {\"spec\": \"Scratch:a\", \"prop\": \"color\", \"value\": {\"r\": [1, 2]}}}}"
   },
   {
    "eid": "Request:1",
    "prop": "reactions",
    "value": []
   }
  ],
  "expect": [
