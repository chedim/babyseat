[
 {
  "name": "one way to start a turn: the plan: the claude CLI: the backend is claude and its start is the argv and stdin of the CLI",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/semtext.c1f",
   "membrane/packs/chat.c1f",
   "membrane/packs/model_chat.c1f",
   "membrane/packs/chat_turn.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "seat_default": "claude",
     "chat_claude_bin": "/opt/fake/claude",
     "anthropic_key_set": true
    }
   },
   {
    "eid": "Http:door",
    "class": "Http",
    "props": {
     "listen_result": {
      "port": 4321,
      "rc": 0,
      "host": "127.0.0.1"
     }
    }
   },
   {
    "eid": "membrane::Banner:admin:main",
    "class": "Banner",
    "props": {
     "chat": "main",
     "admin": "admin"
    }
   },
   {
    "eid": "membrane::Chat:main:message:1-1",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chat",
      "cls:chatmessage"
     ],
     "text": "hello",
     "queued": true
    }
   },
   {
    "eid": "membrane::Chat:main:message:1-1:turn",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chat",
      "cls:chatturn"
     ],
     "message": "membrane::Chat:main:message:1-1"
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "membrane::Chat:main:message:1-1",
    "prop": "backend",
    "equals": "claude"
   },
   {
    "eid": "membrane::Chat:main:message:1-1",
    "prop": "plan.backend",
    "equals": "claude"
   },
   {
    "eid": "membrane::Chat:main:message:1-1",
    "prop": "plan.start.argv.0",
    "equals": "env"
   },
   {
    "eid": "membrane::Chat:main:message:1-1",
    "prop": "plan.start.stdin",
    "contains": "hello"
   },
   {
    "eid": "membrane::Chat:main:message:1-1",
    "prop": "plan.refuse",
    "none": true
   }
  ]
 },
