[
 {
  "name": "POST a message is a 202 with its id, and the message is an entity under Chat:main with its text",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/chat.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/membrane/chat/message",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   }
  ],
  "writes": [
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"text\": \"hello there\"}"
   }
  ],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 202
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.id",
    "equals": "2000-1"
   },
   {
    "eid": "membrane::Chat:message:2000-1",
    "prop": "text",
    "equals": "hello there"
   },
   {
    "eid": "membrane::Chat:message:2000-1",
    "prop": "parents",
    "equals": [
     "cls:chatmessage"
    ]
   },
   {
    "eid": "membrane::Chat:main",
    "prop": "name",
    "equals": "main"
   },
   {
    "eid": "membrane::Chat:message:2000-1",
    "prop": "queued",
    "equals": true
   }
  ]
 },
