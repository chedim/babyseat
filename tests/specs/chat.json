 {
  "name": "GET a message that is waiting says queued, with its text and no response",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/chat.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/membrane/chat/message/9-9",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   },
   {
    "eid": "membrane::Chat:message:9-9",
    "class": "Chat",
    "props": {
     "text": "q?",
     "parents": [
      "cls:chatmessage"
     ]
    }
   },
   {
    "eid": "membrane::Chat:message:9-9:turn",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chatturn"
     ],
     "message": "membrane::Chat:message:9-9"
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.id",
    "equals": "9-9"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.text",
    "equals": "q?"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.state",
    "equals": "queued"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.response",
    "none": true
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.tools",
    "equals": []
   }
  ]
 },
 {
  "name": "GET a message that was answered gives the response text, the state and the tools it ran",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/chat.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/membrane/chat/message/9-9",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   },
   {
    "eid": "membrane::Chat:message:9-9",
    "class": "Chat",
    "props": {
     "text": "q?",
     "tools_run": [
      "entity_read"
     ],
     "parents": [
      "cls:chatmessage"
     ]
    }
   },
   {
    "eid": "membrane::Chat:message:9-9:turn",
    "class": "Chat",
    "props": {
     "parents": [
      "cls:chatturn"
     ],
     "message": "membrane::Chat:message:9-9",
     "state": "done"
    }
   },
   {
    "eid": "membrane::Chat:message:9-9:turn:response",
    "class": "Chat",
    "props": {
     "text": "the answer",
     "parents": [
      "cls:chatresponse"
     ]
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.body.state",
    "equals": "done"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.response",
    "equals": "the answer"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.tools",
    "equals": [
     "entity_read"
    ]
   }
  ]
 },
