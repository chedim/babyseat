[
 {
  "name": "tag rows become Model entities: the opencode screen (name markers, caps, size) decides which are chat-capable",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/router.c1f"
  ],
  "given": [
   {
    "eid": "Fetch:tags",
    "class": "Fetch",
    "props": {}
   },
   {
    "eid": "Request:7",
    "class": "Request",
    "props": {}
   }
  ],
  "writes": [
   {
    "eid": "Fetch:tags",
    "prop": "request_result",
    "value": {
     "id": "Request:7",
     "status": "ok",
     "rc": 0,
     "body": "{\"models\": [{\"name\": \"glm-4:9b\", \"size\": 5000000000, \"capabilities\": [\"completion\", \"tools\"]}, {\"name\": \"nomic-embed-text:latest\", \"size\": 270000000}, {\"name\": \"vision:7b\", \"size\": 4000000000, \"capabilities\": [\"completion\", \"vision\"]}, {\"name\": \"huge:70b\", \"size\": 40000000000}, {\"name\": \"kimi:cloud\", \"size\": 0, \"remote_host\": \"https://x\"}, {\"name\": \"plain:1b\", \"size\": 1000000000}]}"
    }
   }
  ],
  "expect": [
   {
    "eid": "Model:glm-4:9b",
    "prop": "chat_ok",
    "equals": true
   },
   {
    "eid": "Model:glm-4:9b",
    "prop": "kind",
    "equals": "local"
   },
   {
    "eid": "Model:nomic-embed-text:latest",
    "prop": "chat_ok",
    "equals": false
   },
   {
    "eid": "Model:vision:7b",
    "prop": "chat_ok",
    "equals": false
   },
   {
    "eid": "Model:huge:70b",
    "prop": "chat_ok",
    "equals": false
   },
   {
    "eid": "Model:kimi:cloud",
    "prop": "kind",
    "equals": "cloud"
   },
   {
    "eid": "Model:kimi:cloud",
    "prop": "chat_ok",
    "equals": true
   },
   {
    "eid": "Model:plain:1b",
    "prop": "chat_ok",
    "equals": true
   },
   {
    "eid": "Model:plain:1b",
    "prop": "backend",
    "equals": "ollama"
   },
   {
    "eid": "Request:7",
    "prop": "models_ready",
    "equals": true
   }
  ]
 },
 {
  "name": "a model the backend stopped listing stays an entity, listed = false; a refused fetch lists nothing",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/router.c1f"
  ],
  "given": [
   {
    "eid": "Fetch:tags",
    "class": "Fetch",
    "props": {}
   },
   {
    "eid": "Request:7",
    "class": "Request",
    "props": {}
   },
   {
    "eid": "Model:old:1b",
    "class": "Model",
    "props": {
     "name": "old:1b",
     "kind": "local",
     "listed": true,
     "size": 1000000000
    }
   }
  ],
  "writes": [
   {
    "eid": "Fetch:tags",
    "prop": "request_result",
    "value": {
     "id": "Request:7",
     "status": "error",
     "rc": 1,
     "head": "connect: refused"
    }
   }
  ],
  "expect": [
   {
    "eid": "Model:old:1b",
    "prop": "listed",
    "equals": false
   },
   {
    "eid": "Request:7",
    "prop": "models_ready",
    "equals": true
   }
  ]
 },
 {
  "name": "boot facts make the cloud rungs Model entities",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/router.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "cloud_models": [
      {
       "name": "claude-sonnet",
       "backend": "claude-agent"
      },
      {
       "name": "gpt-x",
       "backend": "openai"
      }
     ]
    }
   }
  ],
  "writes": [
   {
    "eid": "Boot:seat",
    "prop": "started",
    "value": 5
   }
  ],
  "expect": [
   {
    "eid": "Model:claude-sonnet",
    "prop": "rung",
    "equals": true
   },
   {
    "eid": "Model:claude-sonnet",
    "prop": "backend",
    "equals": "claude-agent"
   },
   {
    "eid": "Model:claude-sonnet",
    "prop": "kind",
    "equals": "cloud"
   },
   {
    "eid": "Model:gpt-x",
    "prop": "owner",
    "equals": "membrane->openai"
   }
  ]
 },
 {
  "name": "/v1/models lists the screened models, the sentinel lane, the autoselect lanes and the rungs, with their owners",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/fetch.c1f",
   "membrane/packs/router.c1f",
   "membrane/packs/door_models.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "router_on": true
    }
   },
   {
    "eid": "Model:glm-4:9b",
    "class": "Model",
    "props": {
     "name": "glm-4:9b",
     "kind": "local",
     "listed": true,
     "size": 5000000000,
     "capabilities": [
      "completion",
      "tools"
     ],
     "backend": "ollama"
    }
   },
   {
    "eid": "Model:nomic-embed-text:latest",
    "class": "Model",
    "props": {
     "name": "nomic-embed-text:latest",
     "kind": "local",
     "listed": true,
     "size": 270000000,
     "backend": "ollama"
    }
   },
   {
    "eid": "Model:gone:1b",
    "class": "Model",
    "props": {
     "name": "gone:1b",
     "kind": "local",
     "listed": false,
     "size": 1000000000,
     "backend": "ollama"
    }
   },
   {
    "eid": "Model:claude-sonnet",
    "class": "Model",
    "props": {
     "name": "claude-sonnet",
     "kind": "cloud",
     "rung": true,
     "listed": true,
     "backend": "claude-agent"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "path": "/v1/models",
     "models_asked": true,
     "models_ready": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     }
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.object",
    "equals": "list"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.0.id",
    "equals": "glm-4:9b"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.0.owned_by",
    "equals": "membrane->ollama"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.1.id",
    "equals": "@explore"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.2.id",
    "equals": "autoselect"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.2.owned_by",
    "equals": "membrane-router"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.3.id",
    "equals": "autoselect-local"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.4.id",
    "equals": "claude-sonnet"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.4.owned_by",
    "equals": "membrane->claude-agent"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.data.5",
    "none": true
   }
  ]
 },
