     "seat_named": true,
     "seat_aliases": [
      "neb"
     ],
     "seat_stt": "http://127.0.0.1:8080",
     "seat_voice_out": true,
     "seat_language": "en",
     "seat_blurp": false
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/ui/conf",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5555",
     "authed": false,
     "auth_error": "no token"
    }
   }
  ],
  "writes": [],
