[
{"name": "lanes: a planner pass is a message in the chat gg, and the turn's answer is the planner reply and its claim",
 "packs": ["membrane/packs/boot.c1f", "membrane/packs/fs.c1f", "membrane/packs/proc.c1f", "membrane/packs/banner.c1f", "membrane/packs/door.c1f", "membrane/packs/semtext.c1f", "membrane/packs/chat.c1f", "membrane/packs/goalgraph.c1f", "membrane/packs/goalgraph_lanes.c1f"],
 "given": [{"eid": "Pool:workers", "class": "Pool", "props": {"size": 3}}, {"eid": "Goal:gx", "class": "Goal", "props": {"status": "open", "text": "ship it"}}, {"eid": "membrane::Chat:gg:message:2000000-00000001:turn:response", "class": "Chat", "props": {"text": "PLANNED x\nFULFILLED all done"}}],
 "writes": [{"eid": "Goal:gx", "prop": "replan", "value": "first look"}, {"eid": "Pool:workers", "prop": "pump", "value": 1}],
 "expect": [{"eid": "Goal:gx", "prop": "plan_msg", "equals": null}, {"eid": "membrane::Chat:gg:message:2000000-00000001", "prop": "text", "contains": "You are the PLANNER for goal Goal:gx"}, {"eid": "membrane::Chat:gg:message:2000000-00000001", "prop": "queued", "equals": true}, {"eid": "Goal:gx", "prop": "planner_reply", "contains": "FULFILLED all done"}, {"eid": "Goal:gx", "prop": "claim", "equals": "all done"}]},
{"name": "lanes: a taken task is a worker message in the chat gg, and the turn's last verdict line ends it",
 "packs": ["membrane/packs/boot.c1f", "membrane/packs/fs.c1f", "membrane/packs/proc.c1f", "membrane/packs/banner.c1f", "membrane/packs/door.c1f", "membrane/packs/semtext.c1f", "membrane/packs/chat.c1f", "membrane/packs/goalgraph.c1f", "membrane/packs/goalgraph_lanes.c1f"],
 "given": [{"eid": "Pool:workers", "class": "Pool", "props": {"size": 3}}, {"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Task:gx:a", "class": "Task", "props": {"goal": "Goal:gx", "title": "build"}}, {"eid": "membrane::Chat:gg:message:2000000-00000001:turn:response", "class": "Chat", "props": {"text": "ran it\nDONE built it"}}],
 "writes": [{"eid": "Task:gx:a", "prop": "status", "value": "owed"}, {"eid": "Pool:workers", "prop": "pump", "value": 1}, {"eid": "Pool:workers", "prop": "pump", "value": 2}],
 "expect": [{"eid": "Task:gx:a", "prop": "worker_msg", "equals": null}, {"eid": "membrane::Chat:gg:message:2000000-00000001", "prop": "text", "contains": "You are a WORKER on task Task:gx:a of goal Goal:gx."}, {"eid": "membrane::Chat:gg:message:2000000-00000001", "prop": "queued", "equals": true}, {"eid": "Task:gx:a", "prop": "status", "equals": "done"}, {"eid": "Task:gx:a", "prop": "receipt", "equals": "built it"}]},
{"name": "lanes: at boot a task running or owed goes back to the pool, a done one stays",
 "packs": ["membrane/packs/boot.c1f", "membrane/packs/fs.c1f", "membrane/packs/proc.c1f", "membrane/packs/banner.c1f", "membrane/packs/door.c1f", "membrane/packs/semtext.c1f", "membrane/packs/chat.c1f", "membrane/packs/goalgraph.c1f", "membrane/packs/goalgraph_lanes.c1f"],
 "given": [{"eid": "Boot:seat", "class": "Boot", "props": {}}, {"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Task:gx:a", "class": "Task", "props": {"goal": "Goal:gx", "status": "running"}}, {"eid": "Task:gx:b", "class": "Task", "props": {"goal": "Goal:gx", "status": "done"}}],
 "writes": [{"eid": "Boot:seat", "prop": "started", "value": 5}],
 "expect": [{"eid": "Task:gx:a", "prop": "status", "equals": "owed"}, {"eid": "Task:gx:b", "prop": "status", "equals": "done"}]},
{"name": "goalgraph: a not-yet-run task given a sub-task becomes split",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Task:gx:p", "class": "Task", "props": {"goal": "Goal:gx", "status": "owed"}}, {"eid": "Task:gx:q", "class": "Task", "props": {"goal": "Goal:gx", "status": "done"}}],
 "writes": [{"eid": "Goal:gx", "prop": "plan", "value": {"tasks": [{"key": "s1", "title": "part", "parent": "p"}, {"key": "s2", "title": "part of a done one", "parent": "q"}]}}],
 "expect": [{"eid": "Task:gx:p", "prop": "status", "equals": "split"}, {"eid": "Task:gx:q", "prop": "status", "equals": "done"}]},
{"name": "goalgraph: a worker reply with no verdict but a trace is a step: the task is owed again with what it said, up to twice",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Pool:workers", "class": "Pool", "props": {"size": 3}}, {"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Task:gx:a", "class": "Task", "props": {"goal": "Goal:gx", "title": "build", "status": "running"}}],
 "writes": [{"eid": "Task:gx:a", "prop": "worker_reply", "value": "fixed 3 of 5 tests"}, {"eid": "Pool:workers", "prop": "pump", "value": 1}],
 "expect": [{"eid": "Task:gx:a", "prop": "continues", "equals": 1}, {"eid": "Task:gx:a", "prop": "worker_prompt", "contains": "fixed 3 of 5 tests"}, {"eid": "Task:gx:a", "prop": "status", "equals": "running"}]},
{"name": "goalgraph: a third reply with no verdict leaves the task stuck",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Task:gx:a", "class": "Task", "props": {"goal": "Goal:gx", "status": "running", "continues": 2}}],
 "writes": [{"eid": "Task:gx:a", "prop": "worker_reply", "value": "still going"}],
 "expect": [{"eid": "Task:gx:a", "prop": "status", "equals": "stuck"}]},
{"name": "goalgraph: a plan makes a wait with a method condition",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}],
 "writes": [{"eid": "Goal:gx", "prop": "plan", "value": {"waits": [{"key": "w", "title": "ci", "condition": {"method": "ci.status", "args": ["main"], "equals": "green"}, "every_s": 30, "deadline_min": 20}]}}],
 "expect": [{"eid": "Goal:gx", "prop": "plan_result.ok", "equals": true}, {"eid": "Wait:gx:w", "prop": "status", "equals": "armed"}]},
{"name": "goalgraph: a method wait runs its method on its beat and is done when the last result is what it waits for",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Wait:gx:w", "class": "Wait", "props": {"goal": "Goal:gx", "status": "armed", "armed_ts": 1, "every_s": 10, "deadline_min": 20, "condition": {"method": "ci.status", "args": ["main"], "equals": "green"}, "method_seen": "green"}}],
 "writes": [{"eid": "Wait:gx:w", "prop": "check", "value": 100}],
 "expect": [{"eid": "Wait:gx:w", "prop": "method_call", "equals": 100}, {"eid": "Wait:gx:w", "prop": "status", "equals": "done"}, {"eid": "Wait:gx:w", "prop": "receipt", "equals": "ci.status = green"}]},
{"name": "goalgraph: a method wait whose last result is something else stays armed",
 "packs": ["membrane/packs/goalgraph.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Wait:gx:w", "class": "Wait", "props": {"goal": "Goal:gx", "status": "armed", "armed_ts": 1, "every_s": 10, "deadline_min": 20, "condition": {"method": "ci.status", "args": ["main"], "equals": "green"}, "method_seen": "red"}}],
 "writes": [{"eid": "Wait:gx:w", "prop": "check", "value": 100}],
 "expect": [{"eid": "Wait:gx:w", "prop": "method_call", "equals": 100}, {"eid": "Wait:gx:w", "prop": "status", "equals": "armed"}, {"eid": "Wait:gx:w", "prop": "last_check_result", "equals": "ci.status = red"}]},
{"name": "methods: the method call of a wait runs the method's command with the args",
 "packs": ["membrane/packs/boot.c1f", "membrane/packs/proc.c1f", "membrane/packs/goalgraph.c1f", "membrane/packs/goalgraph_methods.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Command:ci_status", "class": "Command", "props": {"cmd": ["echo"]}}, {"eid": "Wait:gx:w", "class": "Wait", "props": {"goal": "Goal:gx", "status": "armed", "condition": {"method": "ci.status", "args": ["main"], "equals": "green"}}}],
 "writes": [{"eid": "Wait:gx:w", "prop": "method_call", "value": 100}],
 "expect": [{"eid": "Wait:gx:w", "prop": "method_cmd", "equals": "Command:ci_status"}, {"eid": "Command:ci_status", "prop": "run_result.stdout", "equals": "main\n"}]},
{"name": "methods: what the last run printed is what the wait saw, a failed run is seen as failed",
 "packs": ["membrane/packs/boot.c1f", "membrane/packs/proc.c1f", "membrane/packs/goalgraph.c1f", "membrane/packs/goalgraph_methods.c1f"],
 "given": [{"eid": "Goal:gx", "class": "Goal", "props": {"status": "open"}}, {"eid": "Command:ci_status", "class": "Command", "props": {"cmd": "true"}}, {"eid": "Command:ci_bad", "class": "Command", "props": {"cmd": "true"}}, {"eid": "Wait:gx:w", "class": "Wait", "props": {"goal": "Goal:gx", "status": "armed", "condition": {"method": "ci.status", "args": [], "equals": "green"}}}, {"eid": "Wait:gx:v", "class": "Wait", "props": {"goal": "Goal:gx", "status": "armed", "condition": {"method": "ci.bad", "args": [], "equals": "green"}}}],
 "writes": [{"eid": "Command:ci_status", "prop": "run_result", "value": {"rc": 0, "stdout": "green\n"}}, {"eid": "Command:ci_bad", "prop": "run_result", "value": {"rc": 2, "stdout": ""}}],
 "expect": [{"eid": "Wait:gx:w", "prop": "method_seen", "equals": "green"}, {"eid": "Wait:gx:v", "prop": "method_seen", "equals": "(failed rc 2)"}]},
 {
  "name": "lanes: a lane whose answer has not landed keeps its message id, and the pump does not look at goals with no lane waiting",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/fs.c1f",
   "membrane/packs/proc.c1f",
   "membrane/packs/banner.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/semtext.c1f",
   "membrane/packs/chat.c1f",
   "membrane/packs/goalgraph.c1f",
   "membrane/packs/goalgraph_lanes.c1f"
  ],
  "given": [
   {
    "eid": "Pool:workers",
    "class": "Pool",
    "props": {
     "size": 3
    }
   },
   {
    "eid": "Goal:gw",
    "class": "Goal",
    "props": {
     "status": "open",
     "text": "ship it",
     "plan_msg": "2000000-00000009"
    }
   },
   {
    "eid": "Goal:gn",
    "class": "Goal",
    "props": {
     "status": "open",
     "text": "idle one"
    }
   }
  ],
  "writes": [
   {
    "eid": "Pool:workers",
    "prop": "pump",
    "value": 1
   }
  ],
  "expect": [
   {
    "eid": "Goal:gw",
    "prop": "plan_msg",
    "equals": "2000000-00000009"
   },
   {
    "eid": "Goal:gw",
    "prop": "planner_reply",
    "none": true
   },
   {
    "eid": "Goal:gn",
    "prop": "plan_msg",
    "none": true
   }
  ]
 }
]
