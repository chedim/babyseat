[
 {
  "name": "the seat panel read answers state, events and the controls",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/door_state.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "seat_version": "1.0"
    }
   },
   {
    "eid": "membrane::presence",
    "class": "Seat",
    "props": {
     "seat": "s",
     "state": {
      "paused": true,
      "loops": {
       "running": 1,
       "max": 4
      },
      "models": {
       "chat": "m1"
      },
      "seat_rss_mb": 900,
      "self": {
       "mode": "on",
       "born": true
      },
      "self_name": "Blurp",
      "ts": 5.0
     },
     "events": [
      {
       "ts": 1.0,
       "kind": "boot"
      }
     ]
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "query": "",
     "headers": {
      "content-type": "application/json"
     },
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "path": "/membrane/seat",
     "sub": "alice",
     "claims": {
      "sub": "alice"
     }
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.state.paused",
    "equals": true
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.state.loops.max",
    "equals": 4
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.events.0.kind",
    "equals": "boot"
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.controls",
    "equals": [
     "paused",
     "loops_max",
     "self",
     "accept",
     "self_name"
    ]
   }
  ]
 },
