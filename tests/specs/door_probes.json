[
 {
  "name": "health says healthy and the version",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x",
     "seat_version": "1.0",
     "seat_cwd": "/seat",
     "seat_home": "/home/u",
     "seat_project": "proj-1"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "GET",
     "path": "/global/health",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "192.168.1.20:5000",
     "authed": true,
     "sub": "owner",
     "claims": {
      "sub": "owner"
     },
     "auth_error": null
    }
   }
  ],
  "writes": [],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.healthy",
    "equals": true
   },
   {
    "eid": "Request:1",
    "prop": "reply.body.version",
    "equals": "1.0"
   }
  ]
 },
