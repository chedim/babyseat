 {
  "name": "a thumbs-up lands as a Feedback entity per reply",
  "packs": [
   "membrane/packs/boot.c1f",
   "membrane/packs/door.c1f",
   "membrane/packs/door_self.c1f"
  ],
  "given": [
   {
    "eid": "Boot:seat",
    "class": "Boot",
    "props": {
     "ui_dir": "/x"
    }
   },
   {
    "eid": "Request:1",
    "class": "Request",
    "props": {
     "method": "POST",
     "path": "/membrane/feedback",
     "query": "",
     "headers": {},
     "body": "",
     "peer": "127.0.0.1:5",
     "authed": true,
     "sub": "alice",
     "claims": {
      "sub": "alice"
     }
    }
   }
  ],
  "writes": [
   {
    "eid": "Request:1",
    "prop": "body",
    "value": "{\"message\": \"msg_1\", \"kind\": \"up\", \"session\": \"ses_1\"}"
   }
  ],
  "expect": [
   {
    "eid": "Request:1",
    "prop": "reply.status",
    "equals": 200
   },
   {
    "eid": "Request:1",
    "prop": "reply.body",
    "equals": {
     "ok": true,
     "eid": "Feedback:msg_1",
     "kind": "up"
    }
   },
   {
    "eid": "Feedback:msg_1",
    "prop": "kind",
    "equals": "up"
   },
   {
    "eid": "Feedback:msg_1",
    "prop": "session",
    "equals": "ses_1"
   },
   {
    "eid": "Feedback:msg_1",
    "prop": "message",
    "equals": "msg_1"
   },
   {
    "eid": "Feedback:msg_1",
    "prop": "by",
    "equals": "alice"
   },
   {
    "eid": "Feedback:msg_1",
    "prop": "summary",
    "equals": "Reply msg_1 rated helpful"
   }
  ]
 },
