PACK door_models 1
IMPORT door 1
IMPORT router 1
RESIDENT Settings
-- THE MODELS' ROUTES (a door route family): GET /v1/models (the picker's list), GET and POST /membrane/models (the minds' models), and
-- GET and POST /membrane/options (the seat-wide options, options.py: the gear window, and the page's boot read that asks "Which model?" when none is picked).
-- A route that needs the backend's live list asks for it once (`models_asked`); the reply waits for `models_ready` (the fetch landed
-- and the tag rows are Model entities, packs/router.c1f).

Request.o_models getter: this.route in ['/v1/models', '/v1/models/', '/membrane/models', '/membrane/options']
Request.m_list getter: this.route in ['/v1/models', '/v1/models/']
Request.m_post getter: this.method == 'POST'
-- the allowed methods (the door answers 405 + allow): the list is read-only, the minds' route reads and posts; a minds route with no
-- Minds seat answers 503 whatever the method (None: the family answers itself)
Request.m_models getter: None if (this.m_minds and this.mind_seat == None) else (['GET', 'POST'] if (this.m_minds or this.m_opts) else ['GET'])
Request.m_need getter: this.m_list or this.m_post or this.m_opts
Request.m_ask getter: {'id': this.eid} if (this.o_models == True and this.m_need and this.models_asked != True) else None
Request.m_ask on-setter models-ask:
  WHEN this.m_ask != None:
    this.models_asked = True
    ('Router:seat').refresh = this.m_ask

-- ---- GET /v1/models: the screened tags, the sentinel lane, the autoselect lanes (only with a router), the cloud rungs
Request.m_router getter: ([b.router_on for b in instances('Boot')] or [False])[0] == True
Request.m_tags getter: [m for m in instances('Model') if m.listed == True and m.rung != True and m.chat_ok == True]
-- a claude-agent rung is the model this seat RUNS (the chat's turn is the claude CLI): listed with or without a router (the router's other rungs are the router's)
Request.m_rungs getter: [m for m in instances('Model') if m.rung == True and m.listed == True and (this.m_router or m.backend == 'claude-agent')]
Request.m_lanes getter: ['autoselect', 'autoselect-local'] if this.m_router else []
Request.d_tags getter: FOR m IN this.m_tags: {'id': m.name, 'object': 'model', 'owned_by': 'membrane->ollama'}
Request.d_lanes getter: FOR l IN this.m_lanes: {'id': l, 'object': 'model', 'owned_by': 'membrane-router'}
Request.d_rungs getter: FOR m IN this.m_rungs: {'id': m.name, 'object': 'model', 'owned_by': m.owner}
Request.m_data getter: concat(concat(concat(this.d_tags, [{'id': '@explore', 'object': 'model', 'owned_by': 'membrane->ollama'}]), this.d_lanes), this.d_rungs)
Request.list_reply getter:
  WHEN this.models_ready != True: None
  ELSE: {'status': 200, 'body': {'object': 'list', 'data': this.m_data}}

-- ---- /membrane/models: the minds' models (loops, cortex, workers), their credentials and the think dial
Request.mind getter: [x for x in instances('Minds')]
Request.mind_seat getter: this.mind[0] if len(this.mind) > 0 else None
Request.mind_read getter: this.mind_seat.read if this.mind_seat != None else {}
Request.pickable getter: concat([m.name for m in this.m_tags], [m.name for m in instances('Model') if m.rung == True and m.backend == 'claude-agent' and m.listed == True])
-- every field of the body, with its value, its python-style repr (for the messages) and whether it is a model name
-- (a string of 1..120 characters from letters, digits and _.:/@~+-)
Request.k_list getter: ['loops_auth', 'cortex_auth', 'workers_auth', 'loops', 'cortex', 'workers', 'think']
Request.v_list getter: [prop(this.jbody, k) for k in this.k_list]
Request.s_list getter: [str(v) for v in this.v_list]
Request.str_list getter: [this.s_list[i] == this.v_list[i] for i in [0, 1, 2, 3, 4, 5, 6]]
Request.r_list getter: [("'" + this.s_list[i] + "'") if this.str_list[i] else this.s_list[i] for i in [0, 1, 2, 3, 4, 5, 6]]
-- a model name is letters, digits and _.:/@~+- (1..120): `plain` keeps letters, digits and _#./:- and turns the rest to spaces
Request.n_list getter: [replace(replace(replace(this.s_list[i], '@', 'x'), '~', 'x'), '+', 'x') for i in [0, 1, 2, 3, 4, 5, 6]]
Request.bad_list getter: [plain(this.n_list[i]) != lower(this.n_list[i]) or '#' in this.n_list[i] or ' ' in this.n_list[i] for i in [0, 1, 2, 3, 4, 5, 6]]
Request.ok_list getter: [this.str_list[i] and len(this.s_list[i]) >= 1 and len(this.s_list[i]) <= 120 and not this.bad_list[i] for i in [0, 1, 2, 3, 4, 5, 6]]
Request.skip_list getter: [this.v_list[i] == None or (this.k_list[i] == 'workers' and this.v_list[i] == '') for i in [0, 1, 2, 3, 4, 5, 6]]
Request.e_auth getter: [(this.k_list[i] + ': one of chat|api-key|login, not: ' + this.r_list[i]) if (this.v_list[i] != None and not (this.v_list[i] in ['chat', 'api-key', 'login'])) else None for i in [0, 1, 2]]
Request.unseen getter: len(this.pickable) > 0
Request.e_name getter: [(this.k_list[i] + ': not a model name: ' + this.r_list[i]) if not this.ok_list[i] else None for i in [3, 4, 5]]
Request.e_known getter: [(this.k_list[i] + ": membrane doesn't see " + this.r_list[i] + ' on its backends') if (this.unseen and not (this.v_list[i] in this.pickable)) else None for i in [3, 4, 5]]
Request.e_mind getter: [None if this.skip_list[i + 3] else (this.e_name[i] or this.e_known[i]) for i in [0, 1, 2]]
Request.e_think getter: [('think: one of on|off|auto, not: ' + this.r_list[6]) if (this.v_list[6] != None and not (this.v_list[6] in ['on', 'off', 'auto'])) else None]
Request.errs getter: [e for e in concat(concat(this.e_auth, this.e_mind), this.e_think) if e != None]
Request.err getter: this.errs[0] if len(this.errs) > 0 else None
Request.post_go getter: True if (this.o_models == True and this.m_minds and this.m_post and this.models_ready == True and this.mind_seat != None and this.err == None) else None
Request.m_minds getter: this.route == '/membrane/models'
Request.m_opts getter: this.route == '/membrane/options'
-- the options post: the same mind keys and checks as the models route (`errs`), the options' own checks first (op_err), and no Minds seat needed unless a mind key is sent
Request.op_go getter: True if (this.o_models == True and this.m_opts and this.m_post and this.models_ready == True and this.op_err == None and this.err == None) else None

Request.post_go on-setter minds-loops:
  WHEN this.post_go == True and prop(this.jbody, 'loops') != None:
    ('Minds:seat').loops = prop(this.jbody, 'loops')
Request.post_go on-setter minds-cortex:
  WHEN this.post_go == True and prop(this.jbody, 'cortex') != None:
    ('Minds:seat').cortex = prop(this.jbody, 'cortex')
Request.post_go on-setter minds-workers:
  WHEN this.post_go == True and prop(this.jbody, 'workers') != None:
    ('Minds:seat').workers = prop(this.jbody, 'workers')
Request.post_go on-setter minds-loops-auth:
  WHEN this.post_go == True and prop(this.jbody, 'loops_auth') != None:
    ('Minds:seat').loops_auth = prop(this.jbody, 'loops_auth')
Request.post_go on-setter minds-cortex-auth:
  WHEN this.post_go == True and prop(this.jbody, 'cortex_auth') != None:
    ('Minds:seat').cortex_auth = prop(this.jbody, 'cortex_auth')
Request.post_go on-setter minds-workers-auth:
  WHEN this.post_go == True and prop(this.jbody, 'workers_auth') != None:
    ('Minds:seat').workers_auth = prop(this.jbody, 'workers_auth')
Request.post_go on-setter minds-think:
  WHEN this.post_go == True and prop(this.jbody, 'think') != None:
    ('Minds:seat').think = prop(this.jbody, 'think')
Request.post_go on-setter minds-applied:
  WHEN this.post_go == True:
    this.minds_applied = True

Request.minds_reply getter:
  WHEN this.mind_seat == None: {'status': 503, 'body': ''}
  ELSE WHEN not this.m_post: {'status': 200, 'body': this.mind_read}
  ELSE WHEN this.models_ready != True: None
  ELSE WHEN this.err != None: {'status': 400, 'body': {'error': this.err}}
  ELSE WHEN this.minds_applied != True: None
  ELSE: {'status': 200, 'body': this.mind_read}




-- ---- /membrane/options: the seat-wide options (options.py) --------------------------------------------------------------------------------------
-- WRITABLE: self_cpu_share (0 < x <= 1, default 0.5) and code_runs_keep (a whole number >= 1, default 30), kept on the entity `Settings:seat`; READ-ONLY:
-- current_tau_s (180.0, the field current's fade: a threshold, changing it needs the operator's approval) and energy (Blurp's, None: no self here). NOTHING in
-- this seat reads the two writable values yet (Blurp's loop and the code tree's collector are Python): the gear window shows and keeps them, and they are
-- ready for the day those are c1f. The minds' keys (loops, cortex, workers, <mind>_auth, think) are the models route's, written to `Minds:seat` by the same
-- setters; `background` is the minds with the models they may take: the pickable ones, the claude rungs among them, the chat's credentials (the claude
-- CLI's own login) and `picked` (a model is set: the page asks "Which model?" at boot only when it is not). NOT KEPT: an unknown key is refused without its
-- name (the message says what is writable): c1f cannot list a dict's keys (`keys(d)` is a proposed builtin, docs/c1f-stdlib.md).
Settings.kind getter: 'settings'

Request.op_set getter: ([s for s in instances('Settings') if s.eid == 'Settings:seat'] or [None])[0]
-- LAUNCH SETTINGS (`--fact name=value`, scripts/seat-full passes them on): the constants carried over from the release, each with the released value as its default (docs/release-parity.md, 'Settings').
Request.op_share_def getter: ([b.self_cpu_share_default for b in this.boots] or [None])[0] or 0.5
Request.op_keep_def getter: ([b.code_runs_keep_default for b in this.boots] or [None])[0] or 30
Request.op_tau getter: ([b.field_tau_s for b in this.boots] or [None])[0] or 180.0
Request.op_chat_auth getter: ([b.chat_auth for b in this.boots] or [None])[0] or 'login'
Request.op_share getter: prop(this.jbody, 'self_cpu_share') if (this.op_go == True and prop(this.jbody, 'self_cpu_share') != None) else (prop(this.op_set, 'self_cpu_share') or this.op_share_def)
Request.op_keep getter: prop(this.jbody, 'code_runs_keep') if (this.op_go == True and prop(this.jbody, 'code_runs_keep') != None) else (prop(this.op_set, 'code_runs_keep') or this.op_keep_def)
Request.op_keys getter: ['self_cpu_share', 'code_runs_keep', 'current_tau_s', 'energy', 'loops', 'cortex', 'workers', 'loops_auth', 'cortex_auth', 'workers_auth', 'think']
Request.op_seen getter: [k for k in this.op_keys if prop(this.jbody, k) != None]
Request.op_mind_keys getter: [k for k in ['loops', 'cortex', 'workers', 'loops_auth', 'cortex_auth', 'workers_auth', 'think'] if prop(this.jbody, k) != None]
-- a number that is not a bool, finite, in (0, 1]; a whole number >= 1 (a JSON 1.0 is a float: not whole)
Request.op_share_v getter: prop(this.jbody, 'self_cpu_share')
Request.op_keep_v getter: prop(this.jbody, 'code_runs_keep')
Request.op_share_ok getter: this.op_share_v == None or ((this.op_share_v is Int or this.op_share_v is Float) and this.op_share_v > 0 and this.op_share_v <= 1)
Request.op_keep_ok getter: this.op_keep_v == None or (this.op_keep_v is Int and this.op_keep_v >= 1)
Request.op_nonempty getter: len(this.jbody) > 0
Request.op_err getter:
  WHEN not this.m_opts or not this.m_post: None
  ELSE WHEN not this.op_nonempty: 'expected a JSON object of options, e.g. {"self_cpu_share": 0.5}'
  ELSE WHEN len(this.op_mind_keys) > 0 and this.mind_seat == None: this.op_mind_keys[0] + ': no running seat to set it on'
  ELSE WHEN prop(this.jbody, 'current_tau_s') != None: "current_tau_s is read-only: changing the current's fade needs the operator's approval"
  ELSE WHEN prop(this.jbody, 'energy') != None: "energy is read-only: it is Blurp's to report (#345), not a setting"
  ELSE WHEN len(this.jbody) > len(this.op_seen): 'unknown option (writable: self_cpu_share, code_runs_keep)'
  ELSE WHEN not this.op_share_ok: 'self_cpu_share must be a number in (0, 1], got ' + str(this.op_share_v)
  ELSE WHEN not this.op_keep_ok: 'code_runs_keep must be a whole number >= 1, got ' + str(this.op_keep_v)
  ELSE: None

Request.op_models getter: [m.name for m in instances('Model') if m.rung == True and m.backend == 'claude-agent' and m.listed == True]
-- the models a mind may take: the pickable ones, and the models the minds hold now first when they are not among them
Request.op_cur getter: [x for x in [prop(this.mind_read, 'loops'), prop(this.mind_read, 'cortex'), prop(this.mind_read, 'workers')] if x != None and x != '' and not (x in this.pickable)]
Request.op_all getter: concat(this.op_cur, this.pickable)
Request.op_bg getter: {'loops': prop(this.mind_read, 'loops'), 'cortex': prop(this.mind_read, 'cortex'), 'workers': prop(this.mind_read, 'workers'), 'loops_auth': prop(this.mind_read, 'loops_auth'), 'cortex_auth': prop(this.mind_read, 'cortex_auth'), 'workers_auth': prop(this.mind_read, 'workers_auth'), 'models': this.op_all, 'claude': [m for m in this.op_all if m in this.op_models], 'chat_auth': this.op_chat_auth, 'picked': (prop(this.mind_read, 'loops') or '') != ''}
Request.op_body getter: {'self_cpu_share': this.op_share, 'code_runs_keep': this.op_keep, 'defaults': {'self_cpu_share': this.op_share_def, 'code_runs_keep': this.op_keep_def}, 'writable': concat(['self_cpu_share', 'code_runs_keep'], ['loops', 'cortex', 'workers', 'loops_auth', 'cortex_auth', 'workers_auth', 'think'] if this.mind_seat != None else []), 'current_tau_s': this.op_tau, 'current_tau_note': 'changing it needs the operator\'s approval', 'energy': None, 'background': this.op_bg if this.mind_seat != None else None}

Request.op_post_go getter: True if this.op_go == True else None
Request.op_post_go on-setter opts-share:
  WHEN this.op_post_go == True and prop(this.jbody, 'self_cpu_share') != None:
    ('Settings:seat').self_cpu_share = prop(this.jbody, 'self_cpu_share')
Request.op_post_go on-setter opts-keep:
  WHEN this.op_post_go == True and prop(this.jbody, 'code_runs_keep') != None:
    ('Settings:seat').code_runs_keep = prop(this.jbody, 'code_runs_keep')
Request.op_post_go on-setter opts-minds-loops:
  WHEN this.op_post_go == True and prop(this.jbody, 'loops') != None:
    ('Minds:seat').loops = prop(this.jbody, 'loops')
Request.op_post_go on-setter opts-minds-cortex:
  WHEN this.op_post_go == True and prop(this.jbody, 'cortex') != None:
    ('Minds:seat').cortex = prop(this.jbody, 'cortex')
Request.op_post_go on-setter opts-minds-workers:
  WHEN this.op_post_go == True and prop(this.jbody, 'workers') != None:
    ('Minds:seat').workers = prop(this.jbody, 'workers')
Request.op_post_go on-setter opts-minds-loops-auth:
  WHEN this.op_post_go == True and prop(this.jbody, 'loops_auth') != None:
    ('Minds:seat').loops_auth = prop(this.jbody, 'loops_auth')
Request.op_post_go on-setter opts-minds-cortex-auth:
  WHEN this.op_post_go == True and prop(this.jbody, 'cortex_auth') != None:
    ('Minds:seat').cortex_auth = prop(this.jbody, 'cortex_auth')
Request.op_post_go on-setter opts-minds-workers-auth:
  WHEN this.op_post_go == True and prop(this.jbody, 'workers_auth') != None:
    ('Minds:seat').workers_auth = prop(this.jbody, 'workers_auth')
Request.op_post_go on-setter opts-minds-think:
  WHEN this.op_post_go == True and prop(this.jbody, 'think') != None:
    ('Minds:seat').think = prop(this.jbody, 'think')
Request.op_post_go on-setter opts-applied:
  WHEN this.op_post_go == True:
    this.opts_applied = True

Request.opts_reply getter:
  WHEN this.models_ready != True: None
  ELSE WHEN not this.m_post: {'status': 200, 'body': this.op_body}
  ELSE WHEN this.op_err != None: {'status': 400, 'body': {'error': this.op_err}}
  ELSE WHEN this.err != None: {'status': 400, 'body': {'error': this.err}}
  ELSE WHEN this.opts_applied != True: None
  ELSE: {'status': 200, 'body': this.op_body}

Request.r_models getter: this.list_reply if this.m_list else (this.opts_reply if this.m_opts else this.minds_reply)
