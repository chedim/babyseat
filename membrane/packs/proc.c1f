PACK proc 1
-- THE proc STDLIB PACK (#1044): commands as entities, run by a write. Native, no Python.
--   Command:<name> {cmd: an argument list, or a string run by `sh -c`; cwd; env_from {VAR: ENV_VAR}}
-- Run it with a write; the run never blocks the field, and its receipt lands when it ends:
--   Command.run = {id, args}  -> run_result {id, status, rc, head, stdout, stderr, stdout_bytes, stderr_bytes, started, finished (epoch seconds), ms}, run_rc
--   Command.stop = {id}       -> the running child is killed; stop_result
-- `output` is the whole stdout and `errors` the whole stderr of the last run (the reply of entity_write carries only the first and last 8 KB of each).
-- Secrets are named in env_from (read when the command starts), never stored. No time limit, no output cap.
-- Entity scripts and peers never run an effect.

Command.ok getter: this.run_rc == 0 if this.run_rc != None else None
Command.output getter: prop(this.run_result, 'stdout') if this.run_result else None
Command.errors getter: prop(this.run_result, 'stderr') if this.run_result else None
-- A run in flight is told apart from one never started (#1143): the engine notes `running` = {id, started} (the clock of the write) when it takes a `run` (the
-- slot is consumed at once, so a pack setter cannot read the value); `status` reads `running` until a receipt of that run (finished no earlier than the write)
-- lands, then the receipt's own status (ok or error); none before any run.
Command.status getter:
  WHEN this.running == None: prop(this.run_result, 'status') if this.run_result else None
  ELSE WHEN this.run_result == None or prop(this.run_result, 'finished') < prop(this.running, 'started'): 'running'
  ELSE: prop(this.run_result, 'status')
