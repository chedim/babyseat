PACK store 1
-- THE STORE DRIVER (the operator, 2026-11-10): the seat's SQLite store, read by the engine itself -- no Python in the
-- data path. Built-ins, in any getter or setter of any pack:
--   sql(query, args...)  a read (SELECT / WITH; anything else is refused), arguments bound by `?`, rows as dicts;
--                        as the official drivers: no time limit, no row cap, a lock waited for up to 5 s. Thread-safe and
--                        non-blocking: the engine's own read-only connection (WAL: it never waits for the seat's
--                        writer), run with the GIL released.
--   json(text)           a row's JSON body as a dict; str(x) a value as text.
-- Tables: c_<collection> (k TEXT PRIMARY KEY, body TEXT) with body = {"o": <order>, "d": {...the document...}} --
--   c_events (chat turns, tool results: d.session, d.role, d.stream, d.text, d.seq, d.n, d.ts), c_sentences,
--   c_entities, c_sessions, c_messages, c_entity_states, c_relations, ...  json_extract(body, '$.d.<field>') reads one.
-- Store:field shows what is there.

Store.tables getter: FOR r IN sql("SELECT name FROM sqlite_master WHERE type = 'table' AND substr(name, 1, 2) = 'c_' ORDER BY name"): prop(r, 'name')
Store.events getter: max([prop(r, 'n') for r in sql("SELECT count(*) AS n FROM c_events")]) if this.counted else None
