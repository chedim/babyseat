PACK brain_tools 1
IMPORT chat 1
IMPORT chat_turn 1
-- THE TOOL ROWS OF A RUNNING BRAIN TURN ARE ON THE PAGE AS THEY ARE ISSUED (#1143; docs/graph-link.md, section 19). The brain writes, for each call of a step, the node `<turn>:tool:<call id>` (`name`, `input`, later `result`) and
-- `<message>.tool_ids` = the call ids so far, space separated, in call order. `tool_rows` (packs/chat.c1f) already reads them from `tool_ids`, so `tool_calls` of the page row lists them while the turn runs; what was missing is the
-- `tools` NAMES of the message route, the page row and the event stream, which a rung fills only when its turn finishes (`tools_run`). Each arm below applies ONLY to a turn the brain took (`turn.brain` is set, packs/chat_turn.c1f), running or finished,
-- and is the view's own dict with `tools` = the names of the rows so far; every other message keeps the view as chat.c1f writes it. A finished brain turn keeps the same rows and names. This pack changes no other pack: it can be loaded on a running seat.
ChatMessage.brain_has getter: prop(this.turn_eid, 'brain') != None
ChatMessage.live_tools getter: [t['name'] for t in this.tool_rows] if this.brain_has else None
-- THE LIVE TEXT: the brain publishes `<ns>::Loop:main.live` (the text of its current model round so far, replaced as it grows, cleared when the round ends); the seat reads that cell as a foreign replica and the running brain
-- turn's page row carries it as `live` (the page shows it muted under "Working on it", and drops it when the turn finishes). The RESULT of each tool row is added to the page row only while the turn runs (a result can be megabytes).
ChatMessage.live_raw getter: prop(prop(this.turn_eid, 'brain') + '::Loop:main', 'live') if this.brain_turn else None
ChatMessage.live_text getter: (this.live_raw if this.live_raw is Text else '') if this.brain_turn else None
ChatMessage.page_rows getter: [{'id': t['id'], 'name': t['name'], 'input': t['input'], 'result': t['result']} for t in this.tool_rows] if this.brain_turn else [{'id': t['id'], 'name': t['name'], 'input': t['input']} for t in this.tool_rows]
ChatMessage.view getter:
  WHEN this.brain_has: {'id': this.mid, 'text': this.text, 'state': this.tstate or 'queued', 'response': this.said, 'tools': this.live_tools, 'turn': this.turn_view}
ChatMessage.stream_view getter:
  WHEN this.brain_has: {'id': this.mid, 'text': this.text, 'state': this.tstate or 'queued', 'response': this.said, 'tools': this.live_tools, 'turn': this.turn_view, 'live': this.live_text}
ChatMessage.history_view getter:
  WHEN this.brain_has: {'id': this.mid, 'text': this.text, 'state': this.tstate or 'queued', 'response': this.said, 'tools': this.live_tools, 'turn': this.turn_view, 'tool_calls': this.tool_rows, 'interrupted': this.cut, 'kept': this.kept_words}
ChatMessage.page_view getter:
  WHEN this.brain_has: {'id': this.mid, 'text': this.text, 'state': this.tstate or 'queued', 'response': this.said, 'tools': this.live_tools, 'turn': this.turn_view, 'sent_by': this.sent_by, 'interrupted': this.cut, 'kept': this.kept_words, 'tool_calls': this.page_rows, 'live': this.live_text}
