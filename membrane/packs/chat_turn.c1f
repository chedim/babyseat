PACK chat_turn 1
IMPORT chat 1
IMPORT proc 1
-- THE BARE CHAT'S TURN (#1143, operator 2026-11-12): a message is answered by ONE run of the model's CLI, in the mode the Python rung
-- used (membrane/claude_agent.py): Claude's built-in tools OFF, no user MCP config, no settings files, the allowed tools exactly the
-- membrane MCP set (the door's `POST /mcp`, packs/door_tools.c1f), one continuous run per answer with a ceiling, the system prompt is the
-- barest doctrine (docs/doctrine-barest-draft.md) plus the chat's banner, the prompt is the message ALONE: no chat history reaches the model (map mode). What must outlive
-- the turn goes into the field; the banner shows it.
-- THE RUN is a Command entity (`membrane::Command:chat:<id>`) the turn writes; the stream-json lines of its stdout are read here by
-- `json()` (the receipt lands when the process ends: the answer is not streamed, see docs/cliffvm.md); the result line is the answer,
-- else the assistant's text in order. The run is the message's TURN entity (`...:turn`, packs/chat.c1f: state, started, ended); each tool the model ran and the answer are entities under the turn (ChatTool: name, input, result).
-- Boot facts (cliffvm run ... --fact name=value):
--   chat_claude_bin   the CLI's path. NO DEFAULT: without it a message is answered with an error that says so, and nothing is run.
--   chat_max_turns    the ceiling (the CLI's --max-turns); default 2048 here (a threshold: flagged for the operator).
-- `env CLAUDE_CODE_DISABLE_AUTO_MEMORY=1` is the CLI's own switch the Python rung set (no auto-memory keyed to the folder).
-- (the two setters are on the class Chat, not on the kind ChatMessage: a setter reaches a kind only through an ISA parent ENTITY, `cls:chatmessage`,
-- and a getter only needs the `parents` stamp; only a message has `plan` and `answer`.)
-- `--` ends the options (the CLI's --allowedTools and --mcp-config take lists: without it they would swallow the prompt).
-- The login is the CLI's own; --bare is NOT used: it never reads the login (OAuth/keychain), only an API key.

ChatMessage.bin getter: ([b.chat_claude_bin for b in instances('Boot') if b.chat_claude_bin != None] or [''])[0]
ChatMessage.max_turns getter: ([b.chat_max_turns for b in instances('Boot') if b.chat_max_turns != None] or [2048])[0]
ChatMessage.port getter: ([prop(h.listen_result, 'port') for h in instances('Http') if prop(h.listen_result, 'port') != None] or [None])[0]
ChatMessage.mcp_json getter: str({'mcpServers': {'membrane': {'type': 'http', 'url': 'http://127.0.0.1:' + str(this.port) + '/mcp'}}}) if this.port != None else None
ChatMessage.banner_text getter: prop('membrane::Banner:owner:main', 'text')
ChatMessage.note getter: 'Modify your banner to help you maintain continuity. Use help tool for help. Program the graph as your memory. Process updates on the graph and react to them.'
-- A banner with no `text` (the model's pack left it null) is SHOWN, not skipped: the turn runs with the banner error in the banner's slot, so the model can repair it (Help:banner).
ChatMessage.banner_slot getter: this.banner_text if this.banner_text != None else 'BANNER ERROR: your banner `Banner:owner:main` has no `text` (the reason: ' + (why(this.banner_text) or 'it has no text property') + '). Give `Banner.text` a value again, in a pack that defines it; Help:banner shows how.'
ChatMessage.sys getter: join([this.note, this.banner_slot], '\n\n')
ChatMessage.argv getter:
  WHEN this.bin == '' or this.mcp_json == None or this.sys == None or this.text == None: None
  ELSE: ['env', 'CLAUDE_CODE_DISABLE_AUTO_MEMORY=1', this.bin, '-p', '--output-format', 'stream-json', '--verbose', '--include-partial-messages', '--tools', '', '--strict-mcp-config', '--mcp-config', this.mcp_json, '--allowedTools', 'mcp__membrane__*', '--setting-sources', '', '--no-session-persistence', '--max-turns', str(this.max_turns), '--system-prompt', this.sys, '--', this.text]

-- ---- start: the run is one write ----------------------------------------------------------------------------------------------------------
ChatMessage.plan getter:
  WHEN this.queued != True or this.tstate != 'queued' or this.text == None: None
  ELSE WHEN this.bin == '': {'refuse': 'The chat answers through the claude CLI, and its path is not named yet (chat_claude_bin). Name it with CLAUDE_BIN=<path to claude> when you start scripts/seat, or start cliffvm with --fact chat_claude_bin=<path>, then send the message again.'}
  ELSE WHEN this.argv != None: {'argv': this.argv}
  ELSE: None
Chat.plan on-setter turn-start:
  WHEN prop(this.plan, 'refuse') != None:
    membrane::Chat:message[this.mid]:turn.state = 'error'
    membrane::Chat:message[this.mid]:turn.ended = clock
    membrane::Chat:message[this.mid]:turn:response = ChatResponse(text: prop(this.plan, 'refuse'), error: True)
  ELSE WHEN prop(this.plan, 'argv') != None:
    membrane::Chat:message[this.mid]:turn.state = 'running'
    membrane::Chat:message[this.mid]:turn.started = clock
    membrane::Command:chat[this.mid] = Command(cmd: prop(this.plan, 'argv'))
    membrane::Command:chat[this.mid].run = {'id': this.mid, 'args': [], 'partial': True}

-- ---- while it runs: the lines as they arrive ----------------------------------------------------------------------------------------------
-- `partial: True` makes the Command driver push what each read of stdout brings (whole lines) as an entity `Chunk:<command>:<n>` ({cmd, id, n, data});
-- they are outside births, journalled. The partial answer is the text deltas of the `stream_event` lines, the partial tools the tool_use blocks
-- they start. The finished turn replaces them (the receipt below is the answer) and retires the chunks.
ChatMessage.cmd_eid getter: 'membrane::Command:chat:' + this.mid
ChatMessage.chunks getter: sort_by([{'n': c.n, 'd': c.data} for c in instances('Chunk') if c.cmd == this.cmd_eid], 'n')
ChatMessage.sevs getter: [prop(e, 'event') for e in [json(l) for l in lines(join([prop(c, 'd') for c in this.chunks], ''))] if prop(e, 'type') == 'stream_event']
ChatMessage.partial_text getter: join([prop(prop(v, 'delta'), 'text') for v in this.sevs if prop(v, 'type') == 'content_block_delta' and prop(prop(v, 'delta'), 'type') == 'text_delta'], '')
ChatMessage.partial_tools getter: [replace(str(prop(prop(v, 'content_block'), 'name')), 'mcp__membrane__', '') for v in this.sevs if prop(v, 'type') == 'content_block_start' and prop(prop(v, 'content_block'), 'type') == 'tool_use']

-- once the run has its answer the chunks are retired. A getter + setter, not a line in `turn-finish`: the receipt can be heard BEFORE the last
-- chunk is born (the two come from different threads), and a late chunk marks the class's readers, so this fires again for it.
ChatMessage.stale_chunks getter: [c.eid for c in instances('Chunk') if c.cmd == this.cmd_eid] if this.over else []
ChatMessage.stale_chunks on-setter retire-chunks:
  WHEN len(this.stale_chunks) > 0:
    FOR k IN this.stale_chunks:
      (k).retire = True

-- ---- finish: the receipt is read as stream-json lines ------------------------------------------------------------------------------------
ChatMessage.rr getter: prop('membrane::Command:chat:' + this.mid, 'run_result')
ChatMessage.rc getter: prop(this.rr, 'rc')
ChatMessage.evs getter: [e for e in [json(l) for l in lines(str(prop(this.rr, 'stdout') or ''))] if prop(e, 'type') != None]
ChatMessage.finals getter: [e for e in this.evs if prop(e, 'type') == 'result']
ChatMessage.final getter: this.finals[-1]
ChatMessage.texts getter: [join([prop(b, 'text') for b in (prop(prop(e, 'message'), 'content') or []) if prop(b, 'type') == 'text'], '') for e in this.evs if prop(e, 'type') == 'assistant']
ChatMessage.spoken getter: strip(join([t for t in this.texts if t != ''], '\n\n'))
ChatMessage.capped getter: str(prop(this.final, 'subtype') or '') == 'error_max_turns'
ChatMessage.failed getter:
  WHEN this.rr == None: None
  ELSE WHEN this.final == None and this.rc != 0: 'claude failed (rc ' + str(this.rc) + '): ' + strip(str(prop(this.rr, 'stderr') or prop(this.rr, 'head') or ''))
  ELSE WHEN prop(this.final, 'is_error') == True: 'claude reported an error: ' + str(prop(this.final, 'result'))
  ELSE: None
ChatMessage.answer getter:
  WHEN this.rr == None: None
  ELSE WHEN this.failed != None: this.failed
  ELSE WHEN this.capped: this.spoken + '\n\n(stopped at the ceiling of ' + str(this.max_turns) + ' turns)'
  ELSE WHEN strip(str(prop(this.final, 'result') or '')) != '': str(prop(this.final, 'result'))
  ELSE: this.spoken
ChatMessage.tools_names getter: words(join([join([replace(str(prop(b, 'name')), 'mcp__membrane__', '') for b in (prop(prop(e, 'message'), 'content') or []) if prop(b, 'type') == 'tool_use'], ' ') for e in this.evs if prop(e, 'type') == 'assistant'], ' '))
-- the turn is over once its state is done or error. The finish below runs only while it is not: the answer is derived from the receipt, and the slimming
-- below changes the receipt, so a finished turn keeps the response it wrote.
ChatMessage.over getter: this.tstate == 'done' or this.tstate == 'error'
Chat.answer on-setter turn-finish:
  WHEN this.answer != None and not this.over:
    membrane::Chat:message[this.mid]:turn.state = 'error' if this.failed != None else 'done'
    membrane::Chat:message[this.mid]:turn.ended = clock
    this.tools_run = this.tools_names
    membrane::Chat:message[this.mid]:turn:response = ChatResponse(text: this.answer, error: this.failed != None, rc: this.rc)
    FOR e IN [x for x in this.evs if prop(x, 'type') == 'assistant']:
      FOR b IN [y for y in (prop(prop(e, 'message'), 'content') or []) if prop(y, 'type') == 'tool_use']:
        membrane::Chat:message[this.mid]:turn:tool[prop(b, 'id')] = ChatTool(name: prop(b, 'name'), input: prop(b, 'input'))
    FOR e IN [x for x in this.evs if prop(x, 'type') == 'user']:
      FOR b IN [y for y in (prop(prop(e, 'message'), 'content') or []) if prop(y, 'type') == 'tool_result']:
        body = prop(b, 'content')
        membrane::Chat:message[this.mid]:turn:tool[prop(b, 'tool_use_id')].result = Text(body) or join([prop(c, 'text') for c in (List(body) or [])], '\n')


-- ---- after the answer: the raw output is dropped ----------------------------------------------------------------------------------------------
-- The receipt holds the CLI's whole stdout (and `head`, its twin), and the getters above cached parses of it on the message: a long turn is
-- hundreds of KB, stored again and again. Once the turn is over and its answer, tools and numbers are entities, the receipt is replaced by what
-- is useful: the id, the status, the rc and the stderr (the same replay-safe derived clearing the request collector does). The journal keeps
-- the partial chunks it was given (docs/cliffvm.md, "Resource hygiene").
ChatMessage.spent getter: this.over and this.rr != None and prop(this.rr, 'stdout') != None and this.said != None
Chat.spent on-setter slim-run:
  WHEN this.spent == True:
    membrane::Command:chat[this.mid].run_result = {'id': prop(this.rr, 'id'), 'status': prop(this.rr, 'status'), 'rc': this.rc, 'stderr': prop(this.rr, 'stderr')}
