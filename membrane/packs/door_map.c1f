PACK door_map 1
IMPORT door 1
-- THE FIELD MAP AS A DOOR ROUTE FAMILY (#1143, swap step 3): the routes the 2D panel (field.js) and the 3D window (field3d.js) call.
--   GET /membrane/map/field        the 2D map: {axes, nodes, edges}                     (the page asks ?m=<nodes>)
--   GET /membrane/map/field3d      the whole field projected into the ball: its meta, its root tile, the current
--   GET /membrane/map/tile         one octree cell of that projection (?pid&l&x&y&z)
--   GET /membrane/map/locate       where an entity sits in it (?pid&eid)
--   GET /membrane/map/search       the whole-catalog search (?q&limit)
--   GET /membrane/map/distance     the entity axis (?eid), GET /membrane/field/entity the entity's card (?eid)
--   GET /membrane/map/blurp        Blurp's overlay on the map
-- DEGRADED ON PURPOSE (the operator, 2026-11-13: the map engine is a read-only Python bridge later, a native recall in a later phase): the engine that
-- computes a map (field3d.py: numpy over every live entity's state, fieldmap.py) is the Python seat's and is not here. Until it is, every route answers what the
-- RELEASED code answers for a field with NO live entity (tests/golden/boot, scripts/golden_boot.py): the 2D map has no node, the 3D projection has none (n_total 0:
-- both views then draw "the field is empty" instead of an error), a search finds nothing, Blurp has fired nothing, and the two reads that need a loaded field
-- (the entity axis and the card) answer the released 503 "the field is not loaded". NOT KEPT of the released handlers: the percent-decoding of the query (a
-- `urldecode` is a proposed builtin, docs/c1f-stdlib.md: only `+` and `%20` are decoded, for the search text and the entity ids), the `m` (node count) and the
-- `axes` are read by no route (an empty field has no axes to choose). The empty projection has ONE pid, `000000000000`; any other pid has "expired" (410), as a
-- released seat answers for a projection it no longer holds.

Request.o_map getter: this.route in ['/membrane/map/field', '/membrane/map/field3d', '/membrane/map/tile', '/membrane/map/locate', '/membrane/map/search', '/membrane/map/distance', '/membrane/field/entity', '/membrane/map/blurp']
Request.m_map getter: ['GET']

-- the query as the page sends it: `+` and `%20` are spaces (the one decoding that is here)
Request.mp_arg getter: [[r[0], replace(replace(r[1], '+', ' '), '%20', ' ')] for r in this.qpairs]
Request.mp_val getter: [concat([r[1] for r in this.mp_arg if r[0] == k], [''])[0] for k in ['pid', 'eid', 'q', 'l', 'x', 'y', 'z']]
Request.mp_pid getter: this.mp_val[0]
Request.mp_eid getter: strip(this.mp_val[1])
Request.mp_q getter: lower(strip(this.mp_val[2]))
-- l, x, y, z: whole numbers, 0 when absent; text that is not one is the released 400
Request.mp_ints getter: [(0 if v == '' else (num(v) if ('.' not in v and str(num(v)) == v) else None)) for v in [this.mp_val[3], this.mp_val[4], this.mp_val[5], this.mp_val[6]]]
Request.mp_ints_ok getter: len([i for i in this.mp_ints if i == None]) == 0

Request.mp_empty_pid getter: '000000000000'
Request.mp_err getter: 'membrane_error'
Request.mp_root getter: {'pid': this.mp_empty_pid, 'l': 0, 'x': 0, 'y': 0, 'z': 0, 'nodes': [], 'edges': [], 'more': False}
-- LAUNCH SETTINGS (`--fact name=value`, scripts/seat-full passes them on): the constants carried over from the release, each with the released value as its default (docs/release-parity.md, 'Settings').
Request.mp_tile_k getter: ([b.map_tile_k for b in this.boots] or [None])[0] or 150
Request.mp_tau getter: ([b.field_tau_s for b in this.boots] or [None])[0] or 180.0
Request.mp_3d getter: {'pid': this.mp_empty_pid, 'axes': [], 'n_total': 0, 'kinds': [], 'kind_counts': {}, 'explained': [], 'max_level': 0, 'per_level': [0], 'tile_k': this.mp_tile_k, 'edges': 0, 'shape': 'sphere', 'built_s': 0.0, 'root': this.mp_root, 'current': {'p': None, 'tau_s': this.mp_tau}}
Request.mp_tile getter: {'pid': this.mp_empty_pid, 'l': this.mp_ints[0], 'x': this.mp_ints[1], 'y': this.mp_ints[2], 'z': this.mp_ints[3], 'nodes': [], 'edges': [], 'more': False}
Request.mp_expired getter: {'status': 410, 'body': {'error': {'message': "projection '" + this.mp_pid + "' expired: re-fetch /membrane/map/field3d", 'type': this.mp_err}}}

Request.r_map getter:
  WHEN this.route == '/membrane/map/field': {'status': 200, 'body': {'axes': [], 'nodes': [], 'edges': []}}
  ELSE WHEN this.route == '/membrane/map/field3d': {'status': 200, 'body': this.mp_3d}
  ELSE WHEN this.route == '/membrane/map/blurp': {'status': 200, 'body': {'firings': [], 'counts': {'shadow': 0, 'proposal': 0, 'suggest': 0}, 'triggers': 0}}
  ELSE WHEN this.route == '/membrane/map/search': {'status': 200, 'body': {'q': this.mp_q, 'hits': []}}
  ELSE WHEN this.route == '/membrane/map/tile' and this.mp_pid != this.mp_empty_pid: this.mp_expired
  ELSE WHEN this.route == '/membrane/map/tile' and not this.mp_ints_ok: {'status': 400, 'body': {'error': {'message': 'l, x, y, z must be integers', 'type': this.mp_err}}}
  ELSE WHEN this.route == '/membrane/map/tile': {'status': 200, 'body': this.mp_tile}
  ELSE WHEN this.route == '/membrane/map/locate' and this.mp_pid != this.mp_empty_pid: this.mp_expired
  ELSE WHEN this.route == '/membrane/map/locate': {'status': 404, 'body': {'error': {'message': "'" + this.mp_eid + "' is not in this projection", 'type': this.mp_err}}}
  ELSE: {'status': 503, 'body': {'error': {'message': 'the field is not loaded', 'type': this.mp_err}}}
