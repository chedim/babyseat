PACK embed 1
IMPORT boot 1
IMPORT fetch 1
IMPORT semtext 1
IMPORT chat 1
RESIDENT Embed
-- SENTENCE VECTORS (#1143, stage 1 of the semantic field, docs/semantic-field.md "Stage 1"): every sentence of a SemText gets an embedding vector, made by the local
-- Ollama through the Fetch driver, stored as the entity `Vector:of:<key>:s:<start>` ({of: the SemText's eid, start: the sentence's start in chars, v: the vector}), in a
-- GENTLE background queue. (The class `Vector` and its property `v` belong to the vector pack; this pack only writes them.)
-- THE ASK: `<semtext>.embed = <any value but null>` (the chat writes it on a message body and on an answer's body, next to `mention`; a tool's result is not asked) makes
-- `Embed:ask:<key>` ({of, state: pending, at}); the ask is retired when the text has all its vectors. `<key>` is the text's eid with `::` written `/` (`SemText.skey`).
-- THE BACKLOG: the bodies of the chat that no ask ever named (the imported history, the messages from before this pack) are found in the store, newest first, 64 texts a page
-- (`EmbedQueue.page`: a `sql`, re-asked as the cursor `after` moves), and queued the same way once the model server answers. A text that has all its vectors is marked `embedded = true`
-- (the page skips it), and the sentences done so far are counted in `emb_n` on the text (a text is embedded from its first sentence on; a restart goes on where it stopped).
-- THE QUEUE is the entity `Embed:queue` (EmbedQueue): `state` (idle | working | paused | stuck), `reason` (why it is stuck, as text), `line` (the sentence the Settings row `import.embeddings` shows:
-- done and total texts), `cur` (the text in work), `inflight` (the request that is out), `cache`, `pass_n`, `hold`. A model reads it like any entity: a stuck queue is visible, never silent.
-- ONE REQUEST AT A TIME, one text per request, at most 64 sentences (a request is `POST <seat_backend>/api/embed {model: <embed_model>, input: [<sentences>]}`, 120 s limit): one request in flight is
-- within the existing worker limit (`effect_workers`: the Fetch effect takes a slot of its own, no second limit is made here). A request is sent only while NO chat turn is running (a `ChatTurn` in
-- state `running`); a request in flight finishes, then the queue waits for the turn to end: it pauses between requests and resumes by itself, because `go` is a getter that reads the turns.
-- A PASS is 256 sentences: the same-pass cache (`cache`, at most 64 [text, vector eid] pairs) lets a sentence said twice make no second request; it is emptied when the pass ends, and the next pass follows at once.
-- WHEN IT FAILS (the model server is not running, the model is not installed, a timeout, a wrong answer): `fail` says why (the reason is in `reason`, `line` and `state`), the pending sentences stay pending, and
-- the queue is held (`hold`) until the next change that is not its own: a chat event (a message, a turn starting or ending) or a new ask. Then, with no turn running, it tries again. No timer, no loop.
-- THE FACTS: `seat_backend` (the model server's address, launcher.c1f) and `embed_model` (the embedding model, launcher.c1f: mxbai-embed-large unless the launch says another).
-- THE RECEIPT of each request is the Fetch driver's receipt: an outside write, journalled, so a replay writes the same vectors without asking the model server. (`Fetch:embed` keeps the last receipt only:
-- its body is the vectors as text, a few hundred KB, replaced by the next request's.)

EmbedQueue.kind getter: 'queue'
EmbedAsk.kind getter: 'ask'

-- ---- the ask ----------------------------------------------------------------------------------------------------------------------------------
SemText.embed on-setter embed-ask:
  WHEN this.embed != None:
    membrane::Embed:ask[this.skey] = EmbedAsk(of: this.eid, state: 'pending', at: clock)

-- ---- what a text still needs: its sentences from the `emb_n`-th on, at most 64 (the batch) ------------------------------------------------------------
SemText.emb_rest getter: tail(this.sentences, max(0, len(this.sentences) - (this.emb_n or 0)))
SemText.vec_todo getter: [{'eid': this.eid, 'skey': this.skey, 'start': s['start'], 'text': s['text'], 'veid': 'Vector:of:' + this.skey + ':s:' + str(s['start']), 'o': len([y for y in head(this.emb_rest, 64) if y['start'] < s['start']])} for s in head(this.emb_rest, 64)]

-- ---- start: the queue is born, a request the last run left out is forgotten (its receipt will never come) ---------------------------------------------------
Boot.started on-setter embed-seed:
  ALWAYS:
    membrane::Embed:queue = EmbedQueue(name: 'sentence vectors')
    membrane::Embed:queue.inflight = None
    membrane::Embed:queue.hold = None
    membrane::Embed:queue.fail = None

-- ---- the facts and the turns -------------------------------------------------------------------------------------------------------------------------
EmbedQueue.backend getter: ([b.seat_backend for b in instances('Boot') if b.seat_backend != None] or [None])[0]
EmbedQueue.model getter: ([b.embed_model for b in instances('Boot') if b.embed_model != None] or [None])[0]
-- a chat turn is running while a turn entity says so (the turns of the barest chat are `Chat:...:turn`, kind turn)
EmbedQueue.busy getter: len([c for c in instances('Chat') if c.kind == 'turn' and c.state == 'running']) > 0
-- what a held queue waits to see change: the last chat event, and how many asks are pending
EmbedQueue.sig getter: str(prop('Doorbell:chat', 'at')) + '/' + str(len(this.asks))

-- ---- the work: asks first (newest first), then the backlog page -----------------------------------------------------------------------------------
EmbedQueue.asks getter: [prop(a, 'of') for a in sort_by([{'of': x.of, 'at': 0 - (x.at or 0)} for x in instances('Embed') if x.kind == 'ask' and x.state == 'pending'], 'at')]
EmbedQueue.page_rows getter: sql("SELECT k, sk, row_number() OVER (ORDER BY sk DESC) AS n FROM (SELECT k, substr(k, instr(k, ':message:') + 9) AS sk FROM c_field WHERE cls = 'Chat' AND k LIKE '%:body' AND instr(k, ':message:') > 0 AND json_extract(body, '$.props.text') IS NOT NULL AND json_extract(body, '$.props.embedded') IS NULL) WHERE sk < ?1 ORDER BY sk DESC LIMIT 64", this.after or '~')
EmbedQueue.page getter: this.page_rows if this.page_rows is List else []
EmbedQueue.texts getter: distinct(concat(head(this.asks, 64), [prop(r, 'k') for r in this.page]))
EmbedQueue.cur getter: ([t for t in this.texts if len(prop(t, 'vec_todo')) > 0] or [None])[0]
EmbedQueue.todo getter: prop(this.cur, 'vec_todo') if this.cur != None else []

-- ---- a text with nothing left to embed is settled: marked, its ask retired, the cursor moves past the done front of the page --------------------------------
EmbedQueue.settled getter: [t for t in this.texts if len(prop(t, 'vec_todo')) == 0 and prop(t, 'embedded') != True]
EmbedQueue.first_open getter: min([r['n'] for r in this.page if len(prop(r['k'], 'vec_todo')) > 0] or [len(this.page) + 1])
EmbedQueue.cut getter: ([r['sk'] for r in this.page if r['n'] == this.first_open - 1] or [None])[0]
EmbedQueue.settled on-setter embed-settle:
  WHEN len(this.settled) > 0:
    FOR t IN this.settled:
      (t).embedded = True
      FOR a IN ([1] if prop('membrane::Embed:ask:' + prop(t, 'skey'), 'of') != None else []):
        ('membrane::Embed:ask:' + prop(t, 'skey')).retire = True
    this.made = (this.made or 0) + len(this.settled)
    FOR c IN ([this.cut] if this.cut != None else []):
      this.after = c

-- ---- the numbers: done and total texts (read from the store, asked again as a text is settled) ---------------------------------------------------------
EmbedQueue.counts_rows getter: sql("SELECT coalesce(sum(CASE WHEN json_extract(body, '$.props.embedded') IS NULL THEN 1 ELSE 0 END), 0) AS nleft, coalesce(sum(CASE WHEN json_extract(body, '$.props.embedded') IS NULL THEN 0 ELSE 1 END), 0) AS ndone FROM c_field WHERE cls = 'Chat' AND k LIKE '%:body' AND instr(k, ':message:') > 0 AND json_extract(body, '$.props.text') IS NOT NULL AND ?1 = ?1", this.made or 0)
EmbedQueue.counts getter: this.counts_rows[0] if this.counts_rows is List and len(this.counts_rows) > 0 else {}
EmbedQueue.done_n getter: prop(this.counts, 'ndone') or 0
EmbedQueue.total_n getter: (prop(this.counts, 'ndone') or 0) + (prop(this.counts, 'nleft') or 0)
EmbedQueue.progress getter: str(this.done_n) + ' of ' + str(this.total_n) + ' texts have sentence vectors'

-- ---- the state, as a word and as a sentence --------------------------------------------------------------------------------------------------------
EmbedQueue.reason getter:
  WHEN this.fail != None: this.fail
  ELSE WHEN this.model == None: 'no embedding model is named (the embed_model fact)'
  ELSE WHEN this.backend == None: 'no model server address is known (the seat_backend fact)'
  ELSE: None
EmbedQueue.state getter:
  WHEN this.cur == None and this.inflight == None: 'idle'
  ELSE WHEN this.reason != None: 'stuck'
  ELSE WHEN this.inflight != None: 'working'
  ELSE WHEN this.busy: 'paused'
  ELSE: 'working'
EmbedQueue.line getter:
  WHEN this.state == 'stuck': 'Sentence vectors are waiting: ' + str(this.reason) + ' (' + this.progress + '). The sentences stay pending; the queue tries again at the next quiet moment, when no chat turn is running.'
  ELSE WHEN this.state == 'paused': this.progress + '; paused while a chat turn runs'
  ELSE WHEN this.state == 'working': this.progress + '; the rest are being made in the background'
  ELSE: this.progress

-- ---- send: one request, only while no turn runs, none in flight, and not held ------------------------------------------------------------------------
EmbedQueue.ctexts getter: [c[0] for c in (this.cache or [])]
EmbedQueue.unc getter: [x for x in this.todo if not (x['text'] in this.ctexts)]
EmbedQueue.job getter:
  WHEN len(this.todo) == 0: None
  ELSE: {'id': 'embed:' + str((this.seq or 0) + 1), 'eid': this.cur, 'upto': (prop(this.cur, 'emb_n') or 0) + len(this.todo), 'url': str(this.backend) + '/api/embed', 'model': this.model, 'n': len(this.todo), 'hit': [{'eid': x['eid'], 'start': x['start'], 'veid': x['veid'], 'src': [c[1] for c in this.cache if c[0] == x['text']][0]} for x in this.todo if x['text'] in this.ctexts], 'unc': [{'eid': x['eid'], 'start': x['start'], 'veid': x['veid'], 'text': x['text'], 'r': len([y for y in this.unc if y['o'] < x['o']])} for x in this.unc]}
EmbedQueue.ready getter: this.inflight == None and not this.busy and this.backend != None and this.model != None and this.hold != this.sig
EmbedQueue.go getter: this.job if this.ready and this.job != None else None
-- a pass of 256 sentences ends: the pass count and the cache start again
EmbedQueue.pass_end getter: (this.pass_n or 0) + (this.job['n'] if this.job != None else 0) >= 256
EmbedQueue.go on-setter embed-send:
  WHEN this.go != None:
    FOR h IN this.go['hit']:
      (h['veid']) = Vector(of: h['eid'], start: h['start'], v: prop(h['src'], 'v'))
    FOR c IN ([1] if len(this.go['unc']) == 0 else []):
      (this.go['eid']).emb_n = this.go['upto']
      this.pass_n = 0 if this.pass_end else (this.pass_n or 0) + this.go['n']
      FOR e IN ([1] if this.pass_end else []):
        this.cache = []
    FOR c IN ([1] if len(this.go['unc']) > 0 else []):
      ('Fetch:embed').request = {'id': this.go['id'], 'url': this.go['url'], 'method': 'POST', 'headers': {'Content-Type': 'application/json'}, 'body': {'model': this.go['model'], 'input': [x['text'] for x in this.go['unc']]}, 'timeout_s': 120}
      this.inflight = this.go
      this.seq = (this.seq or 0) + 1

-- ---- the receipt -------------------------------------------------------------------------------------------------------------------------------------
Fetch.em_job getter: prop('membrane::Embed:queue', 'inflight')
Fetch.em_mine getter: startswith(str(prop(this.request_result, 'id') or ''), 'embed:') and prop(this.em_job, 'id') == prop(this.request_result, 'id')
Fetch.em_body getter: json(str(prop(this.request_result, 'body') or '')) if this.em_mine else None
Fetch.em_vecs getter: (None if this.em_body is Error else prop(this.em_body, 'embeddings')) if this.em_mine else None
Fetch.em_why getter:
  WHEN not this.em_mine: None
  ELSE WHEN prop(this.request_result, 'status') != 'ok': 'the model server did not answer at ' + str(prop(this.em_job, 'url')) + ' (' + str(prop(this.request_result, 'head')) + '). Is it running?'
  ELSE WHEN prop(this.request_result, 'http_status') != 200: 'the model server answered ' + str(prop(this.request_result, 'http_status')) + ' for the model ' + str(prop(this.em_job, 'model')) + ': ' + str((None if this.em_body is Error else prop(this.em_body, 'error')) or prop(this.request_result, 'head')) + ' (a model that is not installed is installed with: ollama pull ' + str(prop(this.em_job, 'model')) + ')'
  ELSE WHEN not (this.em_vecs is List) or len(this.em_vecs) != len(prop(this.em_job, 'unc')) or len([v for v in this.em_vecs if not (v is List) or len(v) == 0]) > 0: 'the model server gave a wrong answer: expected ' + str(len(prop(this.em_job, 'unc'))) + ' vectors in embeddings'
  ELSE: None
Fetch.em_ok getter: prop(this.request_result, 'id') if this.em_mine and this.em_why == None else None

Fetch.em_why on-setter embed-failed:
  WHEN this.em_why != None:
    membrane::Embed:queue.fail = this.em_why
    membrane::Embed:queue.hold = prop('membrane::Embed:queue', 'sig')
    membrane::Embed:queue.inflight = None

Fetch.em_ok on-setter embed-landed:
  WHEN this.em_ok != None:
    FOR it IN this.em_job['unc']:
      (it['veid']) = Vector(of: it['eid'], start: it['start'], v: this.em_vecs[it['r']])
    (this.em_job['eid']).emb_n = this.em_job['upto']
    FOR q IN ['membrane::Embed:queue']:
      (q).cache = [] if (prop(q, 'pass_n') or 0) + this.em_job['n'] >= 256 else tail(concat(prop(q, 'cache') or [], [[x['text'], x['veid']] for x in this.em_job['unc']]), 64)
      (q).pass_n = 0 if (prop(q, 'pass_n') or 0) + this.em_job['n'] >= 256 else (prop(q, 'pass_n') or 0) + this.em_job['n']
      (q).inflight = None
      (q).fail = None
