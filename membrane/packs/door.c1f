PACK door 1
IMPORT boot 1
-- THE DOOR'S ROUTES (operator, 2026-11-12: all logic is c1f, the operating system; rust only listens, verifies the token and
-- sends the bytes a pack names). A request is the entity `Request:<n>` (method, path, query, headers, body, authed, sub); the
-- answer is `Request.reply` = {status, headers?, body? | file?}; the setter below writes it to the request's `respond`, which
-- the driver sends. A pack that IMPORTs door 1 can answer first: define `Request.override` (a getter that is None when the
-- request is not its own) and it wins over the shipped routes.

Request.is_read getter: this.method == 'GET' or this.method == 'HEAD'

-- ---- the page and its files ------------------------------------------------------------------------------------------------
-- Boot:seat.ui_dir is the UI's folder (the launcher tells it at boot). The files are /, /index.html, /membrane (the page),
-- /favicon.ico and /ui/www/<file>; a path with '..', a percent, a backslash, a leading '/' or a second /ui/www/ is refused.
Request.ui_root getter: ([b.ui_dir for b in instances('Boot') if b.ui_dir != None] or [''])[0]
Request.rel getter:
  WHEN this.path == '/' or this.path == '/index.html' or this.path == '/membrane': 'index.html'
  ELSE WHEN this.path == '/favicon.ico': 'favicon.svg'
  ELSE WHEN startswith(this.path, '/ui/www/'): replace(this.path, '/ui/www/', '')
  ELSE: None
Request.rel_climb getter: this.rel != None and ('..' in this.rel or '%' in this.rel or '\\' in this.rel or startswith(this.rel, '/') or '/ui/www/' in this.rel)
Request.rel_ok getter: this.rel != None and this.rel != '' and not this.rel_climb and this.ui_root != ''
Request.file getter: (this.ui_root + '/' + this.rel) if this.rel_ok else None
Request.found getter: stat(this.file) if this.file != None else None
Request.parts getter: concat([''], words(replace(this.rel or '', '.', ' ')))
Request.ext getter: this.parts[len(this.parts) - 1]
Request.ctype getter: {'html': 'text/html; charset=utf-8', 'js': 'application/javascript; charset=utf-8', 'mjs': 'application/javascript; charset=utf-8', 'wasm': 'application/wasm', 'gz': 'application/gzip', 'json': 'application/json', 'css': 'text/css; charset=utf-8', 'png': 'image/png', 'svg': 'image/svg+xml', 'ico': 'image/x-icon', 'woff2': 'font/woff2'}[this.ext] or 'application/octet-stream'
-- none until the file's stat has come back (an asynchronous read): the reply waits for it
Request.static getter:
  WHEN this.rel == None: 'no'
  ELSE WHEN not this.rel_ok: 'bad'
  ELSE WHEN this.found == None: None
  ELSE WHEN prop(this.found, 'exists') == True and prop(this.found, 'kind') == 'file': 'file'
  ELSE: 'missing'

Request.static_reply getter:
  WHEN this.static == None: None
  ELSE WHEN this.static == 'file' and not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.static == 'file': {'status': 200, 'headers': {'content-type': this.ctype, 'cache-control': 'no-store, max-age=0'}, 'file': this.file, 'no_body': this.method == 'HEAD'}
  ELSE: {'status': 404, 'body': {'error': 'not found'}}

-- ---- /ui/conf: the page's config -------------------------------------------------------------------------------------------
-- The launcher tells the facts (Boot:seat.seat_name, .seat_named, .seat_aliases, .seat_stt, .seat_voice_out, .seat_language,
-- .seat_blurp, .build_id). WHO comes from the door's verified token (`authed`, `sub`, `claims`). A caller with no token passes as
-- the seat itself when it is bare loopback (this machine, nothing forwarded); a token that is sent and bad is refused like any other.
Request.loop getter: startswith(this.peer or '', '127.0.0.1:') or startswith(this.peer or '', '[::1]:')
Request.fwd getter: prop(this.headers, 'x-forwarded-for') != None or prop(this.headers, 'forwarded') != None
Request.internal getter: this.loop and not this.fwd and this.auth_error == 'no token'
Request.entrant getter: this.authed == True or this.internal
Request.who getter: {'sub': this.sub, 'name': prop(this.claims, 'name') or this.sub} if this.authed == True else None
Request.boots getter: [b for b in instances('Boot')]
Request.c_stt getter: 'server' if startswith(str(([b.seat_stt for b in this.boots] or [''])[0] or ''), 'http') else 'browser'
Request.c_name getter: ([b.seat_name for b in this.boots] or [None])[0]
Request.c_named getter: ([b.seat_named for b in this.boots] or [False])[0] == True
Request.c_aliases getter: ([b.seat_aliases for b in this.boots] or [[]])[0] or []
Request.c_voice getter: ([b.seat_voice_out for b in this.boots] or [False])[0] == True
Request.c_lang getter: ([b.seat_language for b in this.boots] or ['en'])[0] or 'en'
Request.c_blurp getter: ([b.seat_blurp for b in this.boots] or [False])[0] == True
Request.c_build getter: ([b.build_id for b in this.boots] or [None])[0]
Request.conf_body getter: {'serve_ok': True, 'serve_url': 'standalone', 'standalone': True, 'build': this.c_build, 'name': this.c_name, 'named': this.c_named, 'aliases': this.c_aliases, 'stt': this.c_stt, 'voice_out': this.c_voice, 'language': this.c_lang, 'blurp': this.c_blurp, 'auth': 'jwt', 'who': this.who}
Request.conf_reply getter:
  WHEN not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE: {'status': 200, 'body': this.conf_body}

-- ---- /ui/login and /ui/logout: the cookie ------------------------------------------------------------------------------------
-- A person's token (JSON only: a cross-site form cannot post it; the seat's internal token never logs in) becomes this seat's
-- HttpOnly, SameSite=Strict cookie, Secure behind an https proxy. The door checks the token (`Request.verify`, a write whose
-- receipt is data); everything else is decided here.
Request.ct getter: (words(replace(lower(str(prop(this.headers, 'content-type') or '')), ';', ' ')) or [''])[0]
Request.proto getter: (words(replace(lower(str(prop(this.headers, 'x-forwarded-proto') or '')), ',', ' ')) or [''])[0]
Request.fwdh getter: lower(str(prop(this.headers, 'forwarded') or ''))
Request.https getter: this.proto == 'https' or 'proto=https' in this.fwdh or 'proto="https"' in this.fwdh
Request.cookie_name getter: ([prop(h.listen_result, 'cookie') for h in instances('Http') if prop(h.listen_result, 'cookie') != None] or ['membrane_jwt'])[0]
Request.secure getter: '; Secure' if this.https else ''
Request.login_token getter: prop(json(this.body or ''), 'token') if this.method == 'POST' and this.path == '/ui/login' else None
Request.login_shape getter: this.path == '/ui/login' and this.method == 'POST' and this.ct == 'application/json' and len(this.body or '') <= 16384
Request.login_has getter: this.login_token != None and len(str(this.login_token)) > 0
Request.login_ask getter: {'id': 'login', 'token': this.login_token} if this.login_shape and this.login_has else None
Request.login_ask on-setter login-verify:
  WHEN this.login_ask != None:
    this.verify = this.login_ask
Request.login_ok getter: prop(this.verify_result, 'rc') == 0 and prop(prop(this.verify_result, 'claims'), 'sub') != 'seat:internal'
Request.login_age getter: words(replace(str(max(0, prop(prop(this.verify_result, 'claims'), 'exp') - clock)), '.', ' '))[0]
Request.login_cookie getter: this.cookie_name + '=' + str(this.login_token) + '; Path=/; Max-Age=' + this.login_age + '; HttpOnly; SameSite=Strict' + this.secure
Request.login_reply getter:
  WHEN this.method != 'POST': {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.ct != 'application/json': {'status': 415, 'body': {'error': 'send JSON: {"token": "..."}'}}
  ELSE WHEN len(this.body or '') > 16384: {'status': 413, 'body': {'error': 'too large'}}
  ELSE WHEN this.login_ask == None: {'status': 401, 'headers': {'www-authenticate': 'Bearer'}, 'body': {'error': 'missing or invalid token'}}
  ELSE WHEN this.verify_result == None: None
  ELSE WHEN not this.login_ok: {'status': 401, 'headers': {'www-authenticate': 'Bearer'}, 'body': {'error': 'missing or invalid token'}}
  ELSE: {'status': 200, 'headers': {'cache-control': 'no-store', 'set-cookie': this.login_cookie}, 'body': {'ok': True, 'who': {'sub': prop(prop(this.verify_result, 'claims'), 'sub'), 'name': prop(prop(this.verify_result, 'claims'), 'name') or prop(prop(this.verify_result, 'claims'), 'sub')}}}
Request.logout_reply getter:
  WHEN this.method != 'POST': {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE: {'status': 200, 'headers': {'cache-control': 'no-store', 'set-cookie': this.cookie_name + '=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict' + this.secure}, 'body': {'ok': True}}

-- ---- the gate: every route but the public shell needs a token (or a bare loopback caller) --------------------------------------
Request.public getter: this.path in ['/', '/index.html', '/membrane', '/favicon.ico', '/ui/login', '/ui/logout'] or startswith(this.path, '/ui/www/')
Request.gate getter: None if this.public or this.entrant else {'status': 401, 'headers': {'www-authenticate': 'Bearer'}, 'body': {'error': 'invalid token' if this.auth_error != 'no token' else 'missing or invalid token'}}

-- ---- the opencode client's boot probes ----------------------------------------------------------------------------------------------
-- The launcher tells Boot:seat.seat_version, .seat_cwd, .seat_home and .seat_project.
Request.f_version getter: ([b.seat_version for b in this.boots] or [''])[0]
Request.f_cwd getter: ([b.seat_cwd for b in this.boots] or [''])[0]
Request.f_home getter: ([b.seat_home for b in this.boots] or [''])[0]
Request.f_project getter: ([b.seat_project for b in this.boots] or [''])[0]
Request.ms getter: num(words(replace(str(clock * 1000), '.', ' '))[0])
Request.path_body getter: {'home': this.f_home, 'state': this.f_home + '/.local/state/opencode', 'config': this.f_home + '/.config/opencode', 'worktree': this.f_cwd, 'directory': this.f_cwd}
Request.project_body getter: {'id': this.f_project, 'worktree': this.f_cwd, 'vcs': 'git', 'time': {'created': this.ms, 'updated': this.ms}, 'sandboxes': []}
Request.probe getter: this.path in ['/global/health', '/command', '/vcs', '/path', '/project', '/project/current'] or (startswith(this.path, '/project/') and '/directories' in this.path)
Request.probe_reply getter:
  WHEN not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.path == '/global/health': {'status': 200, 'body': {'healthy': True, 'version': this.f_version}}
  ELSE WHEN this.path == '/command': {'status': 200, 'body': []}
  ELSE WHEN this.path == '/vcs': {'status': 200, 'body': {'branch': None, 'default_branch': None}}
  ELSE WHEN this.path == '/path': {'status': 200, 'body': this.path_body}
  ELSE WHEN this.path == '/project' or this.path == '/project/current': {'status': 200, 'body': this.project_body}
  ELSE: {'status': 200, 'body': []}

Request.routed getter: this.conf_reply if this.path == '/ui/conf' else (this.login_reply if this.path == '/ui/login' else (this.logout_reply if this.path == '/ui/logout' else (this.probe_reply if this.probe else this.static_reply)))
Request.shipped getter: this.gate if this.gate != None else this.routed

Request.reply getter: this.override if this.override != None else this.shipped

Request.reply on-setter answer:
  WHEN this.reply != None:
    this.respond = this.reply

-- ---- the boot starts the door ------------------------------------------------------------------------------------------------
-- The launcher tells the seat's facts (Boot:seat.door_port, .door_secret_file, .ui_dir) before it says `started`; with a
-- door_port the boot writes the listen. The verified token's secret is read by the door from that file (never a property).
Http.up getter: this.listen_rc == 0 if this.listen_rc != None else None

Boot.started on-setter door-listen:
  WHEN this.door_port != None:
    ('Http:door').listen = {'id': 'boot', 'port': this.door_port, 'secret_file': this.door_secret_file}
