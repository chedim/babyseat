PACK door 1
IMPORT boot 1
VIRTUAL Request
VIRTUAL Http
-- THE DOOR'S ROUTES (operator, 2026-11-12: all logic is c1f, the operating system; rust only listens, verifies the token and
-- sends the bytes a pack names). A request is the entity `Request:<n>` (method, path, query, headers, body, authed, sub); the
-- answer is `Request.reply` = {status, headers?, body? | file?}; the setter below writes it to the request's `respond`, which
-- the driver sends. A pack that IMPORTs door 1 can answer first: define `Request.override` (a getter that is None when the
-- request is not its own) and it wins over the shipped routes.

Request.is_read getter: this.method == 'GET' or this.method == 'HEAD'

-- ---- the page and its files ------------------------------------------------------------------------------------------------
-- THE FILES OF AN APP are data at their path (docs/c1f-layers.md): Boot:seat.app_dirs is the apps' folders, the UPPER layer first, and an
-- app's files are under its `ui/`; Boot:seat.ui_dir (--ui-dir) is the lowest layer. The first folder that holds the file wins, so an
-- upper layer's file shadows the lower one's. The files are /, /index.html, /membrane (the page),
-- /favicon.ico and /ui/www/<file>; a path with '..', a percent, a backslash, a leading '/' or a second /ui/www/ is refused.
Request.ui_root getter: ([b.ui_dir for b in instances('Boot') if b.ui_dir != None] or [''])[0]
Request.app_dirs getter: ([b.app_dirs for b in instances('Boot') if b.app_dirs != None] or [[]])[0]
Request.ui_roots getter: concat([d + '/ui' for d in this.app_dirs], [this.ui_root] if this.ui_root != '' else [])
Request.rel getter:
  WHEN this.route == '/' or this.route == '/index.html' or this.route == '/membrane': 'index.html'
  ELSE WHEN this.route == '/favicon.ico': 'favicon.svg'
  ELSE WHEN startswith(this.route, '/ui/www/'): replace(this.route, '/ui/www/', '')
  ELSE: None
Request.rel_climb getter: this.rel != None and ('..' in this.rel or '%' in this.rel or '\\' in this.rel or startswith(this.rel, '/') or '/ui/www/' in this.rel)
Request.rel_ok getter: this.rel != None and this.rel != '' and not this.rel_climb and len(this.ui_roots) > 0
Request.layer_files getter: [r + '/' + this.rel for r in this.ui_roots] if this.rel_ok else []
-- THE SEARCH, one file at a time (a getter asks the fs driver for one answer at a time): `skip` counts the layers found without the file, the
-- candidate is the next layer's path, and a miss writes `skip` one further until the file is found or the layers run out.
Request.cand getter: this.layer_files[(this.skip or 0)] if (this.skip or 0) < len(this.layer_files) else None
Request.found getter: stat(this.cand) if this.cand != None else None
Request.found on-setter next-layer:
  WHEN this.found != None and not (prop(this.found, 'exists') == True and prop(this.found, 'kind') == 'file') and (this.skip or 0) + 1 < len(this.layer_files):
    this.skip = (this.skip or 0) + 1
Request.hit getter: prop(this.found, 'exists') == True and prop(this.found, 'kind') == 'file'
Request.last getter: (this.skip or 0) + 1 >= len(this.layer_files)
Request.file getter: this.cand if this.hit == True else None
Request.parts getter: concat([''], words(replace(this.rel or '', '.', ' ')))
Request.ext getter: this.parts[len(this.parts) - 1]
Request.ctype getter: {'html': 'text/html; charset=utf-8', 'js': 'application/javascript; charset=utf-8', 'mjs': 'application/javascript; charset=utf-8', 'wasm': 'application/wasm', 'gz': 'application/gzip', 'json': 'application/json', 'css': 'text/css; charset=utf-8', 'png': 'image/png', 'svg': 'image/svg+xml', 'ico': 'image/x-icon', 'woff2': 'font/woff2'}[this.ext] or 'application/octet-stream'
-- (`page_hold` and `page_cookie` are door_auth.c1f's: the page fetched from this machine is given its owner cookie; none = no cookie)
-- none until the file's stat has come back (an asynchronous read): the reply waits for it
Request.static getter:
  WHEN this.rel == None: 'no'
  ELSE WHEN not this.rel_ok: 'bad'
  ELSE WHEN this.found == None: None
  ELSE WHEN this.hit: 'file'
  ELSE WHEN this.last: 'missing'
  ELSE: None

Request.static_reply getter:
  WHEN this.static == None: None
  ELSE WHEN this.static == 'file' and not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.static == 'file' and this.page_hold == True: None
  ELSE WHEN this.static == 'file' and this.page_cookie != None: {'status': 200, 'headers': {'content-type': this.ctype, 'cache-control': 'no-store, max-age=0', 'set-cookie': this.page_cookie}, 'file': this.file, 'no_body': this.method == 'HEAD'}
  ELSE WHEN this.static == 'file': {'status': 200, 'headers': {'content-type': this.ctype, 'cache-control': 'no-store, max-age=0'}, 'file': this.file, 'no_body': this.method == 'HEAD'}
  ELSE: {'status': 404, 'body': {'error': 'not found'}}

-- ---- /ui/conf: the page's config -------------------------------------------------------------------------------------------
-- The launcher tells the facts (Boot:seat.seat_name, .seat_named, .seat_aliases, .seat_stt, .seat_voice_out, .seat_language,
-- .seat_blurp, .build_id). WHO comes from the door's verified token (`authed`, `sub`, `claims`). A localhost peer is NOT the owner (operator, #842):
-- once the door has a secret, a request with no token, from loopback or anywhere, is refused; the owner's token is the file the seat writes at boot
-- (docs/auth.md). A token that is sent and bad is refused the same way. A door with no secret at all (the barest seat) is open by decision.
Request.loop getter: startswith(this.peer or '', '127.0.0.1:') or startswith(this.peer or '', '[::1]:')
Request.fwd getter: prop(this.headers, 'x-forwarded-for') != None or prop(this.headers, 'forwarded') != None
Request.entrant getter: this.authed == True
Request.who getter: {'sub': this.sub, 'name': prop(this.claims, 'name') or this.sub} if this.authed == True else None
Request.boots getter: [b for b in instances('Boot')]
Request.c_stt getter: 'server' if startswith(str(([b.seat_stt for b in this.boots] or [''])[0] or ''), 'http') else 'browser'
Request.c_name getter: ([b.seat_name for b in this.boots] or [None])[0]
Request.c_named getter: ([b.seat_named for b in this.boots] or [False])[0] == True
Request.c_aliases getter: ([b.seat_aliases for b in this.boots] or [[]])[0] or []
Request.c_voice getter: ([b.seat_voice_out for b in this.boots] or [False])[0] == True
Request.c_lang getter: ([b.seat_language for b in this.boots] or ['en'])[0] or 'en'
Request.c_blurp getter: ([b.seat_blurp for b in this.boots] or [False])[0] == True
Request.c_build getter: ([b.build_id for b in this.boots] or [None])[0]
Request.conf_body getter: {'serve_ok': True, 'serve_url': 'standalone', 'standalone': True, 'build': this.c_build, 'name': this.c_name, 'named': this.c_named, 'aliases': this.c_aliases, 'stt': this.c_stt, 'voice_out': this.c_voice, 'language': this.c_lang, 'blurp': this.c_blurp, 'auth': 'jwt', 'who': this.who}
Request.conf_reply getter:
  WHEN not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE: {'status': 200, 'body': this.conf_body}

-- ---- /ui/login and /ui/logout: the cookie ------------------------------------------------------------------------------------
-- A person's token (JSON only: a cross-site form cannot post it; the seat's internal token never logs in) becomes this seat's
-- HttpOnly, SameSite=Strict cookie, Secure behind an https proxy. The door checks the token (`Request.verify`, a write whose
-- receipt is data); everything else is decided here.
Request.ct getter: (words(replace(lower(str(prop(this.headers, 'content-type') or '')), ';', ' ')) or [''])[0]
Request.proto getter: (words(replace(lower(str(prop(this.headers, 'x-forwarded-proto') or '')), ',', ' ')) or [''])[0]
Request.fwdh getter: lower(str(prop(this.headers, 'forwarded') or ''))
Request.https getter: this.proto == 'https' or 'proto=https' in this.fwdh or 'proto="https"' in this.fwdh
Request.cookie_name getter: ([prop(h.listen_result, 'cookie') for h in instances('Http') if prop(h.listen_result, 'cookie') != None] or ['membrane_jwt'])[0]
Request.secure getter: '; Secure' if this.https else ''
Request.login_token getter: prop(json(this.body or ''), 'token') if this.method == 'POST' and this.route == '/ui/login' else None
Request.login_shape getter: this.route == '/ui/login' and this.method == 'POST' and this.ct == 'application/json' and len(this.body or '') <= 16384
Request.login_has getter: this.login_token != None and len(str(this.login_token)) > 0
Request.login_ask getter: {'id': 'login', 'token': this.login_token} if this.login_shape and this.login_has else None
Request.login_ask on-setter login-verify:
  WHEN this.login_ask != None:
    this.verify = this.login_ask
Request.login_ok getter: prop(this.verify_result, 'rc') == 0 and prop(prop(this.verify_result, 'claims'), 'sub') != 'seat:internal'
Request.login_age getter: words(replace(str(max(0, prop(prop(this.verify_result, 'claims'), 'exp') - clock)), '.', ' '))[0] if this.verify_result != None else None
Request.login_cookie getter: None if this.login_age == None else this.cookie_name + '=' + str(this.login_token) + '; Path=/; Max-Age=' + this.login_age + '; HttpOnly; SameSite=Strict' + this.secure
Request.login_reply getter:
  WHEN this.method != 'POST': {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.ct != 'application/json': {'status': 415, 'body': {'error': 'send JSON: {"token": "..."}'}}
  ELSE WHEN len(this.body or '') > 16384: {'status': 413, 'body': {'error': 'too large'}}
  ELSE WHEN this.login_ask == None: this.unauthorized
  ELSE WHEN this.verify_result == None: None
  ELSE WHEN not this.login_ok: this.unauthorized
  ELSE: {'status': 200, 'headers': {'cache-control': 'no-store', 'set-cookie': this.login_cookie}, 'body': {'ok': True, 'who': {'sub': prop(prop(this.verify_result, 'claims'), 'sub'), 'name': prop(prop(this.verify_result, 'claims'), 'name') or prop(prop(this.verify_result, 'claims'), 'sub')}}}
Request.logout_reply getter:
  WHEN this.method != 'POST': {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE: {'status': 200, 'headers': {'cache-control': 'no-store', 'set-cookie': this.cookie_name + '=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict' + this.secure}, 'body': {'ok': True}}

-- THE 401, in the RELEASED shape (jwtauth.py `send_unauthorized`, the shape the TUI, Home Assistant and curl scripts read): one message for a
-- missing and a refused token alike (a refusal never says which), under `error.message`, and `WWW-Authenticate: Bearer realm="membrane"`.
Request.unauthorized getter: {'status': 401, 'headers': {'www-authenticate': 'Bearer realm="membrane"'}, 'body': {'error': {'message': 'missing or invalid token', 'type': 'unauthorized'}}}

-- ---- the gate: every route but the public shell needs a verified token --------------------------------------
Request.public getter: not this.ui_served and (this.route in ['/', '/index.html', '/membrane', '/favicon.ico', '/ui/login', '/ui/logout'] or startswith(this.route, '/ui/www/'))
Request.gate getter: None if this.public or this.entrant else this.unauthorized

-- ---- the opencode client's boot probes ----------------------------------------------------------------------------------------------
-- The launcher tells Boot:seat.seat_version, .seat_cwd, .seat_home and .seat_project.
Request.f_version getter: ([b.seat_version for b in this.boots] or [''])[0]
Request.f_cwd getter: ([b.seat_cwd for b in this.boots] or [''])[0]
Request.f_home getter: ([b.seat_home for b in this.boots] or [''])[0]
Request.f_project getter: ([b.seat_project for b in this.boots] or [''])[0]
Request.ms getter: num(words(replace(str(clock * 1000), '.', ' '))[0])
Request.path_body getter: {'home': this.f_home, 'state': this.f_home + '/.local/state/opencode', 'config': this.f_home + '/.config/opencode', 'worktree': this.f_cwd, 'directory': this.f_cwd}
Request.project_body getter: {'id': this.f_project, 'worktree': this.f_cwd, 'vcs': 'git', 'time': {'created': this.ms, 'updated': this.ms}, 'sandboxes': []}
-- THE AGENT LIST (server.py `_agent_shapes`, tests/golden/boot/agent.json): the rows the chat's agent picker and the attached TUI read. With NO primary agent
-- the TUI's Enter does nothing, so `build` and `plan` are primary. The released list also appends the seat's live minds (the loop workers, the thinker,
-- the dreamer, with their claims) when it has them: those need the Python loop pool and are not here (the page's mind strip stays empty).
Request.ag_allow getter: [{'permission': '*', 'pattern': '*', 'action': 'allow'}]
Request.ag_body getter: [{'name': 'build', 'native': True, 'mode': 'primary', 'description': 'The default agent. Executes tools based on configured permissions.', 'permission': this.ag_allow, 'options': {}}, {'name': 'plan', 'native': True, 'mode': 'primary', 'description': 'Plan mode.', 'permission': this.ag_allow, 'options': {}}, {'name': 'general', 'native': True, 'mode': 'subagent', 'description': 'General-purpose subagent.', 'permission': this.ag_allow, 'options': {}}, {'name': 'explore', 'native': True, 'mode': 'subagent', 'description': 'Exploration subagent.', 'permission': this.ag_allow, 'options': {}}, {'name': 'watch', 'native': True, 'mode': 'subagent', 'description': 'A watch-trigger thinking loop: reacts or ignores one fired watch event through the membrane tools (the event\'s entity id rides the session title).', 'permission': this.ag_allow, 'options': {}}]

-- THE CONFIG (opencode.py writes the released one at launch; the page reads `model` of it, the TUI the provider): the one provider is membrane's own /v1
-- on this door, serving the seat's default model (Boot fact `minds.seat_default`, the model the launcher picked: claude is the only one in the first swap).
-- No model picked: no `model` keys and no models, the released config's shape without a model.
Request.cf_model getter: str(prop(prop(this.facts, 'minds'), 'seat_default') or '')
Request.cf_port getter: ([prop(h.listen_result, 'port') for h in instances('Http') if prop(h.listen_result, 'port') != None] or [0])[0]
-- (a dict with a DATA key has no c1f form -- `dict(rows)` is a proposed builtin, docs/c1f-stdlib.md --: the one models row is read from JSON text, only for a name
-- that needs no escaping; any other name leaves the list empty)
Request.cf_safe getter: this.cf_model != '' and '"' not in this.cf_model and '\\' not in this.cf_model
Request.cf_models getter: (json('{"' + this.cf_model + '": {"name": "' + this.cf_model + '"}}') or {}) if this.cf_safe else {}
Request.cf_provider getter: {'membrane': {'npm': '@ai-sdk/openai-compatible', 'name': 'Membrane (field)', 'options': {'baseURL': 'http://127.0.0.1:' + str(this.cf_port) + '/v1'}, 'models': this.cf_models}}
Request.cf_body getter:
  WHEN this.cf_model != '': {'$schema': 'https://opencode.ai/config.json', 'autoupdate': False, 'share': 'disabled', 'provider': this.cf_provider, 'model': 'membrane/' + this.cf_model, 'small_model': 'membrane/' + this.cf_model, 'mcp': {}}
  ELSE: {'$schema': 'https://opencode.ai/config.json', 'autoupdate': False, 'share': 'disabled', 'provider': this.cf_provider, 'mcp': {}}

Request.probe getter: this.route in ['/global/health', '/command', '/vcs', '/path', '/project', '/project/current', '/agent', '/config'] or (startswith(this.route, '/project/') and '/directories' in this.route)
Request.probe_reply getter:
  WHEN not this.is_read: {'status': 405, 'body': {'error': 'method not allowed'}}
  ELSE WHEN this.route == '/global/health': {'status': 200, 'body': {'healthy': True, 'version': this.f_version}}
  ELSE WHEN this.route == '/command': {'status': 200, 'body': []}
  ELSE WHEN this.route == '/vcs': {'status': 200, 'body': {'branch': None, 'default_branch': None}}
  ELSE WHEN this.route == '/path': {'status': 200, 'body': this.path_body}
  ELSE WHEN this.route == '/project' or this.route == '/project/current': {'status': 200, 'body': this.project_body}
  ELSE WHEN this.route == '/agent': {'status': 200, 'body': this.ag_body}
  ELSE WHEN this.route == '/config': {'status': 200, 'body': this.cf_body}
  ELSE: {'status': 200, 'body': []}

-- ---- route families (the porting areas): a family pack IMPORTs door 1 and defines two getters on Request --------------------------
--   Request.o_<family> : True when the path is the family's          Request.r_<family> : the reply ({status, headers?, body?}),
--                        or None while it is still being worked out (an effect has not landed). The reserved families:
--   models  decisions  state  voice  session  self  tools  map  fieldvm
-- A family that owns the path answers it, before the shipped routes; the gate still comes first.
Request.owned getter: this.o_models == True or this.o_decisions == True or this.o_state == True or this.o_voice == True or this.o_session == True or this.o_self == True or this.o_tools == True or this.o_map == True or this.o_fieldvm == True
Request.family getter:
  WHEN this.o_models == True: this.r_models
  ELSE WHEN this.o_decisions == True: this.r_decisions
  ELSE WHEN this.o_state == True: this.r_state
  ELSE WHEN this.o_voice == True: this.r_voice
  ELSE WHEN this.o_session == True: this.r_session
  ELSE WHEN this.o_self == True: this.r_self
  ELSE WHEN this.o_map == True: this.r_map
  ELSE WHEN this.o_fieldvm == True: this.r_fieldvm
  ELSE: this.r_tools

-- ---- the standard getters on Request (docs/c1f-stdlib.md): shared, so a family never restates them ------------------------------------
-- facts: the launcher's facts as ONE dict (Boot:seat.facts). jbody: the body as JSON ({} when there is none or it is not JSON).
-- qpairs: the query as rows [[k, v], ...] (undecoded). person: the verified name (the token's name, else its subject).
Request.facts getter: ([b.facts for b in instances('Boot') if b.facts != None] or [{}])[0]
Request.jbody getter: (json(this.body) or {}) if len(this.body or '') > 0 else {}
Request.qpairs getter: [head(concat(words(replace(p, '=', ' ')), ['']), 2) for p in words(replace(this.query or '', '&', ' '))]
Request.person getter: (prop(this.claims, 'name') or this.sub) if this.authed == True else None

-- the declarative method gate: a family that declares `Request.m_<f>` (its allowed methods) gets the 405 and the `allow` header
-- from here; a family that declares none checks for itself (the early families do). A HEAD is a GET.
Request.allow getter:
  WHEN this.o_models == True: this.m_models
  ELSE WHEN this.o_decisions == True: this.m_decisions
  ELSE WHEN this.o_state == True: this.m_state
  ELSE WHEN this.o_voice == True: this.m_voice
  ELSE WHEN this.o_session == True: this.m_session
  ELSE WHEN this.o_self == True: this.m_self
  ELSE WHEN this.o_tools == True: this.m_tools
  ELSE WHEN this.o_map == True: this.m_map
  ELSE WHEN this.o_fieldvm == True: this.m_fieldvm
  ELSE: None
Request.method_ok getter: this.allow == None or this.method in this.allow or (this.method == 'HEAD' and 'GET' in this.allow)
Request.family_checked getter: {'status': 405, 'headers': {'allow': join(this.allow, ', ')}, 'body': {'error': 'method not allowed'}} if not this.method_ok else this.family

Request.own_routes getter: this.conf_reply if this.route == '/ui/conf' else (this.login_reply if this.route == '/ui/login' else (this.logout_reply if this.route == '/ui/logout' else (this.probe_reply if this.probe else this.static_reply)))
Request.routed getter: this.family_checked if this.owned else this.own_routes
Request.shipped getter: this.gate if this.gate != None else this.routed

-- ---- the page's prefix: /ui/serve/<path> is <path> (the released page calls every route through it) --------------------------------
-- The page (membrane/ui/*.js) asks `/ui/serve/session`, `/ui/serve/global/health`, ...; the released Python seat stripped the prefix and
-- answered the route behind it. The door does the same, once and only at the front, with two getters and no rewrite: `ui_served` says
-- the request came through the prefix (the page's own call: door_auth.c1f gives the page its token and refuses a tokenless one), `ui_path`
-- is the path without it, and `route` is the path every route family reads: ALWAYS `this.route`, never `this.route` (the raw path stays
-- as the client sent it; a setter cannot rewrite it: a write back to the property that started the chain is refused as a loop).
Request.ui_served getter: startswith(this.path or '', '/ui/serve/')
Request.ui_path getter: '/' + tail(this.path, len(this.path) - len('/ui/serve/'))
Request.route getter: this.ui_path if this.ui_served else this.path

Request.reply getter: this.override if this.override != None else this.shipped

Request.reply on-setter answer:
  WHEN this.reply != None and prop(this.reply, 'stream') != True:
    this.respond = this.reply
-- a reply with `stream: True` is not a whole answer: it opens an event stream (docs/cliffvm.md, "The event stream"), and the route's own
-- setters then write `send` and `end` on the request. {status?, headers?} are the head.
Request.reply on-setter answer-stream:
  WHEN this.reply != None and prop(this.reply, 'stream') == True:
    this.stream = {'id': 'stream', 'status': prop(this.reply, 'status') or 200, 'headers': prop(this.reply, 'headers') or {}}

-- ---- the boot starts the door ------------------------------------------------------------------------------------------------
-- The launcher tells the seat's facts (Boot:seat.door_port, .door_secret_file, .ui_dir) before it says `started`; with a
-- door_port the boot writes the listen. The verified token's secret is read by the door from that file (never a property).
Http.up getter: this.listen_rc == 0 if this.listen_rc != None else None

Boot.started on-setter door-listen:
  WHEN this.door_port != None:
    ('Http:door').listen = {'id': 'boot', 'port': this.door_port, 'secret_file': this.door_secret_file}
