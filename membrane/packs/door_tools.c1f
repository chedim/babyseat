PACK door_tools 1
IMPORT door 1
IMPORT fs 1
IMPORT proc 1
IMPORT fetch 1
IMPORT store 1
VIRTUAL Return
RESIDENT Pack
-- THE MODEL'S TOOLS AS AN MCP DOOR (#1143, the `tools` route family): `POST /mcp` speaks MCP over plain HTTP, JSON-RPC 2.0, one JSON
-- answer per request (no SSE stream: a GET is a 405). The model's CLI (`claude --mcp-config`) connects here; the tools are the FIELD
-- operations only (operator, 2026-11-12: field manipulation and querying, nothing else; a shell, a file or a fetch is a Command:, File:
-- or Fetch: entity the model writes):
--   entity_query {q, k, offset, full, count}  which entities exist: `kind:<Class>`, `kind!:<Class>` (all but that class) and `name~:<eid prefix>`,
--                                     joined with `&`; k rows (default 20, at most 100) from row `offset` (default 0); full=true adds each row's stored properties
--   entity_read  {spec, prop}         an entity's stored properties, or one property in full (a getter's value too)
--   entity_write {spec, prop, value}  set one property; what reacts to the write runs (a setter, a driver verb: `Command:x.run = {id, args}`)
-- `spec` is an entity id as the field spells it (`Command:build`, `membrane::Chat:main`). A write is a write like any pack's: the class
-- must be one this pack owns or imports (door, fs, proc, fetch, store), or one no pack owns yet, UNLESS this pack is privileged: boot.c1f
-- grants it at start (docs/c1f-layers.md, "Privilege"), so a write here may also reach, and create, a class a model's pack owns. A refusal is in the reply. An effect's
-- receipt lands as `<verb>_result` on the entity: read it back.
-- Methods: initialize, notifications/* (a request without an id: 202, no body), ping, tools/list, tools/call.

Request.o_tools getter: this.route == '/mcp'
Request.m_tools getter: ['POST']

-- ---- Pack entities: the model's own packs (docs/cliffvm.md, "Pack entities") ----------------------------------------------------------
-- `entity_write {spec: 'Pack:<name>', prop: 'text', value: <c1f>}` makes the entity (this pack owns the class) and the HOST loads the text
-- (`Fields::set_pack`), then mirrors `loaded`, `error` and `good_text` back. `state` says in one word what became of the last text.
Pack.state getter: 'error' if this.error != None else ('loaded' if this.loaded == True else 'waiting')

-- ---- the JSON-RPC request ---------------------------------------------------------------------------------------------------------------
Request.mc_rpc getter: json(this.body or '')
Request.mc_ok getter: prop(this.mc_rpc, 'jsonrpc') == '2.0' and prop(this.mc_rpc, 'method') != None
Request.mc_id getter: prop(this.mc_rpc, 'id')
Request.mc_method getter: str(prop(this.mc_rpc, 'method') or '')
Request.mc_params getter: prop(this.mc_rpc, 'params') or {}
Request.mc_args getter: prop(this.mc_params, 'arguments') or {}
Request.mc_tool getter: prop(this.mc_params, 'name')
Request.mc_known getter: this.mc_tool in ['entity_query', 'entity_read', 'entity_write', 'run_cliff']

-- ---- the tools' list -----------------------------------------------------------------------------------------------------------------------
Request.mc_tools getter: [{'name': 'entity_query', 'description': 'enumerate entities. q: kind:<Class>, kind!:<Class> (all but that class) and name~:<eid prefix>, joined with & (empty = all). k = the row cap (default 20, at most 100), offset = rows to skip (paging), full=true adds the properties of each row, count=true gives only the number.', 'inputSchema': {'type': 'object', 'properties': {'q': {'type': 'string', 'description': 'the query line, e.g. kind:Command & name~:Command:b'}, 'k': {'type': 'integer', 'description': 'the row cap (default 20, at most 100)'}, 'offset': {'type': 'integer', 'description': 'rows to skip, for paging'}, 'full': {'type': 'boolean', 'description': 'add the stored properties of each row'}, 'count': {'type': 'boolean', 'description': 'only the count'}}}}, {'name': 'entity_read', 'description': 'read an entity: its stored properties, or with prop one property in full (a getter value too).', 'inputSchema': {'type': 'object', 'properties': {'spec': {'type': 'string', 'description': 'the entity id'}, 'prop': {'type': 'string', 'description': 'one property'}}, 'required': ['spec']}}, {'name': 'entity_write', 'description': 'act by writing: set one property. What reacts to the write runs (pack setters, driver verbs such as Command run or File write). The reply carries the receipt of an effect the write started (stdout, stderr, rc), the reactions (what the engine wrote because of this write, each with its reason). wait (seconds) holds the reply until the receipt arrives; with no wait a receipt that is not there yet is named, to read as <prop>_result.', 'inputSchema': {'type': 'object', 'properties': {'spec': {'type': 'string', 'description': 'the entity id'}, 'prop': {'type': 'string', 'description': 'the property'}, 'value': {'description': 'the value (any JSON)'}, 'wait': {'type': 'number', 'description': 'seconds to hold the reply for the receipt of an effect (optional)'}}, 'required': ['spec', 'prop']}}, {'name': 'run_cliff', 'description': 'run a clifflet: a small block of the field language (help entity Help:cliff) in ONE call. Its lines may define locals; the last line is the value, which comes back as text (JSON for a list or dict), so one call can read several entities, filter and join them. A block whose last line is a write (<entity>.<prop> = value) runs its writes instead and answers with their reactions; an effect started that way has its receipt in a later round: read <entity>.<verb>_result. A block that does not load answers with the loader error, one that runs past its step or time budget answers with that reason.', 'inputSchema': {'type': 'object', 'properties': {'code': {'type': 'string', 'description': 'the block: lines, the last one the value (or a write)'}}, 'required': ['code']}}]

-- ---- entity_write: a write by name (a computed property name) -------------------------------------------------------------------------------
Request.mc_w_spec getter: strip(str(prop(this.mc_args, 'spec') or ''))
Request.mc_w_prop getter: strip(str(prop(this.mc_args, 'prop') or ''))
-- A bare id names the `membrane::` one when only that exists: the chat's own entities (Chat:main, Banner:owner:main, ...) are spelled with that
-- namespace in their packs, and a bare spelling of one of them reaches it instead of creating a second entity. An id that already has a row,
-- or has no `membrane::` twin, is used as written.
Request.mc_w_id getter: ('membrane::' + this.mc_w_spec) if prop('membrane::' + this.mc_w_spec, 'eid') != None and prop(this.mc_w_spec, 'eid') == None else this.mc_w_spec
Request.mc_w_bad getter: 'entity_write needs spec (the entity\'s id) and prop' if this.mc_w_spec == '' or this.mc_w_prop == '' else None
Request.mc_write getter: {'spec': this.mc_w_id, 'prop': this.mc_w_prop, 'value': prop(this.mc_args, 'value')} if this.mc_tool == 'entity_write' and this.mc_w_bad == None else None
Request.mc_write on-setter mcp-write:
  WHEN this.mc_write != None:
    this.mc_w_t0 = clock
    this.mc_w_old = prop(prop(this.mc_write, 'spec'), prop(this.mc_write, 'prop') + '_result')
    (prop(this.mc_write, 'spec')).[prop(this.mc_write, 'prop')] = prop(this.mc_write, 'value')
    this.mc_done = True

-- ---- what a write returns (docs/cliffvm.md, "The return entity") -------------------------------------------------------------------------------
-- A write that starts an effect (a driver's verb) has a RECEIPT: the property `<prop>_result` of the same entity. The reply carries the receipt when it is
-- there, the REACTIONS (what the engine wrote in the round of this write: `reactions`, told back by the host as a derived write on this Request), and the
-- (a transient Return entity carries the reply and is collected once it is delivered). `wait` (seconds, optional) holds the reply until the receipt or that time; with none the
-- reply is made at once and a receipt that is not there says where to read it.
Request.mc_w_wait getter: num(prop(this.mc_args, 'wait')) or 0
Request.mc_w_cls getter: (words(replace(replace(this.mc_w_id, 'membrane::', ''), ':', ' ')) or [''])[0]
Request.mc_w_effect getter: (this.mc_w_cls + '.' + this.mc_w_prop) in ['File.write', 'File.move', 'File.delete', 'Command.run', 'Command.stop', 'Store.run', 'Fetch.request']
Request.mc_w_rprop getter: this.mc_w_prop + '_result'
Request.mc_w_rec getter: prop(this.mc_w_id, this.mc_w_rprop) if this.mc_done == True and this.mc_w_effect else None
-- the receipt of THIS write: what is there now, unless it is what was there before the write
Request.mc_w_new getter: this.mc_w_rec if this.mc_w_rec != None and this.mc_w_rec != this.mc_w_old else None
Request.mc_w_ready getter:
  WHEN this.mc_done != True or this.reactions == None: False
  ELSE WHEN not this.mc_w_effect: True
  ELSE WHEN this.mc_w_new != None: True
  ELSE WHEN this.mc_w_wait <= 0: True
  ELSE: clock - this.mc_w_t0 >= this.mc_w_wait
Request.mc_w_n getter: replace(this.eid, 'Request:', '')
Request.mc_w_ready on-setter mcp-return:
  WHEN this.mc_w_ready == True:
    Return:call[this.mc_w_n] = Return(tool: 'entity_write', target: this.mc_w_id, written: this.mc_w_prop, result_prop: this.mc_w_rprop if this.mc_w_effect else None, reactions: this.reactions)
    this.mc_w_returned = Return:call[this.mc_w_n]
Return.kind getter: 'return'
Return.receipt getter: prop(this.target, this.result_prop) if this.result_prop != None else None
Return.state getter: 'pending' if this.result_prop != None and this.receipt == None else 'done'
-- THE RETURN ENTITY IS TRANSIENT (operator, 2026-11-13): it carries the reply and is never retired by a write: the Request HOLDS it (`mc_w_returned` is a reference to it, a
-- `$ref` value), and a Request is held by its open connection until the reply is delivered, so both are collected together (docs/cliffvm.md, "Garbage collection"). The
-- receipt stays where it always lived, `<prop>_result` on the target.
Request.mc_w_head getter: 'wrote ' + this.mc_w_id + '.' + this.mc_w_prop
-- THE REPLY'S SIZE (operator, 2026-11-13: the Claude CLI refuses a tool result over its MCP limit and the model then gets nothing): the reply carries the first
-- and the last `mc_w_cap` characters (8192, about 8 KB) of each stream, with its total size in bytes (`stdout_bytes`); a stream of at most twice the cap comes whole
-- (`stdout`). The FULL text stays on the Command: `Command:x.output` (stdout), `Command:x.errors` (stderr): read it with entity_read or cut it with run_cliff.
-- (`tail(text, n)` is the mirror of `head`: the language has no slice.)
Request.mc_w_cap getter: 8192
Request.mc_w_so getter: str(prop(this.mc_w_new, 'stdout') or '')
Request.mc_w_se getter: str(prop(this.mc_w_new, 'stderr') or '')
Request.mc_w_sob getter: prop(this.mc_w_new, 'stdout_bytes') or 0
Request.mc_w_seb getter: prop(this.mc_w_new, 'stderr_bytes') or 0
Request.mc_w_pout getter:
  WHEN this.mc_w_sob == 0: None
  ELSE WHEN this.mc_w_sob <= 2 * this.mc_w_cap: {'stdout': this.mc_w_so}
  ELSE: {'stdout_head': head(this.mc_w_so, this.mc_w_cap), 'stdout_tail': tail(this.mc_w_so, this.mc_w_cap)}
Request.mc_w_perr getter:
  WHEN this.mc_w_seb == 0: None
  ELSE WHEN this.mc_w_seb <= 2 * this.mc_w_cap: {'stderr': this.mc_w_se}
  ELSE: {'stderr_head': head(this.mc_w_se, this.mc_w_cap), 'stderr_tail': tail(this.mc_w_se, this.mc_w_cap)}
Request.mc_w_rcpt getter:
  WHEN not this.mc_w_effect: []
  ELSE WHEN this.mc_w_new != None: concat(concat(concat(concat(concat(concat(['receipt: ' + str({'id': prop(this.mc_w_new, 'id'), 'status': prop(this.mc_w_new, 'status'), 'rc': prop(this.mc_w_new, 'rc'), 'ok': prop(this.mc_w_new, 'status') == 'ok', 'started': prop(this.mc_w_new, 'started'), 'finished': prop(this.mc_w_new, 'finished'), 'ms': prop(this.mc_w_new, 'ms'), 'timeout_s': prop(this.mc_w_new, 'timeout_s'), 'killed': prop(this.mc_w_new, 'killed'), 'stdout_bytes': prop(this.mc_w_new, 'stdout_bytes'), 'stderr_bytes': prop(this.mc_w_new, 'stderr_bytes')})], ['stdout: ' + str(x) for x in [this.mc_w_pout] if x != None]), ['stderr: ' + str(x) for x in [this.mc_w_perr] if x != None]), ['full output: read ' + this.mc_w_id + '.output' for x in [this.mc_w_pout] if x != None and prop(x, 'stdout_head') != None]), ['full stderr: read ' + this.mc_w_id + '.errors' for x in [this.mc_w_perr] if x != None and prop(x, 'stderr_head') != None]), ['error: ' + str(prop(this.mc_w_new, 'head')) for x in [this.mc_w_new] if prop(x, 'status') == 'error' and prop(x, 'stdout_bytes') == None]), ['timeout: ' + str(this.mc_w_id) + ' timed out after ' + str(prop(x, 'timeout_s')) + ' s (killed); start it again with a bigger timeout_s, e.g. run = {id, cmd, timeout_s: 600}; the partial output is above and in ' + str(this.mc_w_id) + '.partial_output' for x in [this.mc_w_new] if prop(x, 'status') == 'timeout'])
  ELSE: ['pending: id: ' + str(prop(prop(this.mc_args, 'value'), 'id')) + ', status: running, started: ' + str(prop(prop(this.mc_w_id, 'running'), 'started') or this.mc_w_t0) + ', timeout_s: ' + str(prop(prop(this.mc_w_id, 'running'), 'timeout_s') or prop(this.mc_w_id, 'timeout_default')) + ', left: ' + str((prop(prop(this.mc_w_id, 'running'), 'timeout_s') or prop(this.mc_w_id, 'timeout_default')) + prop(prop(this.mc_w_id, 'running'), 'started') - this.mc_w_t0) + ' s; read ' + this.mc_w_id + '.' + this.mc_w_rprop + ' later']
Request.mc_w_text getter:
  WHEN this.mc_write == None: None
  ELSE WHEN this.mc_done != True: None
  ELSE WHEN this.refused != None: 'refused: ' + str(this.refused)
  ELSE WHEN this.mc_w_returned == None: None
  ELSE: join(concat(concat([this.mc_w_head], this.mc_w_rcpt), ['reactions: ' + str(this.reactions)]), '\n')

-- ---- run_cliff: a clifflet, one call (docs/cliffvm.md, "run_cliff") ------------------------------------------------------------------------------
-- The block is loaded as two scratch packs at once, `cliffg<n>` (the block as a getter: a value) and `cliffs<n>` (the block as an on-setter body: writes; privileged,
-- so it may write any class like entity_write does), each with its own class. Whichever loads runs: a block that is a value runs as the getter (its entity is
-- born by a write), one whose last line is a write runs as the setter (`go`), and one that loads as neither answers with both loader errors. The answer is read
-- from the scratch entity, then the packs, the entity and any trip entity are retired: nothing accumulates. The getter runs under the engine's step budget and
-- time allowance (docs/c1f-stdlib.md): a runaway block answers with that reason and the seat stays up. A write's reactions come from the host like entity_write's.
Request.cl_code getter: str(prop(this.mc_args, 'code') or '')
Request.cl_bad getter: 'run_cliff needs code (a block of lines; the last one is the value)' if this.mc_tool == 'run_cliff' and strip(this.cl_code) == '' else None
Request.cl_on getter: this.mc_tool == 'run_cliff' and this.cl_bad == None
Request.cl_n getter: replace(this.eid, 'Request:', '')
Request.cl_gp getter: 'Pack:cliffg' + this.cl_n
Request.cl_sp getter: 'Pack:cliffs' + this.cl_n
Request.cl_ge getter: 'Cliffg' + this.cl_n + ':x'
Request.cl_se getter: 'Cliffs' + this.cl_n + ':x'
Request.cl_gtext getter: 'PACK cliffg' + this.cl_n + ' 1\nCliffg' + this.cl_n + '.val getter:\n' + join(['  ' + l for l in lines(this.cl_code)], '\n') + '\nCliffg' + this.cl_n + '.shown getter: {\'v\': this.val, \'why\': why(this.val)}\n'
Request.cl_stext getter: 'PACK cliffs' + this.cl_n + ' 1\nIMPORT door 1\nIMPORT fs 1\nIMPORT proc 1\nIMPORT fetch 1\nIMPORT store 1\nCliffs' + this.cl_n + '.go on-setter run:\n  ALWAYS:\n' + join(['    ' + l for l in lines(this.cl_code)], '\n') + '\n'
Request.cl_start getter: this.cl_code if this.cl_on else None
Request.cl_start on-setter cliff-load:
  WHEN this.cl_start != None:
    (this.cl_gp).scratch = True
    (this.cl_sp).scratch = True
    (this.cl_sp).privileged = True
    (this.cl_gp).text = this.cl_gtext
    (this.cl_sp).text = this.cl_stext
    this.cl_loading = True
Request.cl_gstate getter: prop(this.cl_gp, 'state') if this.cl_loading == True else None
Request.cl_sstate getter: prop(this.cl_sp, 'state') if this.cl_loading == True else None
Request.cl_mode getter:
  WHEN this.cl_gstate == 'loaded': 'value'
  ELSE WHEN this.cl_gstate == 'error' and this.cl_sstate == 'loaded': 'write'
  ELSE WHEN this.cl_gstate == 'error' and this.cl_sstate == 'error': 'error'
  ELSE: None
Request.cl_mode on-setter cliff-run:
  WHEN this.cl_mode == 'value':
    (this.cl_ge).seed = True
  ELSE WHEN this.cl_mode == 'write':
    (this.cl_se).go = True
    this.mc_done = True
Request.cl_shown getter: prop(this.cl_ge, 'shown') if this.cl_mode == 'value' else None
Request.cl_out getter:
  WHEN this.cl_final != None: this.cl_final
  ELSE WHEN this.cl_mode == 'error': {'text': 'the block did not load.\nas a value: ' + str(prop(this.cl_gp, 'error')) + '\nas writes: ' + str(prop(this.cl_sp, 'error')), 'err': True}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None and prop(this.cl_shown, 'why') != None: {'text': str(prop(this.cl_shown, 'why')) if startswith(str(prop(this.cl_shown, 'why')), 'error') else 'error: ' + str(prop(this.cl_shown, 'why')), 'err': True}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None and prop(this.cl_shown, 'v') == None: {'text': 'null', 'err': False}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None: {'text': str(prop(this.cl_shown, 'v')), 'err': False}
  ELSE WHEN this.cl_mode == 'write' and this.reactions != None: {'text': 'ran the writes of the block\nreactions: ' + str(this.reactions) + '\nan effect it started has its receipt in a later round: read <entity>.<verb>_result', 'err': False}
  ELSE: None
Request.cl_out on-setter cliff-finish:
  WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'error':
    this.cl_final = this.cl_out
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True
  ELSE WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'value':
    this.cl_final = this.cl_out
    (this.cl_ge).retire = True
    (this.cl_gp).text = ''
    (this.cl_sp).text = ''
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True
  ELSE WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'write':
    this.cl_final = this.cl_out
    (this.cl_se).retire = True
    (this.cl_gp).text = ''
    (this.cl_sp).text = ''
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True

-- ---- entity_read: the store's row (stored properties) or one property through the field ---------------------------------------------------
Request.mc_r_spec getter: strip(str(prop(this.mc_args, 'spec') or ''))
Request.mc_r_prop getter: prop(this.mc_args, 'prop')
Request.mc_r_id getter: ('membrane::' + this.mc_r_spec) if prop('membrane::' + this.mc_r_spec, 'eid') != None and prop(this.mc_r_spec, 'eid') == None else this.mc_r_spec
Request.mc_r_bad getter: 'entity_read needs spec (the entity\'s id)' if this.mc_r_spec == '' else None
Request.mc_r_rows getter: sql('SELECT json_extract(body, \'$.cls\') AS cls, json_extract(body, \'$.props\') AS props FROM c_field WHERE k = ?', this.mc_r_id) if this.mc_tool == 'entity_read' and this.mc_r_bad == None and this.mc_r_prop == None else None
Request.mc_r_val getter: prop(this.mc_r_id, str(this.mc_r_prop)) if this.mc_tool == 'entity_read' and this.mc_r_bad == None and this.mc_r_prop != None else None
Request.mc_r_text getter:
  WHEN this.mc_tool != 'entity_read' or this.mc_r_bad != None: None
  ELSE WHEN this.mc_r_prop != None and this.mc_r_val == None: this.mc_r_id + ' has no ' + str(this.mc_r_prop)
  ELSE WHEN this.mc_r_prop != None: str(this.mc_r_val)
  ELSE WHEN this.mc_r_rows == None: None
  ELSE WHEN len(this.mc_r_rows) == 0: 'no such entity: ' + this.mc_r_spec
  ELSE: this.mc_r_id + ' (' + str(prop(this.mc_r_rows[0], 'cls')) + ') ' + str(prop(this.mc_r_rows[0], 'props'))

-- ---- entity_query: the store's rows by kind and eid prefix (a kind is the entity's own class or one of its `parents`, `cls:<kind>`) -----------------------------------------------------------------------------------
Request.mc_q_terms getter: words(replace(str(prop(this.mc_args, 'q') or ''), '&', ' '))
Request.mc_q_kinds getter: [after(t, 'kind:') for t in this.mc_q_terms if startswith(t, 'kind:')]
Request.mc_q_names getter: [after(t, 'name~:') for t in this.mc_q_terms if startswith(t, 'name~:')]
Request.mc_q_nots getter: [after(t, 'kind!:') for t in this.mc_q_terms if startswith(t, 'kind!:')]
Request.mc_q_other getter: [t for t in this.mc_q_terms if not startswith(t, 'kind:') and not startswith(t, 'kind!:') and not startswith(t, 'name~:')]
Request.mc_q_kind getter: ([x for x in this.mc_q_kinds if x != '*'] or [''])[0]
Request.mc_q_name getter: (this.mc_q_names or [''])[0]
Request.mc_q_not getter: (this.mc_q_nots or [''])[0]
Request.mc_q_off getter: max(num(prop(this.mc_args, 'offset')) or 0, 0)
Request.mc_q_k getter: min(max(num(prop(this.mc_args, 'k')) or 20, 1), 100)
Request.mc_q_bad getter: 'entity_query: unsupported term ' + this.mc_q_other[0] + ' (kind:<Class>, kind!:<Class> and name~:<eid prefix>, joined with &)' if len(this.mc_q_other) > 0 else None
Request.mc_q_on getter: this.mc_tool == 'entity_query' and this.mc_q_bad == None
Request.mc_q_rows getter: sql('SELECT k, json_extract(body, \'$.cls\') AS cls, CASE WHEN ? = 1 THEN json_extract(body, \'$.props\') END AS props FROM c_field WHERE (? = \'\' OR json_extract(body, \'$.cls\') = ? OR EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?))) AND (? = \'\' OR (json_extract(body, \'$.cls\') != ? AND NOT EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?)))) AND substr(k, 1, length(?)) = ? ORDER BY k LIMIT ? OFFSET ?', 1 if prop(this.mc_args, 'full') == True else 0, this.mc_q_kind, this.mc_q_kind, this.mc_q_kind, this.mc_q_not, this.mc_q_not, this.mc_q_not, this.mc_q_name, this.mc_q_name, this.mc_q_k, this.mc_q_off) if this.mc_q_on and prop(this.mc_args, 'count') != True else None
Request.mc_q_count getter: sql('SELECT count(*) AS n FROM c_field WHERE (? = \'\' OR json_extract(body, \'$.cls\') = ? OR EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?))) AND (? = \'\' OR (json_extract(body, \'$.cls\') != ? AND NOT EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?)))) AND substr(k, 1, length(?)) = ?', this.mc_q_kind, this.mc_q_kind, this.mc_q_kind, this.mc_q_not, this.mc_q_not, this.mc_q_not, this.mc_q_name, this.mc_q_name) if this.mc_q_on and prop(this.mc_args, 'count') == True else None
Request.mc_q_text getter:
  WHEN not this.mc_q_on: None
  ELSE WHEN prop(this.mc_args, 'count') == True: (str(prop(this.mc_q_count[0], 'n')) + ' entity(ies)') if this.mc_q_count != None and len(this.mc_q_count) > 0 else None
  ELSE WHEN this.mc_q_rows == None: None
  ELSE WHEN len(this.mc_q_rows) == 0: '0 entity(ies)'
  ELSE: join([prop(r, 'k') + ' (' + str(prop(r, 'cls')) + ')' + ((' ' + str(prop(r, 'props'))) if prop(this.mc_args, 'full') == True else '') for r in this.mc_q_rows], '\n')

-- ---- the tool call's result ---------------------------------------------------------------------------------------------------------------------
Request.mc_bad getter: (this.mc_w_bad if this.mc_tool == 'entity_write' else (this.mc_r_bad if this.mc_tool == 'entity_read' else (this.cl_bad if this.mc_tool == 'run_cliff' else this.mc_q_bad)))
Request.mc_text getter:
  WHEN not this.mc_known: 'unknown tool: ' + str(this.mc_tool)
  ELSE WHEN this.mc_bad != None: this.mc_bad
  ELSE WHEN this.mc_tool == 'entity_write': this.mc_w_text
  ELSE WHEN this.mc_tool == 'entity_read': this.mc_r_text
  ELSE WHEN this.mc_tool == 'run_cliff': prop(this.cl_out, 'text')
  ELSE: this.mc_q_text
Request.mc_is_err getter: (not this.mc_known) or this.mc_bad != None or startswith(str(this.mc_text or ''), 'refused') or (this.mc_tool == 'run_cliff' and prop(this.cl_out, 'err') == True)
Request.mc_call getter: {'content': [{'type': 'text', 'text': this.mc_text}], 'isError': this.mc_is_err} if this.mc_text != None else None

-- ---- the answers ----------------------------------------------------------------------------------------------------------------------------------
Request.mc_init getter: {'protocolVersion': prop(this.mc_params, 'protocolVersion') or '2025-03-26', 'capabilities': {'tools': {'listChanged': False}}, 'serverInfo': {'name': 'membrane', 'version': str(prop(this.facts, 'seat_version') or '')}}
Request.mc_result getter:
  WHEN this.mc_method == 'initialize': this.mc_init
  ELSE WHEN this.mc_method == 'ping': {}
  ELSE WHEN this.mc_method == 'tools/list': {'tools': this.mc_tools}
  ELSE WHEN this.mc_method == 'tools/call': this.mc_call
  ELSE: None
Request.mc_known_method getter: this.mc_method in ['initialize', 'ping', 'tools/list', 'tools/call']
Request.r_tools getter:
  WHEN this.mc_rpc == None: {'status': 400, 'body': {'jsonrpc': '2.0', 'id': None, 'error': {'code': -32700, 'message': 'parse error'}}}
  ELSE WHEN not this.mc_ok: {'status': 400, 'body': {'jsonrpc': '2.0', 'id': None, 'error': {'code': -32600, 'message': 'invalid request'}}}
  ELSE WHEN this.mc_id == None: {'status': 202}
  ELSE WHEN not this.mc_known_method: {'status': 200, 'body': {'jsonrpc': '2.0', 'id': this.mc_id, 'error': {'code': -32601, 'message': 'method not found: ' + this.mc_method}}}
  ELSE WHEN this.mc_result == None: None
  ELSE: {'status': 200, 'body': {'jsonrpc': '2.0', 'id': this.mc_id, 'result': this.mc_result}}
