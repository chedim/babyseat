PACK door_tools 1
IMPORT door 1
IMPORT fs 1
IMPORT proc 1
IMPORT fetch 1
IMPORT sql 1
IMPORT store 1
VIRTUAL Return
RESIDENT Pack
-- THE MODEL'S TOOLS AS AN MCP DOOR (#1143, the `tools` route family): `POST /mcp` speaks MCP over plain HTTP, JSON-RPC 2.0, one JSON
-- answer per request (no SSE stream: a GET is a 405). The model's CLI (`claude --mcp-config`) connects here; the tools are the FIELD
-- operations only (operator, 2026-11-12: field manipulation and querying, nothing else; a shell, a file or a fetch is a Command:, File:
-- or Fetch: entity the model writes; a second SQLite file is a SqlSource: and SqlQuery: entity pair, read the topic with entity_read Help:sql):
--   entity_query {q, k, offset, count}  which entities exist: `kind:<Class>`, `kind!:<Class>` (all but that class) and `name~:<eid prefix>`,
--                                     joined with `&`; k rows (default 20, at most 100) from row `offset` (default 0); a row is its id and its class: a value is read with run_cliff (`<entity>[name]`)
--   entity_read  {spec}               the index of an entity, `meta(spec)`: its class, parents, property names, getter names and setter names, no value (a value is read with run_cliff, `<entity>[name]`)
--   entity_write {spec, prop, value}  set one property; what reacts to the write runs (a setter, a driver verb: `Command:x.run = {id, args}`)
--   run_cliff    {block}              run a small block of c1f in one call (Help:cliff): a value, or writes
-- `spec` is an entity id as the field spells it (`Command:build`, `membrane::Chat:main`). A write is a write like any pack's: the class
-- must be one this pack owns or imports (door, fs, proc, fetch, sql, store), or one no pack owns yet, UNLESS this pack is privileged: boot.c1f
-- grants it at start (docs/c1f-layers.md, "Privilege"), so a write here may also reach, and create, a class a model's pack owns. A refusal is in the reply. An effect's
-- receipt lands as `<verb>_result` on the entity: read it back.
-- Methods: initialize, notifications/* (a request without an id: 202, no body), ping, tools/list, tools/call.

Request.o_tools getter: this.route == '/mcp'
Request.m_tools getter: ['POST']

-- ---- Pack entities: the model's own packs (docs/cliffvm.md, "Pack entities") ----------------------------------------------------------
-- `entity_write {spec: 'Pack:<name>', prop: 'text', value: <c1f>}` makes the entity (this pack owns the class) and the HOST loads the text
-- (`Fields::set_pack`), then mirrors `loaded`, `error` and `good_text` back. `state` says in one word what became of the last text.
Pack.state getter: 'removed' if str(this.text or '') == '' else ('error' if this.error != None else ('loaded' if this.loaded == True else 'waiting'))

-- ---- the JSON-RPC request ---------------------------------------------------------------------------------------------------------------
Request.mc_rpc getter:
  mr = json(this.body or '')
  None if mr is Error else mr
Request.mc_ok getter: ${this.mc_rpc}['jsonrpc'] == '2.0' and ${this.mc_rpc}['method'] != None
Request.mc_id getter: ${this.mc_rpc}['id']
Request.mc_method getter: str(${this.mc_rpc}['method'] or '')
Request.mc_params getter: ${this.mc_rpc}['params'] or {}
Request.mc_args getter: ${this.mc_params}['arguments'] or {}
Request.mc_tool getter: ${this.mc_params}['name']
-- THE WRITING TOOLS NEED A VERIFIED TOKEN (no users in this release: every verified token is the admin, door.c1f): a call of `entity_write` (a pack is written by it too:
-- `Pack:<name>.text`) or `run_cliff` with no verified token runs nothing (the door's 401 is the reply; a setter would run whatever the reply is, so the writers read this too).
Request.mc_anon getter: this.mc_method == 'tools/call' and this.mc_tool in ['entity_write', 'run_cliff'] and not this.entrant
Request.mc_known getter: this.mc_tool in ['entity_query', 'entity_read', 'entity_write', 'run_cliff']

-- ---- the tools' list -----------------------------------------------------------------------------------------------------------------------
Request.mc_tools getter: [{'name': 'entity_query', 'description': 'enumerate entities. q: kind:<Class>, kind!:<Class> (all but that class) and name~:<eid prefix>, joined with & (empty = all). k = the row cap (default 20, at most 100), offset = rows to skip (paging), count=true gives only the number.', 'inputSchema': {'type': 'object', 'properties': {'q': {'type': 'string', 'description': 'the query line, e.g. kind:Command & name~:Command:b'}, 'k': {'type': 'integer', 'description': 'the row cap (default 20, at most 100)'}, 'offset': {'type': 'integer', 'description': 'rows to skip, for paging'}, 'count': {'type': 'boolean', 'description': 'only the count'}}}}, {'name': 'entity_read', 'description': 'the index of an entity: its class, parents and the names of its properties, getters and setters. No value: read one with run_cliff (e.g. Chat:x[\'text\']).', 'inputSchema': {'type': 'object', 'properties': {'spec': {'type': 'string', 'description': 'the entity id'}}, 'required': ['spec']}}, {'name': 'entity_write', 'description': 'act by writing: set one property. What reacts to the write runs (pack setters, driver verbs such as Command run or File write). The reply carries the receipt of an effect the write started (stdout, stderr, rc), the reactions (what the engine wrote because of this write, each with its reason). wait (seconds) holds the reply until the receipt arrives; with no wait a receipt that is not there yet is named, to read as <prop>_result.', 'inputSchema': {'type': 'object', 'properties': {'spec': {'type': 'string', 'description': 'the entity id'}, 'prop': {'type': 'string', 'description': 'the property'}, 'value': {'description': 'the value (any JSON)'}, 'wait': {'type': 'number', 'description': 'seconds to hold the reply for the receipt of an effect (optional)'}}, 'required': ['spec', 'prop']}}, {'name': 'run_cliff', 'description': 'run a clifflet: a small block of the field language (help entity Help:cliff) in ONE call. Its lines may define locals; the last line is the value, which comes back as text (JSON for a list or dict), so one call can read several entities, filter and join them. A block whose last line is a write (<entity>.<prop> = value) runs its writes instead and answers with their reactions; an effect started that way has its receipt in a later round: read <entity>.<verb>_result. A block that does not load answers with the loader error, one that runs past its step budget answers with that reason.', 'inputSchema': {'type': 'object', 'properties': {'code': {'type': 'string', 'description': 'the block: lines, the last one the value (or a write)'}}, 'required': ['code']}}]

-- ---- entity_write: a write by name (a computed property name) -------------------------------------------------------------------------------
Request.mc_w_spec getter: strip(str(${this.mc_args}['spec'] or ''))
Request.mc_w_prop getter: strip(str(${this.mc_args}['prop'] or ''))
-- A bare id names the `membrane::` one when only that exists: the chat's own entities (Chat:main, Banner:admin:main, ...) are spelled with that
-- namespace in their packs, and a bare spelling of one of them reaches it instead of creating a second entity. The engine does the mapping
-- (cliffvm 0.4.1: a read of a bare id nobody holds goes to the `membrane::` twin) and `eid` answers the id it read: an id that already has a row,
-- or has no `membrane::` twin, is used as written.
Request.mc_w_id getter: str(${this.mc_w_spec}['eid']) if ${this.mc_w_spec}['eid'] != None else this.mc_w_spec
-- DEATH BY NULL (operator, 2026-11-14): `entity_write {spec: 'Stop:3', value: null}` with NO prop destroys the entity, the mirror of a birth (`Stop:3 = None`); a Pack unloads. The key
-- `value` must be there and null: a call that merely forgets the prop is still refused.
Request.mc_w_kill getter: this.mc_w_prop == '' and 'value' in this.mc_args and ${this.mc_args}['value'] == None
Request.mc_w_bad getter: 'entity_write needs spec (the entity\'s id) and prop (or value: null with no prop, to remove the entity)' if this.mc_w_spec == '' or (this.mc_w_prop == '' and not this.mc_w_kill) else ('refused: entity_write needs an id of the form <Class>:<key> (got `' + this.mc_w_spec + '`): an id with no colon names no entity, nothing was written' if not (':' in this.mc_w_spec) else ('refused: `parents` is not written by the model: classes are set at birth with a constructor (`x is Class` tests one)' if this.mc_w_prop == 'parents' else None))
Request.mc_write getter: {'spec': this.mc_w_id, 'prop': this.mc_w_prop, 'value': ${this.mc_args}['value']} if this.mc_tool == 'entity_write' and this.mc_w_bad == None and not this.mc_anon else None
Request.mc_write on-setter mcp-write:
  WHEN this.mc_write != None and this.mc_w_kill:
    (${this.mc_write}['spec']) = None
    this.mc_done = True
  ELSE WHEN this.mc_write != None:
    this.mc_w_t0 = clock
    this.mc_w_old = ${${this.mc_write}['spec']}[${this.mc_write}['prop'] + '_result']
    (${this.mc_write}['spec']).[${this.mc_write}['prop']] = ${this.mc_write}['value']
    this.mc_done = True

-- THE TURN'S LINK (operator 2026-11-14): the turn's MCP config carries `X-Turn: <the message's id>` (chat_turn.c1f). Every entity says what birthed it (`born_by`, the VM's own): for a thing a call
-- created, that is the call's Request, and the Request names the message it belongs to here (`mc_message`: the header's value when it names an existing chat message, nothing otherwise).
Request.mc_turn getter: ${this.headers}['x-turn']
Request.mc_message getter:
  WHEN this.mc_turn != None and startswith(str(this.mc_turn), 'membrane::Chat:') and ${this.mc_turn}['eid'] != None: this.mc_turn
  ELSE: None
-- Whatever a call creates is charged to the message when there is one (the VM rule `births_to`, docs/cliffvm.md): the new entity's `born_by` is then the message, which outlives the call's Request;
-- with no message it is the Request. `run_cliff` hands the same to the scratch entity whose setter runs the block (`cl_se`, `cliff-run`).
Request.births_to getter: this.mc_message or this.eid

-- ---- what a write returns (docs/cliffvm.md, "The return entity") -------------------------------------------------------------------------------
-- A write that starts an effect (a driver's verb) has a RECEIPT: the property `<prop>_result` of the same entity. The reply carries the receipt when it is
-- there, the REACTIONS (what the engine wrote in the round of this write: `reactions`, told back by the host as a derived write on this Request), and the
-- (a transient Return entity carries the reply and is collected once it is delivered). `wait` (seconds, optional) holds the reply until the receipt or that time; with none the
-- reply is made at once and a receipt that is not there says where to read it.
Request.mc_w_wait getter: num(${this.mc_args}['wait']) or 0
Request.mc_w_cls getter: (words(replace(replace(this.mc_w_id, 'membrane::', ''), ':', ' ')) or [''])[0]
Request.mc_w_effect getter: (this.mc_w_cls + '.' + this.mc_w_prop) in ['File.write', 'File.move', 'File.delete', 'Command.run', 'Command.stop', 'Store.run', 'Fetch.request', 'SqlQuery.run']
Request.mc_w_rprop getter: this.mc_w_prop + '_result'
Request.mc_w_rec getter: ${this.mc_w_id}[this.mc_w_rprop] if this.mc_done == True and this.mc_w_effect else None
-- the receipt of THIS write: what is there now, unless it is what was there before the write
Request.mc_w_new getter: this.mc_w_rec if this.mc_w_rec != None and this.mc_w_rec != this.mc_w_old else None
Request.mc_w_ready getter:
  WHEN this.mc_done != True or this.reactions == None: False
  ELSE WHEN this.mc_w_cls == 'Memory' and ${this.mc_w_id}['in_flight'] == True: False
  ELSE WHEN not this.mc_w_effect: True
  ELSE WHEN this.mc_w_new != None: True
  ELSE WHEN this.mc_w_wait <= 0: True
  ELSE: clock - this.mc_w_t0 >= this.mc_w_wait
Request.mc_w_n getter: replace(this.eid, 'Request:', '')
Request.mc_w_ready on-setter mcp-return:
  WHEN this.mc_w_ready == True:
    Return:call[this.mc_w_n] = Return(tool: 'entity_write', target: this.mc_w_id, written: this.mc_w_prop, result_prop: this.mc_w_rprop if this.mc_w_effect else None, reactions: this.reactions)
    this.mc_w_returned = Return:call[this.mc_w_n]
Return.kind getter: 'return'
Return.receipt getter: ${this.target}[this.result_prop] if this.result_prop != None else None
Return.state getter: 'pending' if this.result_prop != None and this.receipt == None else 'done'
-- THE RETURN ENTITY IS TRANSIENT (operator, 2026-11-13): it carries the reply and is never retired by a write: the Request HOLDS it (`mc_w_returned` is a reference to it, a
-- `$ref` value), and a Request is held by its open connection until the reply is delivered, so both are collected together (docs/cliffvm.md, "Garbage collection"). The
-- receipt stays where it always lived, `<prop>_result` on the target.
Request.mc_w_head getter: ('removed ' + this.mc_w_id) if this.mc_w_kill else ('wrote ' + this.mc_w_id + '.' + this.mc_w_prop)
-- THE REPLY CARRIES EACH STREAM WHOLE (operator, 2026-11-24): the cap on a tool result for the Claude CLI moved to graphlink-claude (`graphlink-claude/src/cap.rs`), which hands the CLI the first and the last 8192
-- characters of a result over twice that; the door answers in full. The receipt line keeps the total size in bytes (`stdout_bytes`, `stderr_bytes`).
Request.mc_w_so getter: str(${this.mc_w_new}['stdout'] or '')
Request.mc_w_se getter: str(${this.mc_w_new}['stderr'] or '')
Request.mc_w_sob getter: ${this.mc_w_new}['stdout_bytes'] or 0
Request.mc_w_seb getter: ${this.mc_w_new}['stderr_bytes'] or 0
Request.mc_w_pout getter: {'stdout': this.mc_w_so} if this.mc_w_sob != 0 else None
Request.mc_w_perr getter: {'stderr': this.mc_w_se} if this.mc_w_seb != 0 else None
Request.mc_w_rcpt getter:
  WHEN not this.mc_w_effect: []
  ELSE WHEN this.mc_w_new != None: concat(concat(concat(concat(['receipt: ' + str({'id': ${this.mc_w_new}['id'], 'status': ${this.mc_w_new}['status'], 'rc': ${this.mc_w_new}['rc'], 'ok': ${this.mc_w_new}['status'] == 'ok', 'started': ${this.mc_w_new}['started'], 'finished': ${this.mc_w_new}['finished'], 'ms': ${this.mc_w_new}['ms'], 'timeout_s': ${this.mc_w_new}['timeout_s'], 'killed': ${this.mc_w_new}['killed'], 'stdout_bytes': ${this.mc_w_new}['stdout_bytes'], 'stderr_bytes': ${this.mc_w_new}['stderr_bytes']})], ['stdout: ' + str(x) for x in [this.mc_w_pout] if x != None]), ['stderr: ' + str(x) for x in [this.mc_w_perr] if x != None]), ['error: ' + str(${this.mc_w_new}['head']) for x in [this.mc_w_new] if ${x}['status'] == 'error' and ${x}['stdout_bytes'] == None]), ['timeout: ' + str(this.mc_w_id) + ' timed out after ' + str(${x}['timeout_s']) + ' s (killed); start it again with a bigger timeout_s, e.g. run = {id, cmd, timeout_s: 600}; the partial output is above and in ' + str(this.mc_w_id) + '.partial_output' for x in [this.mc_w_new] if ${x}['status'] == 'timeout'])
  ELSE: ['pending: id: ' + str(${${this.mc_args}['value']}['id']) + ', status: running, started: ' + str(${${this.mc_w_id}['running']}['started'] or this.mc_w_t0) + ', timeout_s: ' + str(${${this.mc_w_id}['running']}['timeout_s'] or ${this.mc_w_id}['timeout_default']) + ', left: ' + str((${${this.mc_w_id}['running']}['timeout_s'] or ${this.mc_w_id}['timeout_default']) + ${${this.mc_w_id}['running']}['started'] - this.mc_w_t0) + ' s; read ' + this.mc_w_id + '.' + this.mc_w_rprop + ' later']
-- THE SIZE OF THE REACTIONS (design B2 of docs/reply-size.md, operator 2026-11-14): the model-facing reply lists IN FULL the reactions on the WRITTEN entity (the write's target)
-- and its direct children (`<eid>:...`; for run_cliff the ones set by the block's own setter `run`), and every reaction that carries a reason (a null with `why`, an Error: its
-- `failed` map), whatever the entity; every other reaction is one count per `<Class>.<prop>` (`cls` is the host's exact class field, no values). `reactions` itself is unchanged.
-- A PACK THE MODEL WROTE SAYS WHETHER IT LOADED (the delivery-route incident, 2026-11-14): the host adds the reaction `Pack:<name>.loaded` (new: loaded or not, why: the engine's error text,
-- verbatim) for each pack text written in the round; the reply words it on its first lines, after the head, and it is not repeated in the `reactions:` list.
Request.rx_pack getter: [r for r in (this.reactions or []) if ${r}['prop'] == 'loaded' and startswith(str(${r}['eid']), 'Pack:')]
Request.rx_unloaded getter: [('pack ' + replace(str(${r}['eid']), 'Pack:', '') + ' unloaded') for r in (this.reactions or []) if ${r}['prop'] == 'unloaded' and startswith(str(${r}['eid']), 'Pack:')]
Request.rx_pack_lines getter: concat(this.rx_unloaded, concat([('pack ' + replace(str(${r}['eid']), 'Pack:', '') + ' loaded') for r in this.rx_pack if ${r}['new'] == True], concat([('pack ' + replace(str(${r}['eid']), 'Pack:', '') + ' did not load: ' + str(${r}['why'] or 'it waits for something it imports') + '\n' + ('to fix: a layer overrides only what it imports, so IMPORT the pack the error names (the text above says how); ' if 'IMPORT' in str(${r}['why']) else '') + 'read ' + str(${r}['eid']) + '.loaded and ' + str(${r}['eid']) + '.error to check; the old text of this pack, if it had loaded before, still runs') for r in this.rx_pack if ${r}['new'] != True], [])))
Request.rx_marked getter: [{'r': r, 'full': (this.mc_tool == 'entity_write' and (${r}['eid'] == this.mc_w_id or startswith(str(${r}['eid']), this.mc_w_id + ':'))) or (this.mc_tool == 'run_cliff' and ${r}['by'] == 'run') or ${r}['why'] != None or ${r}['prop'] == 'failed'} for r in (this.reactions or []) if not (${r}['prop'] == 'loaded' and startswith(str(${r}['eid']), 'Pack:'))]
Request.rx_full getter: [m['r'] for m in this.rx_marked if m['full']]
Request.rx_rest getter: [{'k': str(${m['r']}['cls']) + '.' + str(${m['r']}['prop'])} for m in this.rx_marked if not m['full']]
Request.rx_groups getter: [str(g['key']) + ' x' + str(len(g['rows'])) for g in group_by(this.rx_rest, 'k')]
-- A MEMORYNOTE WRITE answers with what the note reminds of (`Memory.associations`, mentions.c1f), not with the reactions of the round (the spans of its words): only a reaction with a reason stays.
-- The reply waits while the note's own embedding call is out (`in_flight`, mentions.c1f: the call's own 10 s limit bounds it), so the cosine lane is in the answer.
Request.rx_why getter: [m['r'] for m in this.rx_marked if ${m['r']}['why'] != None or ${m['r']}['prop'] == 'failed']
Request.rx_lines getter:
  WHEN this.mc_tool == 'entity_write' and this.mc_w_cls == 'Memory': concat([a for a in [${this.mc_w_id}['associations']] if a != None], ['reactions: ' + str(this.rx_why) for x in [1] if len(this.rx_why) > 0])
  ELSE: concat(['reactions: ' + str(this.rx_full)], ['other changes: ' + join(this.rx_groups, ', ') for x in [1] if len(this.rx_groups) > 0])
Request.mc_w_text getter:
  WHEN this.mc_write == None: None
  ELSE WHEN this.mc_done != True: None
  ELSE WHEN this.refused != None: 'refused: ' + str(this.refused)
  ELSE WHEN this.mc_w_returned == None: None
  ELSE: join(concat(concat(concat([this.mc_w_head], this.rx_pack_lines), this.mc_w_rcpt), this.rx_lines), '\n')

-- ---- run_cliff: a clifflet, one call (docs/cliffvm.md, "run_cliff") ------------------------------------------------------------------------------
-- The block is loaded as two scratch packs at once, `cliffg<n>` (the block as a getter: a value) and `cliffs<n>` (the block as an on-setter body: writes; privileged,
-- so it may write any class like entity_write does), each with its own class. Whichever loads runs: a block that is a value runs as the getter (its entity is
-- born by a write), one whose last line is a write runs as the setter (`go`), and one that loads as neither answers with both loader errors. The answer is read
-- from the scratch entity, then the packs and the entity are retired: nothing accumulates. The getter runs under the engine's step budget
-- (docs/c1f-stdlib.md; time limits nothing): a runaway block answers with that reason and the seat stays up. A write's reactions come from the host like entity_write's.
Request.cl_code getter: str(${this.mc_args}['code'] or '')
Request.cl_bad getter: 'run_cliff needs code (a block of lines; the last one is the value)' if this.mc_tool == 'run_cliff' and strip(this.cl_code) == '' else None
Request.cl_on getter: this.mc_tool == 'run_cliff' and this.cl_bad == None and not this.mc_anon
Request.cl_n getter: replace(this.eid, 'Request:', '')
Request.cl_gp getter: 'Pack:cliffg' + this.cl_n
Request.cl_sp getter: 'Pack:cliffs' + this.cl_n
Request.cl_ge getter: 'Cliffg' + this.cl_n + ':x'
Request.cl_se getter: 'Cliffs' + this.cl_n + ':x'
Request.cl_gtext getter: 'PACK cliffg' + this.cl_n + ' 1\nCliffg' + this.cl_n + '.val getter:\n' + join(['  ' + l for l in lines(this.cl_code)], '\n') + '\nCliffg' + this.cl_n + '.shown getter: {\'v\': this.val, \'why\': why(this.val), \'failed\': this.val is Error}\n'
Request.cl_stext getter: 'PACK cliffs' + this.cl_n + ' 1\nIMPORT door 1\nIMPORT fs 1\nIMPORT proc 1\nIMPORT fetch 1\nIMPORT store 1\nCliffs' + this.cl_n + '.go on-setter run:\n  ALWAYS:\n' + join(['    ' + l for l in lines(this.cl_code)], '\n') + '\n'
Request.cl_start getter: this.cl_code if this.cl_on else None
Request.cl_start on-setter cliff-load:
  WHEN this.cl_start != None:
    (this.cl_gp).scratch = True
    (this.cl_sp).scratch = True
    (this.cl_sp).privileged = True
    (this.cl_gp).text = this.cl_gtext
    (this.cl_sp).text = this.cl_stext
    this.cl_loading = True
Request.cl_gstate getter: ${this.cl_gp}['state'] if this.cl_loading == True else None
Request.cl_sstate getter: ${this.cl_sp}['state'] if this.cl_loading == True else None
Request.cl_mode getter:
  WHEN this.cl_gstate == 'loaded': 'value'
  ELSE WHEN this.cl_gstate == 'error' and this.cl_sstate == 'loaded': 'write'
  ELSE WHEN this.cl_gstate == 'error' and this.cl_sstate == 'error': 'error'
  ELSE: None
Request.cl_mode on-setter cliff-run:
  WHEN this.cl_mode == 'value':
    (this.cl_ge).seed = True
  ELSE WHEN this.cl_mode == 'write':
    (this.cl_se).births_to = this.births_to
    (this.cl_se).go = True
    this.mc_done = True
Request.cl_shown getter: ${this.cl_ge}['shown'] if this.cl_mode == 'value' else None
Request.cl_out getter:
  WHEN this.cl_final != None: this.cl_final
  ELSE WHEN this.cl_mode == 'error': {'text': 'the block did not load.\nas a value: ' + str(${this.cl_gp}['error']) + '\nas writes: ' + str(${this.cl_sp}['error']), 'err': True}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None and ${this.cl_shown}['failed'] == True: {'text': 'Error: ' + str(${this.cl_shown}['why']), 'err': True}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None and ${this.cl_shown}['why'] != None: {'text': 'null: ' + str(${this.cl_shown}['why']), 'err': False}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None and ${this.cl_shown}['v'] == None: {'text': 'null', 'err': False}
  ELSE WHEN this.cl_mode == 'value' and this.cl_shown != None: {'text': str(${this.cl_shown}['v']), 'err': False}
  ELSE WHEN this.cl_mode == 'write' and this.reactions != None: {'text': join(concat(['ran the writes of the block'], concat(this.rx_pack_lines, this.rx_lines)), '\n') + '\nan effect it started has its receipt in a later round: read <entity>.<verb>_result', 'err': False}
  ELSE: None
Request.cl_out on-setter cliff-finish:
  WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'error':
    this.cl_final = this.cl_out
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True
  ELSE WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'value':
    this.cl_final = this.cl_out
    (this.cl_ge).retire = True
    (this.cl_gp).text = ''
    (this.cl_sp).text = ''
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True
  ELSE WHEN this.cl_out != None and this.cl_final == None and this.cl_mode == 'write':
    this.cl_final = this.cl_out
    (this.cl_se).retire = True
    (this.cl_gp).text = ''
    (this.cl_sp).text = ''
    (this.cl_gp).retire = True
    (this.cl_sp).retire = True

-- ---- THE CLIFFLET RUNNER FOR PEERS (#1143, operator 2026-11-19; docs/graph-link.md, "The clifflet runner"): the same scratch packs as `run_cliff` above, started by a peer's write instead of a door call -----
-- A granted peer writes `membrane::Cliff:<ns>:<id>` property `code` (a clifflet text, `run_cliff`'s own semantics: a value, or a block whose last line is a write); the seat loads the two scratch packs, runs
-- whichever loads, and writes back on the SAME node `result` (the value; `null` is the text `null`; a block of writes says it ran them) or `error` (text: the block did not load, or the value is an Error). The packs
-- and the scratch entity are retired as `run_cliff`'s are; the node stays until the peer retires it. ONE RUN PER NODE: another run is another node. It runs ONLY for a node whose `<ns>` is a peer whose link is up
-- (`Vm:<ns>`, kind peer): a setter does not see the writer of a write, so the peer's namespace in the key is the gate; the write itself was accepted by the link's policy (packs/link.c1f: a grant or a rule that
-- reaches `Cliff:`), and a person with the door's token can write the node too (the door's `run_cliff` is theirs already). The id is letters and digits only (it names the scratch packs).
Cliff.kind getter: 'cliff'
Cliff.tail getter: after(this.eid, 'Cliff:')
Cliff.ns getter: before(this.tail, ':')
Cliff.cid getter: after(this.tail, ':')
Cliff.slug getter: replace(replace(replace(replace(this.tail, ':', 'x'), '-', ''), '_', ''), '.', '')
Cliff.id_bad getter: replace(replace(replace(replace(this.cid, ':', ''), '-', ''), '_', ''), '.', '') != this.cid
Cliff.from_peer getter: ${'Vm:' + this.ns}['kind'] == 'peer' and ${'Vm:' + this.ns}['link'] == 'up'
Cliff.gp getter: 'Pack:cliffpg' + this.slug
Cliff.sp getter: 'Pack:cliffps' + this.slug
Cliff.ge getter: 'Cliffpg' + this.slug + ':x'
Cliff.se getter: 'Cliffps' + this.slug + ':x'
Cliff.gtext getter: 'PACK cliffpg' + this.slug + ' 1\nCliffpg' + this.slug + '.val getter:\n' + join(['  ' + l for l in lines(str(this.code))], '\n') + '\nCliffpg' + this.slug + '.shown getter: {\'v\': this.val, \'why\': why(this.val), \'failed\': this.val is Error}\n'
Cliff.stext getter: 'PACK cliffps' + this.slug + ' 1\nIMPORT door 1\nIMPORT fs 1\nIMPORT proc 1\nIMPORT fetch 1\nIMPORT store 1\nCliffps' + this.slug + '.go on-setter run:\n  ALWAYS:\n' + join(['    ' + l for l in lines(str(this.code))], '\n') + '\n'
-- A REFUSED NODE ANSWERS (a peer must never wait on a silence): a node with `code` that cannot run says why in `error` and is finished; no pack is made.
Cliff.refusal getter:
  WHEN this.code == None or this.finished == True: None
  ELSE WHEN strip(str(this.code)) == '': 'refused: the code is empty'
  ELSE WHEN this.id_bad: 'refused: the id may hold letters and digits only (' + this.cid + ')'
  ELSE WHEN not this.from_peer: 'refused: ' + this.ns + ' is not a connected peer (its link is not up)'
  ELSE: None
Cliff.refusal on-setter cliff-peer-refuse:
  WHEN this.refusal != None:
    this.finished = True
    this.error = this.refusal
Cliff.start getter: this.code if (this.code != None and strip(str(this.code)) != '' and this.from_peer and not this.id_bad and this.finished != True) else None
Cliff.start on-setter cliff-peer-load:
  WHEN this.start != None:
    (this.gp).scratch = True
    (this.sp).scratch = True
    (this.sp).privileged = True
    (this.gp).text = this.gtext
    (this.sp).text = this.stext
    this.loading = True
Cliff.gstate getter: ${this.gp}['state'] if this.loading == True else None
Cliff.sstate getter: ${this.sp}['state'] if this.loading == True else None
Cliff.mode getter:
  WHEN this.gstate == 'loaded': 'value'
  ELSE WHEN this.gstate == 'error' and this.sstate == 'loaded': 'write'
  ELSE WHEN this.gstate == 'error' and this.sstate == 'error': 'error'
  ELSE: None
Cliff.mode on-setter cliff-peer-run:
  WHEN this.mode == 'value':
    (this.ge).seed = True
  ELSE WHEN this.mode == 'write':
    (this.se).go = True
Cliff.shown getter: ${this.ge}['shown'] if this.mode == 'value' else None
Cliff.said getter:
  WHEN this.mode == 'error': {'error': 'the block did not load.\nas a value: ' + str(${this.gp}['error']) + '\nas writes: ' + str(${this.sp}['error'])}
  ELSE WHEN this.mode == 'value' and this.shown != None and ${this.shown}['failed'] == True: {'error': 'Error: ' + str(${this.shown}['why'])}
  ELSE WHEN this.mode == 'value' and this.shown != None and ${this.shown}['v'] == None: {'result': 'null'}
  ELSE WHEN this.mode == 'value' and this.shown != None: {'result': ${this.shown}['v']}
  ELSE WHEN this.mode == 'write' and ${this.se}['go'] == True: {'result': 'ran the writes of the block'}
  ELSE: None
Cliff.said on-setter cliff-peer-finish:
  WHEN this.said != None and this.finished != True:
    this.finished = True
    this.result = ${this.said}['result']
    this.error = ${this.said}['error']
    (this.ge).retire = True
    (this.se).retire = True
    (this.gp).text = ''
    (this.sp).text = ''
    (this.gp).retire = True
    (this.sp).retire = True

-- ---- entity_read: the store's row (stored properties, a failed property shown as `Error: <reason>` through the entity's `failed`) or one property through the field ---------------------------------------------------
Request.mc_r_spec getter: strip(str(${this.mc_args}['spec'] or ''))
Request.mc_r_id getter: str(${this.mc_r_spec}['eid']) if ${this.mc_r_spec}['eid'] != None else this.mc_r_spec
Request.mc_r_bad getter: 'entity_read needs spec (the entity\'s id)' if this.mc_r_spec == '' else None
Request.mc_r_meta getter: meta(this.mc_r_id) if this.mc_tool == 'entity_read' and this.mc_r_bad == None else None
-- A WHOLE READ PRINTS NO VALUES (operator, 2026-11-24): `entity_read` is `meta(spec)` printed: class, parents, property names, getter names, setter names. A chat message's views hold its tool results several times over, and a model that reads a message for its text must not receive them; a value is read with run_cliff, `<entity>[name]`.
Request.mc_r_text getter:
  WHEN this.mc_tool != 'entity_read' or this.mc_r_bad != None: None
  ELSE WHEN this.mc_r_meta == None and (why(this.mc_r_meta) is Absent): 'no such entity: ' + this.mc_r_spec
  ELSE WHEN this.mc_r_meta == None: None
  ELSE: this.mc_r_id + ' ' + str(this.mc_r_meta)

-- ---- entity_query: the store's rows by kind and eid prefix (a kind is the entity's own class or one of its `parents`, `cls:<kind>`) -----------------------------------------------------------------------------------
Request.mc_q_terms getter: words(replace(str(${this.mc_args}['q'] or ''), '&', ' '))
Request.mc_q_kinds getter: [after(t, 'kind:') for t in this.mc_q_terms if startswith(t, 'kind:')]
Request.mc_q_names getter: [after(t, 'name~:') for t in this.mc_q_terms if startswith(t, 'name~:')]
Request.mc_q_nots getter: [after(t, 'kind!:') for t in this.mc_q_terms if startswith(t, 'kind!:')]
Request.mc_q_other getter: [t for t in this.mc_q_terms if not startswith(t, 'kind:') and not startswith(t, 'kind!:') and not startswith(t, 'name~:')]
Request.mc_q_kind getter: ([x for x in this.mc_q_kinds if x != '*'] or [''])[0]
Request.mc_q_name getter: (this.mc_q_names or [''])[0]
Request.mc_q_not getter: (this.mc_q_nots or [''])[0]
Request.mc_q_off getter: max(num(${this.mc_args}['offset']) or 0, 0)
Request.mc_q_k getter: min(max(num(${this.mc_args}['k']) or 20, 1), 100)
Request.mc_q_bad getter: 'entity_query: unsupported term ' + this.mc_q_other[0] + ' (kind:<Class>, kind!:<Class> and name~:<eid prefix>, joined with &)' if len(this.mc_q_other) > 0 else None
Request.mc_q_on getter: this.mc_tool == 'entity_query' and this.mc_q_bad == None
Request.mc_q_rows getter: sql('SELECT k, json_extract(body, \'$.cls\') AS cls FROM c_field WHERE (? = \'\' OR json_extract(body, \'$.cls\') = ? OR EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?))) AND (? = \'\' OR (json_extract(body, \'$.cls\') != ? AND NOT EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?)))) AND substr(k, 1, length(?)) = ? ORDER BY k LIMIT ? OFFSET ?', this.mc_q_kind, this.mc_q_kind, this.mc_q_kind, this.mc_q_not, this.mc_q_not, this.mc_q_not, this.mc_q_name, this.mc_q_name, this.mc_q_k, this.mc_q_off) if this.mc_q_on and ${this.mc_args}['count'] != True else None
Request.mc_q_count getter: sql('SELECT count(*) AS n FROM c_field WHERE (? = \'\' OR json_extract(body, \'$.cls\') = ? OR EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?))) AND (? = \'\' OR (json_extract(body, \'$.cls\') != ? AND NOT EXISTS (SELECT 1 FROM json_each(body, \'$.props.parents\') WHERE lower(value) = \'cls:\' || lower(?)))) AND substr(k, 1, length(?)) = ?', this.mc_q_kind, this.mc_q_kind, this.mc_q_kind, this.mc_q_not, this.mc_q_not, this.mc_q_not, this.mc_q_name, this.mc_q_name) if this.mc_q_on and ${this.mc_args}['count'] == True else None
Request.mc_q_text getter:
  WHEN not this.mc_q_on: None
  ELSE WHEN ${this.mc_args}['count'] == True: (str(${this.mc_q_count[0]}['n']) + ' entity(ies)') if this.mc_q_count != None and len(this.mc_q_count) > 0 else None
  ELSE WHEN this.mc_q_rows == None: None
  ELSE WHEN len(this.mc_q_rows) == 0: '0 entity(ies)'
  ELSE: join([${r}['k'] + ' (' + str(${r}['cls']) + ')' for r in this.mc_q_rows], '\n')

-- ---- the tool call's result ---------------------------------------------------------------------------------------------------------------------
Request.mc_bad getter: (this.mc_w_bad if this.mc_tool == 'entity_write' else (this.mc_r_bad if this.mc_tool == 'entity_read' else (this.cl_bad if this.mc_tool == 'run_cliff' else this.mc_q_bad)))
Request.mc_text getter:
  WHEN not this.mc_known: 'unknown tool: ' + str(this.mc_tool)
  ELSE WHEN this.mc_bad != None: this.mc_bad
  ELSE WHEN this.mc_tool == 'entity_write': this.mc_w_text
  ELSE WHEN this.mc_tool == 'entity_read': this.mc_r_text
  ELSE WHEN this.mc_tool == 'run_cliff': ${this.cl_out}['text']
  ELSE: this.mc_q_text
Request.mc_is_err getter: (not this.mc_known) or this.mc_bad != None or startswith(str(this.mc_text or ''), 'refused') or (this.mc_tool == 'run_cliff' and ${this.cl_out}['err'] == True)
Request.mc_call getter: {'content': [{'type': 'text', 'text': this.mc_text}], 'isError': this.mc_is_err} if this.mc_text != None else None

-- ---- the answers ----------------------------------------------------------------------------------------------------------------------------------
Request.mc_init getter: {'protocolVersion': ${this.mc_params}['protocolVersion'] or '2025-03-26', 'capabilities': {'tools': {'listChanged': False}}, 'serverInfo': {'name': 'membrane', 'version': str(${this.facts}['seat_version'] or '')}}
Request.mc_result getter:
  WHEN this.mc_method == 'initialize': this.mc_init
  ELSE WHEN this.mc_method == 'ping': {}
  ELSE WHEN this.mc_method == 'tools/list': {'tools': this.mc_tools}
  ELSE WHEN this.mc_method == 'tools/call': this.mc_call
  ELSE: None
Request.mc_known_method getter: this.mc_method in ['initialize', 'ping', 'tools/list', 'tools/call']
Request.r_tools getter:
  WHEN this.mc_rpc == None: {'status': 400, 'body': {'jsonrpc': '2.0', 'id': None, 'error': {'code': -32700, 'message': 'parse error'}}}
  ELSE WHEN not this.mc_ok: {'status': 400, 'body': {'jsonrpc': '2.0', 'id': None, 'error': {'code': -32600, 'message': 'invalid request'}}}
  ELSE WHEN this.mc_id == None: {'status': 202}
  ELSE WHEN not this.mc_known_method: {'status': 200, 'body': {'jsonrpc': '2.0', 'id': this.mc_id, 'error': {'code': -32601, 'message': 'method not found: ' + this.mc_method}}}
  ELSE WHEN this.mc_result == None: None
  ELSE: {'status': 200, 'body': {'jsonrpc': '2.0', 'id': this.mc_id, 'result': this.mc_result}}
