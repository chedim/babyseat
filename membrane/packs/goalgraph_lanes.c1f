PACK goalgraph_lanes 1
IMPORT boot 1
IMPORT chat 1
IMPORT goalgraph 1
-- THE LANES OF THE GOAL GRAPH (#738, #773): goalgraph.c1f asks for a planner pass (Goal.plan_calls, with the prompt in plan_prompt) and a worker step
-- (Task.started_ts, with the prompt in worker_prompt). The `membrane::llm.call` effect is the browser engine's; this seat refuses it, so a lane here is a
-- message in the chat `gg`, as goalgraph_chat.c1f posts to `main`: the model's turn answers it, with the seat's tools, and its answer text is the lane's
-- reply (planner_reply, worker_reply), which goalgraph.c1f already reads (the FULFILLED claim, the DONE / FAILED / STUCK / SPLIT verdict).
-- A lane message is made once per call: its id is on the goal (plan_msg) or the task (worker_msg). The answer is collected on the pool's pump (a getter
-- over a response that did not exist yet is not read again when it arrives), and the id is cleared once it is collected: the pump then looks for a response only for the lanes still waiting.
Goal.plan_calls on-setter lane-planner:
  WHEN this.plan_prompt != None:
    id = words(replace(str(clock * 1000000), '.', ' '))[0] + '-' + tail('00000000' + str(this.plan_calls), 8)
    this.plan_msg = id
    membrane::Chat:gg = Chat(name: 'gg')
    membrane::Chat:gg:message[id] = ChatMessage(text: this.plan_prompt, at: clock)
    membrane::Chat:gg:message[id]:body = SemText(text: this.plan_prompt)
    membrane::Chat:gg:message[id]:turn = ChatTurn(message: 'membrane::Chat:gg:message:' + id, queued_at: clock)
    membrane::Chat:gg:time[id]:main = ChatLine(chat: 'gg')
    membrane::Chat:gg:message[id].queued = True

Task.started_ts on-setter lane-worker:
  WHEN this.worker_prompt != None and this.status == 'running':
    id = words(replace(str(clock * 1000000), '.', ' '))[0] + '-' + tail('00000000' + str((this.runs or 0) + 1 + (this.continues or 0) * 100), 8)
    this.worker_msg = id
    membrane::Chat:gg = Chat(name: 'gg')
    membrane::Chat:gg:message[id] = ChatMessage(text: this.worker_prompt, at: clock)
    membrane::Chat:gg:message[id]:body = SemText(text: this.worker_prompt)
    membrane::Chat:gg:message[id]:turn = ChatTurn(message: 'membrane::Chat:gg:message:' + id, queued_at: clock)
    membrane::Chat:gg:time[id]:main = ChatLine(chat: 'gg')
    membrane::Chat:gg:message[id].queued = True

-- the pump of the pool is the beat: every beat, a lane's answer that has landed is handed on (a reply already handed on is the same value: nothing runs)
Pool.pump on-setter lane-collect:
  ALWAYS:
    FOR t IN [t for t in instances('Task') if t.status == 'running' and t.worker_msg != None and prop('membrane::Chat:gg:message:' + t.worker_msg + ':turn:response', 'text') != None]:
      t.worker_reply = prop('membrane::Chat:gg:message:' + t.worker_msg + ':turn:response', 'text')
      t.worker_msg = None
    FOR g IN [g for g in instances('Goal') if g.plan_msg != None and prop('membrane::Chat:gg:message:' + g.plan_msg + ':turn:response', 'text') != None]:
      g.planner_reply = prop('membrane::Chat:gg:message:' + g.plan_msg + ':turn:response', 'text')
      g.plan_msg = None

-- boot: a task that was running or owed when the seat stopped lost its lane with the turn; it goes back to the pool
Boot.started on-setter reowe-at-boot:
  WHEN this.started != None:
    FOR t IN [t for t in instances('Task') if t.status == 'running' or t.status == 'owed']:
      t.reowe = this.started
