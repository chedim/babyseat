PACK banner_lines 1
IMPORT boot 1
-- THE BANNER OF THE BAREST SEAT (#1143): a banner made of LINES. The banner is the entity `membrane::Banner:owner:main`; chat_turn.c1f reads
-- its `text` into every turn's system text. The text is the `text` of every `BannerLine` entity, in `order` (a number, default 0), then by
-- eid, joined with newlines. A line whose `text` is missing or empty adds nothing. The model grows its banner by writing `BannerLine:<name>`
-- entities (`order`, `text`), shows live state by loading a pack with a getter on `BannerLine.live`, and removes a line with `retire = true`.
-- Help:banner (help/banner.md) teaches this with examples; BannerLine:howto is the first line.
-- Seeding: `Banner:owner:main` is born with `seeded` and the first line at start. (The engine restores only Pack rows at start, not other
-- entities: docs/cliffvm.md, "What fields_live.py does that the Rust loop does NOT yet do"; the seed runs again until that lands.)

BannerLine.order_key getter: num(this.order) or 0
-- `live` is where a pack's getter gives a line its text (a getter named `text` would stand over the stored `text` of every line, so a live line
-- has its own name); a line shows its `live` when it has one, else its stored `text`.
BannerLine.shown getter: strip(str(this.live or this.text or ''))
Banner.rows getter: [{'eid': l.eid, 'order': l.order_key, 'text': l.shown} for l in instances('BannerLine') if l.shown != '']
Banner.sorted getter: sort_by(sort_by(this.rows, 'eid'), 'order')
Banner.text getter: join([prop(r, 'text') for r in this.sorted], '\n')

Boot.banner_howto getter: join(['BANNER: this is your tool for continuity between your turns. It is the one block that reaches you at the start of every turn, so keep in it what the next turn needs (what you are doing, what is open, what you decided).', 'It is made of lines. Each line is an entity `BannerLine:<name>` with two properties: `text` (what the line says) and `order` (a number; lines show from the lowest order up, and lines of the same order show by name).', 'To add or replace a line: entity_write {spec: "BannerLine:plan", prop: "text", value: "working on the import; next: check the totals"}, then entity_write {spec: "BannerLine:plan", prop: "order", value: 10}.', 'To remove a line: entity_write {spec: "BannerLine:plan", prop: "retire", value: true}. A line whose text is empty shows nothing.', 'To make a line live, give it a `live` getter in a pack: the line then shows the current state of whatever it reads, every turn. Read Help:banner (entity_read) for examples. This line is BannerLine:howto: replace or retire it when your own lines say what you need.'], '\n')

Boot.started on-setter seed-banner:
  WHEN prop('membrane::Banner:owner:main', 'seeded') != True:
    membrane::Banner:owner:main = Banner(chat: 'main', owner: 'owner', seeded: True)
    BannerLine:howto = BannerLine(order: -1000, text: this.banner_howto)
