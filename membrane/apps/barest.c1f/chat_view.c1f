PACK chat_view 1
IMPORT dom 1
IMPORT fetch 1
IMPORT shell_view 1
IMPORT markdown 1
-- THE BARE CHAT AS A VIEW PACK (#1143, the first vertical slice of the UI rebuild: docs/ui-rebuild-plan.md section (c)).
-- It runs in the PAGE's field engine (it imports `dom`; the seat sends it with `GET /ui/fieldvm`, door_fieldvm.c1f, and does not run it) and draws the
-- chat: the turns (who, the message, the answer in markdown or its pending line, the tools folded under it), a textarea with Send and Stop, "Load older turns".
-- The page's boot (ui/boot.js) births ONE entity, `View:chat` {open: true}; nothing here runs before that.
--   View:chat       the view: the settings (the legacy constants, below), the polls, the cursor of the older turns
--   Composer:chat   {draft, sending, error}: the text in the box, one POST at a time (the double-submit guard), the note of a failed send
--   ChatRow:<id>    one turn: `raw` is the history route's row (the page's `GET /membrane/chat/messages`), everything shown is a getter of it
--   Fetch:history / Fetch:send / Fetch:older   the three calls (the page's Fetch, fieldvm.js W2): the request is the effect, the receipt `request_result` comes back
-- THE SHELL (fieldvm.js) gives this pack: a `scroll` write on a DomNode, `before` (an ordered child), `composing` on the key event, `Conn:page.hidden` and the clock
-- (`run_clock`, started by the page's boot). A FOR has no index.

-- THE VIEW'S CONSTANTS are Boot facts (the page's Boot:seat is fed by the snapshot, door_fieldvm.c1f); the view reads them once, when it opens, each
-- with its own default when no fact says otherwise (chat_page_size 20, chat_poll_size 10, chat_list_poll_ms 3000,
-- chat_active_poll_ms 700, chat_stick_px 80, chat_tool_chars 0: no cut).
-- THE SHELL (shell_view.c1f) plugs this view in: it registers `Nav:chat` when the shell opens, the view opens when `Nav:chat` becomes active and draws into the slot
-- `DomNode:shell:slot:chat`. There is ONE chat: it reads `GET /membrane/chat/messages` with no `sid` (every turn, newest page first, `before` pages older ones: the seat's imported history is the
-- older part of the same thread) and sends `POST /membrane/chat/message {text}`.
Shell.open on-setter chat-register:
  WHEN this.open:
    ('Nav:chat').title = 'Chat'
    ('Nav:chat').order = 10
Nav.active on-setter chat-activate:
  WHEN this.eid == 'Nav:chat' and this.active == True and not ${'View:chat'}['open']:
    ('View:chat').open = True

-- A CALL CANNOT WEDGE THE VIEW: every call carries `timeout_s` (the Boot fact `chat_poll_timeout_s`; 10 s is the value TRIED, not decided). A poll that never answers (a stalled connection, a seat that
-- went away mid-request) used to leave `polling` true for ever, so the turn that finished on the seat stayed "Waiting for a turn…" on the page; now the host aborts it, the receipt is an error, the
-- poll is armed again and the next one reads the message's state. A poll that fails is shown as text on the chat (`Composer`'s note line) and goes away with the next good answer.

-- the clock is ticked by the shell at the fastest poll (the active one): a poll is due when its period has passed since the last one
View.tick getter: clock

-- ---- the view: the skeleton, the first load ----
View.open on-setter chat-draw:
  WHEN this.open:
    ('DomNode:chat:root').tag = 'div'
    ('DomNode:chat:root').class = 'chatview'
    ('DomNode:chat:root').parent = 'DomNode:shell:slot:chat'
    ('DomNode:chat:log').parent = 'DomNode:chat:root'
    ('DomNode:chat:log').tag = 'div'
    ('DomNode:chat:log').class = 'log'
    ('DomNode:chat:log').role = 'log'
    ('DomNode:chat:log').aria-live = 'polite'
    ('DomNode:chat:older').parent = 'DomNode:chat:log'
    ('DomNode:chat:older').tag = 'div'
    ('DomNode:chat:older').class = 'older'
    ('DomNode:chat:older').hidden = True
    ('DomNode:chat:older:btn').parent = 'DomNode:chat:older'
    ('DomNode:chat:older:btn').tag = 'button'
    ('DomNode:chat:older:btn').type = 'button'
    ('DomNode:chat:older:btn').text = 'Load older turns'
    ('DomNode:chat:list').parent = 'DomNode:chat:log'
    ('DomNode:chat:list').tag = 'ol'
    ('DomNode:chat:list').class = 'rows'
    ('DomNode:chat:import').parent = 'DomNode:chat:root'
    ('DomNode:chat:import').tag = 'div'
    ('DomNode:chat:import').class = 'importnote'
    ('DomNode:chat:import').role = 'status'
    ('DomNode:chat:import').hidden = True
    ('DomNode:chat:pollnote').parent = 'DomNode:chat:root'
    ('DomNode:chat:pollnote').tag = 'div'
    ('DomNode:chat:pollnote').class = 'pollnote'
    ('DomNode:chat:pollnote').role = 'status'
    ('DomNode:chat:pollnote').hidden = True
    ('DomNode:chat:note').parent = 'DomNode:chat:root'
    ('DomNode:chat:note').tag = 'div'
    ('DomNode:chat:note').class = 'msg'
    ('DomNode:chat:note').hidden = True
    ('DomNode:chat:note:bubble').parent = 'DomNode:chat:note'
    ('DomNode:chat:note:bubble').tag = 'div'
    ('DomNode:chat:note:bubble').class = 'bubble note'
    ('DomNode:chat:form').parent = 'DomNode:chat:root'
    ('DomNode:chat:form').tag = 'form'
    ('DomNode:chat:form').class = 'composer'
    ('DomNode:chat:input').parent = 'DomNode:chat:form'
    ('DomNode:chat:input').tag = 'textarea'
    ('DomNode:chat:input').rows = 2
    ('DomNode:chat:input').placeholder = 'Tell the seat what you are working on. Enter sends, Shift+Enter adds a line.'
    ('DomNode:chat:input').aria-label = 'Message'
    ('DomNode:chat:send').parent = 'DomNode:chat:form'
    ('DomNode:chat:send').tag = 'button'
    ('DomNode:chat:send').type = 'submit'
    ('DomNode:chat:send').text = 'Send'
    ('DomNode:chat:stop').parent = 'DomNode:chat:form'
    ('DomNode:chat:stop').tag = 'button'
    ('DomNode:chat:stop').type = 'button'
    ('DomNode:chat:stop').class = 'stop'
    ('DomNode:chat:stop').text = 'Stop'
    ('DomNode:chat:stop').title = 'Stop the running turn: the answer so far is kept'
    ('DomNode:chat:stop').aria-label = 'Stop the answer'
    ('DomNode:chat:stop').hidden = True
    ('Composer:chat').draft = ''
    this.page_size = ([b.chat_page_size for b in instances('Boot') if b.chat_page_size != None] or [20])[0]
    this.poll_size = ([b.chat_poll_size for b in instances('Boot') if b.chat_poll_size != None] or [10])[0]
    this.list_ms = ([b.chat_list_poll_ms for b in instances('Boot') if b.chat_list_poll_ms != None] or [3000])[0]
    this.active_ms = ([b.chat_active_poll_ms for b in instances('Boot') if b.chat_active_poll_ms != None] or [700])[0]
    this.stick_px = ([b.chat_stick_px for b in instances('Boot') if b.chat_stick_px != None] or [80])[0]
    this.tool_chars = ([b.chat_tool_chars for b in instances('Boot') if b.chat_tool_chars != None] or [0])[0]
    this.timeout_s = ([b.chat_poll_timeout_s for b in instances('Boot') if b.chat_poll_timeout_s != None] or [10])[0]
    this.tick_ms = this.active_ms
    this.polling = True
    this.seq = 1
    ('Fetch:history').request = {'timeout_s': this.timeout_s, 'id': 'load-1', 'url': '/membrane/chat/messages?limit=' + str(this.page_size)}
    ('Nav:chat').filled = True

-- ---- one turn: everything shown is a getter of the history row ----
ChatRow.rid getter: str(${this.raw}['id'] or '')
ChatRow.state getter: str(${this.raw}['state'] or 'queued')
ChatRow.done getter: this.state == 'done' or this.state == 'error'
ChatRow.ms getter: num(before(this.rid, '-'))
ChatRow.nr getter: num(after(this.rid, '-'))
ChatRow.who getter:
  tn = ${this.raw}['turn']
  t0 = ${tn}['started']
  t1 = ${tn}['ended']
  'queued' if this.state == 'queued' else ('working' if this.state == 'running' else 'seat' + ((' · ' + before(str(max(0, t1 - t0 + 0.5)), '.') + ' s') if t0 != None and t1 != None else ''))
-- a turn that ended in an error after the model had said something (packs/chat.c1f `page_view`: `interrupted` = the error's reason, `kept` = the words): the words are the answer shown,
-- and a small muted mark under them says it was interrupted and why, so an incomplete message is never read as a complete one
ChatRow.cut getter: ${this.raw}['interrupted'] if ${this.raw}['kept'] else None
ChatRow.ans_text getter:
  WHEN this.cut != None: str(${this.raw}['kept'])
  ELSE WHEN ${this.raw}['response']: str(${this.raw}['response'])
  ELSE WHEN not this.done: 'Waiting for a turn…' if this.state == 'queued' else 'Working on it…'
  ELSE: ''
-- the finished tools (a page row carries `tool_calls`, [] while the turn runs: as the legacy chat, that wins) else the names
ChatRow.tool_list getter: ${this.raw}['tool_calls'] if ${this.raw}['tool_calls'] != None else [{'name': x} for x in (${this.raw}['tools'] or [])]
-- a tool's input is shown WHOLE (it wraps); only a seat that sets the fact `chat_tool_chars` (> 0) cuts it to that many characters with an ellipsis (the legacy chat cut at 90, `short(v, n = 90)`; no cut is the default).
-- A tool is keyed by its call id (the history route's `id`; a name-only list has none, so its key is the name and its whole input). `res` is the tool's result when the row carries one (a brain turn's running rows do), else ''.
ChatRow.tool_rows getter:
  tc = ${'View:chat'}['tool_chars'] or 0
  [{'k': str(${x}['id'] or ((${x}['name'] or ${x}['eid'] or '') + '|' + (str(${x}['input']) if ${x}['input'] != None else ''))), 'name': str(${x}['name'] or ${x}['eid'] or ''), 'in': ((' ' + (head(str(${x}['input']), tc - 1) + '…' if tc > 0 and len(str(${x}['input'])) > tc else str(${x}['input']))) if ${x}['input'] != None else ''), 'res': str(${x}['result']) if ${x}['result'] != None else ''} for x in this.tool_list]
-- what the answer bubble holds: the answer is MARKDOWN (markdown.c1f draws it into `ans:md`); the pending line is plain text (`ans:ph`) and is there only while there is no answer
ChatRow.ans_src getter: str(${this.raw}['kept']) if this.cut != None else str(${this.raw}['response'] or '')
ChatRow.ph getter: '' if this.ans_src != '' else this.ans_text
-- a turn the person stopped (the seat ends it with this line, packs/chat_turn.c1f) is a neutral note, not an error
ChatRow.stopped getter: tail(this.ans_src, 23) == '(stopped from the page)'
ChatRow.ans_class getter: ('bubble seat stopped' if this.stopped else ('bubble note' if this.state == 'error' else 'bubble seat')) if ${this.raw}['response'] else 'bubble seat pending'
ChatRow.view getter: {'id': this.rid, 'text': str(${this.raw}['text'] or ''), 'state': this.state, 'who': this.who, 'ans_text': this.ans_text, 'ans_src': this.ans_src, 'ph': this.ph, 'ans_class': this.ans_class, 'ans_hidden': this.ans_text == '', 'by': 'sent by the seat' if ${this.raw}['sent_by'] == 'seat' else '', 'cut': ('interrupted: ' + str(this.cut)) if this.cut != None else '', 'tools_n': len(this.tool_list), 'tools': this.tool_rows, 'running': this.state == 'running', 'live': str(${this.raw}['live'] or '')} if this.raw != None else None

ChatRow.view on-setter chat-draw-row:
  WHEN this.view != None:
    base = 'DomNode:chat:row:' + ${this.view}['id']
    (base).parent = 'DomNode:chat:list'
    (base).tag = 'li'
    (base).class = 'msg'
    (base).data-state = ${this.view}['state']
    (base + ':me').parent = base
    (base + ':me').tag = 'div'
    (base + ':me').class = 'bubble me'
    (base + ':me:md').parent = base + ':me'
    (base + ':me:md').tag = 'div'
    (base + ':me:md').class = 'md'
    ('Md:' + ${this.view}['id'] + ':me').into = base + ':me:md'
    ('Md:' + ${this.view}['id'] + ':me').src = ${this.view}['text']
    -- a message the seat itself sent (the name carry-over, packs/legacy_cutover.c1f: `sent_by` = seat) says so, in the same muted line as the answer's `who`
    (base + ':by').parent = base
    (base + ':by').tag = 'div'
    (base + ':by').class = 'who'
    (base + ':by').hidden = ${this.view}['by'] == ''
    (base + ':by').text = ${this.view}['by']
    (base + ':who').parent = base
    (base + ':who').tag = 'div'
    (base + ':who').class = 'who'
    (base + ':who').text = ${this.view}['who']
    (base + ':ans').parent = base
    (base + ':ans').tag = 'div'
    (base + ':ans').class = ${this.view}['ans_class']
    (base + ':ans').hidden = ${this.view}['ans_hidden']
    (base + ':ans:ph').parent = base + ':ans'
    (base + ':ans:ph').tag = 'span'
    (base + ':ans:ph').class = 'ph'
    (base + ':ans:ph').hidden = ${this.view}['ph'] == ''
    (base + ':ans:ph').text = ${this.view}['ph']
    (base + ':ans:md').parent = base + ':ans'
    (base + ':ans:md').tag = 'div'
    (base + ':ans:md').class = 'md'
    ('Md:' + ${this.view}['id'] + ':ans').into = base + ':ans:md'
    ('Md:' + ${this.view}['id'] + ':ans').src = ${this.view}['ans_src']
    -- WHILE THE TURN RUNS (operator 2026-11-19): what the model is writing now (`live`, a brain turn: the seat reads the brain's `Loop:main.live`) and the tools so far, ALWAYS VISIBLE under the pending line (a `details`
    -- cannot be opened by a pack: `open` is not in the DOM allow-list); each tool with its whole input and, once it has one, its result. A finished turn folds them (below).
    (base + ':think').parent = base
    (base + ':think').tag = 'div'
    (base + ':think').class = 'who think'
    (base + ':think').hidden = not (${this.view}['running'] and ${this.view}['live'] != '')
    (base + ':think').text = ${this.view}['live']
    (base + ':live').parent = base
    (base + ':live').tag = 'ul'
    (base + ':live').class = 'tools-run'
    (base + ':live').hidden = not (${this.view}['running'] and ${this.view}['tools_n'] > 0)
    FOR tl IN ${this.view}['tools']:
      (base + ':live:t:' + ${tl}['k']).parent = base + ':live'
      (base + ':live:t:' + ${tl}['k']).tag = 'li'
      (base + ':live:t:' + ${tl}['k'] + ':name').parent = base + ':live:t:' + ${tl}['k']
      (base + ':live:t:' + ${tl}['k'] + ':name').tag = 'code'
      (base + ':live:t:' + ${tl}['k'] + ':name').class = 'tname'
      (base + ':live:t:' + ${tl}['k'] + ':name').text = ${tl}['name']
      (base + ':live:t:' + ${tl}['k'] + ':in').parent = base + ':live:t:' + ${tl}['k']
      (base + ':live:t:' + ${tl}['k'] + ':in').tag = 'span'
      (base + ':live:t:' + ${tl}['k'] + ':in').class = 'tin'
      (base + ':live:t:' + ${tl}['k'] + ':in').text = ${tl}['in']
      (base + ':live:t:' + ${tl}['k'] + ':res').parent = base + ':live:t:' + ${tl}['k']
      (base + ':live:t:' + ${tl}['k'] + ':res').tag = 'div'
      (base + ':live:t:' + ${tl}['k'] + ':res').class = 'tres'
      (base + ':live:t:' + ${tl}['k'] + ':res').hidden = ${tl}['res'] == ''
      (base + ':live:t:' + ${tl}['k'] + ':res').text = ${tl}['res']
    -- the interrupted mark, in the same muted line as `who` (hidden unless the turn was interrupted)
    (base + ':cut').parent = base
    (base + ':cut').tag = 'div'
    (base + ':cut').class = 'who'
    (base + ':cut').hidden = ${this.view}['cut'] == ''
    (base + ':cut').text = ${this.view}['cut']
    (base + ':tools').parent = base
    (base + ':tools').tag = 'details'
    (base + ':tools').class = 'tools-run'
    (base + ':tools').hidden = ${this.view}['tools_n'] == 0 or ${this.view}['running']
    (base + ':tools:sum').parent = base + ':tools'
    (base + ':tools:sum').tag = 'summary'
    (base + ':tools:sum').text = str(${this.view}['tools_n']) + (' tool call' if ${this.view}['tools_n'] == 1 else ' tool calls')
    (base + ':tools:list').parent = base + ':tools'
    (base + ':tools:list').tag = 'ul'
    FOR tl IN ${this.view}['tools']:
      (base + ':tools:t:' + ${tl}['k']).parent = base + ':tools:list'
      (base + ':tools:t:' + ${tl}['k']).tag = 'li'
      (base + ':tools:t:' + ${tl}['k'] + ':name').parent = base + ':tools:t:' + ${tl}['k']
      (base + ':tools:t:' + ${tl}['k'] + ':name').tag = 'code'
      (base + ':tools:t:' + ${tl}['k'] + ':name').class = 'tname'
      (base + ':tools:t:' + ${tl}['k'] + ':name').text = ${tl}['name']
      (base + ':tools:t:' + ${tl}['k'] + ':in').parent = base + ':tools:t:' + ${tl}['k']
      (base + ':tools:t:' + ${tl}['k'] + ':in').tag = 'span'
      (base + ':tools:t:' + ${tl}['k'] + ':in').class = 'tin'
      (base + ':tools:t:' + ${tl}['k'] + ':in').text = ${tl}['in']

-- the log is kept at the bottom: after a row is drawn, unless the person scrolled up (`near` false; no scroll seen yet counts as near). The shell scrolls
-- after the round's other writes, so the new row is already in the log.
ChatRow.view on-setter chat-stick:
  WHEN this.view != None and ${'View:chat'}['near'] != False:
    ('DomNode:chat:log').scroll = 'end'

-- ---- the composer ----
DomNode.value on-setter chat-draft:
  WHEN this.eid == 'DomNode:chat:input': ('Composer:chat').draft = this.value
-- Enter without Shift sends (an Enter that ends an IME composition does not); the form's submit (the Send button) sends
DomNode.key on-setter chat-enter:
  WHEN this.eid == 'DomNode:chat:input' and ${this.key}['key'] == 'Enter' and not ${this.key}['shift'] and not ${this.key}['composing']:
    ('Composer:chat').go = (${'Composer:chat'}['go'] or 0) + 1
DomNode.submitted on-setter chat-submit:
  WHEN this.eid == 'DomNode:chat:form': ('Composer:chat').go = (${'Composer:chat'}['go'] or 0) + 1

-- ONE POST at a time: while `sending` a second Enter or click does nothing (the double-submit guard, a rule of the pack)
Composer.go on-setter chat-send:
  WHEN not this.sending and strip(str(this.draft or '')) != '':
    n = (${'View:chat'}['seq'] or 0) + 1
    ('View:chat').seq = n
    this.error = ''
    this.sending = True
    ('Fetch:send').request = {'timeout_s': ${'View:chat'}['timeout_s'], 'id': 'send-' + str(n), 'url': '/membrane/chat/message', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'text': strip(str(this.draft))})}

-- both controls are disabled while a POST is out; a disabled box loses the focus, so it is let go while sending and given back after (the legacy `input.focus()`)
Composer.sending on-setter chat-lock:
  ALWAYS:
    ('DomNode:chat:input').disabled = this.sending
    ('DomNode:chat:send').disabled = this.sending
    ('DomNode:chat:input').focused = not this.sending

-- the note of a failed send is shown until the next attempt (the legacy chat took it away after 8 s: a constant this slice does not carry)
Composer.error on-setter chat-note:
  ALWAYS:
    ('DomNode:chat:note').hidden = not this.error
    ('DomNode:chat:note:bubble').text = this.error or ''

-- ---- STOP: while a turn runs the composer shows Stop (it goes when none runs); a click asks the seat to end the running turn of each running message
-- (`POST /membrane/chat/message/<id>/abort`, packs/chat.c1f): the turn ends on the seat as an error that keeps the answer so far and says it was stopped, and the next read of the turns shows it. A
-- stop the seat did not take is said as text in the note line; one click is one stop until the seat has answered it (`stopping`).
ChatRow.state on-setter chat-stop-show:
  ALWAYS:
    ('DomNode:chat:stop').hidden = len([r for r in instances('ChatRow') if r.state == 'running']) == 0
DomNode.clicked on-setter chat-stop-click:
  WHEN this.eid == 'DomNode:chat:stop' and not ${'View:chat'}['stopping']:
    ('View:chat').stopping = True
    FOR rid IN [r.rid for r in instances('ChatRow') if r.state == 'running']:
      ('Fetch:stop:' + rid).request = {'timeout_s': ${'View:chat'}['timeout_s'], 'id': 'stop-' + rid, 'url': '/membrane/chat/message/' + rid + '/abort', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': '{}'}
View.stopping on-setter chat-stop-label:
  ALWAYS:
    ('DomNode:chat:stop').disabled = this.stopping == True
    ('DomNode:chat:stop').text = 'Stopping…' if this.stopping == True else 'Stop'

-- ---- the receipts: what a call answered, read once, as the legacy chat read it ----
-- ok = the call went and the seat said 2xx; `why` is what the note says (the seat's own `error`, else the status, else the network's reason)
Fetch.cv getter:
  rq = this.request_result
  bd = json(str(${rq}['body'] or ''))
  jb = {} if bd is Error else bd
  hs = ${rq}['http_status']
  good = ${rq}['status'] == 'ok' and hs != None and hs >= 200 and hs < 300
  {'rid': ${rq}['id'], 'ok': good, 'id': str(${jb}['id'] or ''), 'why': (str(${jb}['error']) if ${jb}['error'] else 'the seat answered ' + str(hs)) if ${rq}['status'] == 'ok' else str(${rq}['head'] or 'the request failed'), 'messages': ${jb}['messages'], 'more': ${jb}['more'] == True, 'next': ${jb}['next'], 'import': ${jb}['import']} if rq != None else None

-- a stop the seat did not take is said in text (the turn goes on: the button stays while it runs); either way the stop is over and the turns are read again at once
Fetch.cv on-setter chat-stop-done:
  WHEN startswith(this.eid, 'Fetch:stop:') and this.cv != None:
    ('View:chat').stopping = False
    ('View:chat').last_poll = 0
    ('Composer:chat').error = '' if ${this.cv}['ok'] else 'Stop did not reach the seat: ' + str(${this.cv}['why']) + '. The turn is still running; try again.'
    ('DomNode:chat:input').focused = True

-- a read of the turns that fails (or times out) is said in text, and the line goes with the next good answer
Fetch.cv on-setter chat-history-note:
  WHEN this.eid == 'Fetch:history':
    ('DomNode:chat:pollnote').hidden = ${this.cv}['ok'] == True
    ('DomNode:chat:pollnote').text = '' if ${this.cv}['ok'] == True else 'The seat did not answer the last read of the turns (' + str(${this.cv}['why']) + '); the view asks again.'

-- THE HISTORY CUTOVER (packs/legacy_cutover.c1f): while the earlier seat's history is imported in the background the seat's answer carries `import`, a plain line (the progress, or the reason it failed);
-- it is shown here and goes away with the first answer that has none (the import is done)
Fetch.cv on-setter chat-import-line:
  WHEN this.eid == 'Fetch:history' and ${this.cv}['ok']:
    ('DomNode:chat:import').hidden = ${this.cv}['import'] == None
    ('DomNode:chat:import').text = str(${this.cv}['import'] or '')

-- the newest page: the first load also holds the cursor of the older turns (legacy `load`); a poll only draws what is new or changed
Fetch.cv on-setter chat-history-done:
  WHEN this.eid == 'Fetch:history':
    -- a read that did not succeed leaves the page owing it: `owing` makes the view due again on the next tick (not in this round: the same answer cannot also start the next read)
    ('View:chat').owing = ${this.cv}['ok'] != True
    ('View:chat').polling = False
    ('View:chat').last_poll = clock
Fetch.cv on-setter chat-history-first:
  WHEN this.eid == 'Fetch:history' and ${this.cv}['ok'] and ${this.cv}['messages'] != None and startswith(str(${this.cv}['rid']), 'load') and not ${'View:chat'}['loaded']:
    ('View:chat').loaded = True
    -- while the import goes on, older turns may still arrive: the button stays, and asks for what is older than the oldest turn shown
    ('View:chat').next = ${this.cv}['next'] if ${this.cv}['more'] else (${${this.cv}['messages'][0]}['id'] if ${this.cv}['import'] != None and len(${this.cv}['messages']) > 0 else None)
    ('DomNode:chat:older').hidden = not ${this.cv}['more'] and (${this.cv}['import'] == None or len(${this.cv}['messages']) == 0)
Fetch.cv on-setter chat-history-rows:
  WHEN this.eid == 'Fetch:history' and ${this.cv}['ok']:
    FOR m IN (${this.cv}['messages'] or []):
      ('ChatRow:' + str(${m}['id'])).born = True
      ('ChatRow:' + str(${m}['id'])).raw = m

-- ---- the polls: a rule on the clock (the shell ticks it): `list_ms` after the last answer, `active_ms` while a turn is not finished; one request at a time ----
-- THE DOORBELL (#1143, the graph link slice 2, docs/graph-link.md decision 10): when the page's link to the seat is up (`Link:page.up`, fieldvm.js `Link`) the view subscribes ONE value, `membrane::Doorbell:chat.at` (the time
-- of the last message posted or turn change: packs/chat.c1f; the seat never serves the chat itself), and the history route is read ONLY when it changed (`owed` counts the rings, `served` the ones a read has covered), or right after
-- a send / a stop (`last_poll` 0). No timer then: an idle page reads nothing. A hidden page keeps what it owes and reads it once when it is visible. When the link is not up the timers below are the fallback, as before.
View.linked getter: ${'Link:page'}['up'] == True
View.bell getter: ${'membrane::Doorbell:chat'}['at'] if this.linked else None
View.bell on-setter chat-bell:
  WHEN this.bell != None:
    this.owed = (this.owed or 0) + 1
View.due getter: this.open == True and not this.polling and not ${'Conn:page'}['hidden'] and ((this.linked and ((this.owed or 0) != (this.served or 0) or this.last_poll == 0 or (this.owing == True and this.tick > (this.last_poll or 0)))) or (not this.linked and this.tick - (this.last_poll or 0) >= (this.active_ms if len([r for r in instances('ChatRow') if not r.done]) > 0 else this.list_ms) / 1000))
View.due on-setter chat-poll:
  WHEN this.due == True:
    n = (this.seq or 0) + 1
    this.seq = n
    this.polling = True
    this.served = this.owed or 0
    ('Fetch:history').request = {'timeout_s': this.timeout_s, 'id': 'poll-' + str(n), 'url': '/membrane/chat/messages?limit=' + str(this.poll_size)}

-- ---- the send: a 2xx with an id puts the message in the log at once (queued) and clears the box; anything else is the note and the draft stays ----
Fetch.cv on-setter chat-sent:
  WHEN this.eid == 'Fetch:send' and ${this.cv}['ok'] and ${this.cv}['id'] != '':
    sid = ${this.cv}['id']
    ('ChatRow:' + sid).born = True
    ('ChatRow:' + sid).raw = {'id': sid, 'text': strip(str(${'Composer:chat'}['draft'] or '')), 'state': 'queued', 'tools': []}
    ('View:chat').last_poll = 0
    ('Composer:chat').sending = False
    ('Composer:chat').draft = ''
    ('DomNode:chat:input').value = ''
  ELSE WHEN this.eid == 'Fetch:send':
    ('Composer:chat').sending = False
    ('Composer:chat').error = 'The message did not reach the seat: ' + str(${this.cv}['why']) + '. It is still in the box; send it again when the seat is back.'

-- ---- "Load older turns": the page before the oldest loaded; the turns are drawn again, oldest first, in a NEW list (the shell has no ordered children) ----
DomNode.clicked on-setter chat-older-click:
  WHEN this.eid == 'DomNode:chat:older:btn' and not ${'View:chat'}['older_out'] and ${'View:chat'}['next'] != None:
    n = (${'View:chat'}['seq'] or 0) + 1
    ('View:chat').seq = n
    ('View:chat').older_out = True
    ('DomNode:chat:older:btn').disabled = True
    ('Fetch:older').request = {'timeout_s': ${'View:chat'}['timeout_s'], 'id': 'older-' + str(n), 'url': '/membrane/chat/messages?limit=' + str(${'View:chat'}['page_size']) + '&before=' + str(${'View:chat'}['next'])}
Fetch.cv on-setter chat-older-rows:
  WHEN this.eid == 'Fetch:older' and ${this.cv}['ok'] and ${this.cv}['messages'] != None:
    oldest = ([${e}['eid'] for e in sort_by(sort_by([{'eid': 'DomNode:chat:row:' + r.rid, 'ms': r.ms, 'nr': r.nr} for r in instances('ChatRow')], 'nr'), 'ms')] or [None])[0]
    fresh = [m for m in ${this.cv}['messages'] if ${'ChatRow:' + str(${m}['id'])}['raw'] == None]
    FOR m IN fresh:
      ('DomNode:chat:row:' + str(${m}['id'])).before = oldest
    FOR m IN ${this.cv}['messages']:
      ('ChatRow:' + str(${m}['id'])).born = True
      ('ChatRow:' + str(${m}['id'])).raw = m
    -- while the import goes on, the turns older than these may not be in yet: the button stays and asks again from the oldest turn shown
    ('View:chat').next = ${this.cv}['next'] if ${this.cv}['more'] else ((${${this.cv}['messages'][0]}['id'] if len(${this.cv}['messages']) > 0 else ${'View:chat'}['next']) if ${this.cv}['import'] != None else None)
    ('View:chat').older_out = False
    ('DomNode:chat:older').hidden = not ${this.cv}['more'] and ${this.cv}['import'] == None
    ('DomNode:chat:older:btn').text = 'Load older turns'
    ('DomNode:chat:older:btn').disabled = False
  ELSE WHEN this.eid == 'Fetch:older':
    ('View:chat').older_out = False
    ('DomNode:chat:older:btn').text = 'Load older turns (the seat did not answer: try again)'
    ('DomNode:chat:older:btn').disabled = False

-- ---- the log's scroll: near the bottom within `stick_px`; a pack write of `scroll` (the command 'end', no height) is not a measure ----
DomNode.scroll on-setter chat-scroll:
  WHEN this.eid == 'DomNode:chat:log' and ${this.scroll}['height'] != None:
    ('View:chat').near = ${this.scroll}['height'] - ${this.scroll}['top'] - ${this.scroll}['client'] < ${'View:chat'}['stick_px']
