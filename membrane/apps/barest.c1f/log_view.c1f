PACK log_view 1
IMPORT dom 1
IMPORT fetch 1
IMPORT shell_view 1
-- THE SEAT'S LOG TAB (#1143, operator 2026-11-20: the Log tab does not depend on a peer). A PAGE pack (it imports `dom`: the seat sends it with `GET /ui/fieldvm`), a tab in the shell (`Nav:log`, the view-pack contract of
-- docs/ui-rebuild-plan.md) with two sections, and nothing in it names a peer:
--   1. the LATEST lines of the seat's boundary log, one per change: `n eid.prop op by writer`, followed while the tab is the one in front;
--   2. the raw chat with the model, `ModelChat:main` (packs/model_chat.c1f): every turn, whichever rung answered it (claude CLI, OpenAI-compatible, ollama, a peer such as membrama), as the model had it.
-- THE TAB IS THE SEAT'S, A PEER ADDS A SECTION: this pack owns `Nav:log` and its root `DomNode:log:root` (a scrolling column); a peer that has more to show (membrama's loop) draws its own section as DomNodes parented
-- to `DomNode:log:root` while `Nav:log` is active, and reads its own cells by the door. It never writes `Nav:log` or a node of this pack's. With no peer there is no extra section and nothing is missing.
-- THE PAGE READS BY ITS LINK (#1143, operator 2026-11-24): `membrane::LogView:<its ns>` (its `head` and `rows`) and `membrane::ModelChat:main` (its `text`) are VALUES the seat pushes to the page (docs/graph-link.md,
-- the allow-list `LinkAllow:logview` and `LinkAllow:modelchat`); the page polls nothing. It still ASKS with the door (`POST /mcp`, `entity_write`, as link_view.c1f does: a page's write is not on the link yet): it writes
-- `<its ns>::LogAsk:main` (`from`, then `n`, a count: the cache breaker), and the rows of that ask arrive as the view's `rows`.
--   on open       one ask (`n` only, from 0), read `head`; then ask from max(0, head - (200 - 1)), so the page shows the last 200 lines
--   on the tick   the shell's own (`Shell.tick`, at the shell's `status_ms`), only while the tab is active: ask from the line after the last one shown (a new `n`), read `rows`, append, keep the last 200
-- 200 is the seat's own page size (packs/logview.c1f). The two writes of an ask are `Fetch:log:from` and `Fetch:log:n`, one POST each, chained by their receipts; the answer is the `rows` the link brings. A call that fails is `LogTab:main.note`,
-- shown on the tab. The tab scrolls (`panelrows`) and stays at the bottom unless the person scrolled up (`near`, by the chat's own `stick_px`); "Load older lines" puts the 200 lines before the first one above it. The guard pack removes this tab when membrama's link is not up.
--   LogTab:main   `first` (the number of the first line shown), `pages` (loads the person asked for: the cap of lines is 200 x pages), `more`, `near`, `holding`, `older_out`, `phase` (None, 'head', 'follow'), `step` (from, n, read, headread), `last` (the number of the last line shown), `lines`, `seq`, `polling`, `last_poll`, `note`

Shell.open on-setter log-view-register:
  WHEN this.open:
    ('Nav:log').title = 'Log'
    ('Nav:log').order = 85

Nav.active on-setter log-view-draw:
  WHEN this.eid == 'Nav:log' and this.active == True:
    ('DomNode:log:root').tag = 'div'
    ('DomNode:log:root').class = 'panelrows'
    ('DomNode:log:root').parent = 'DomNode:shell:slot:log'
    ('DomNode:log:older').parent = 'DomNode:log:root'
    ('DomNode:log:older').tag = 'div'
    ('DomNode:log:older').hidden = True
    ('DomNode:log:older:btn').parent = 'DomNode:log:older'
    ('DomNode:log:older:btn').tag = 'button'
    ('DomNode:log:older:btn').type = 'button'
    ('DomNode:log:older:btn').text = 'Load older lines'
    ('DomNode:log:text').parent = 'DomNode:log:root'
    ('DomNode:log:text').tag = 'pre'
    ('DomNode:log:chathead').parent = 'DomNode:log:root'
    ('DomNode:log:chathead').tag = 'div'
    ('DomNode:log:chathead').text = 'Chat with the model (raw: the prompt, the reply with its thinking, each call and its result; the oldest text drops first)'
    ('DomNode:log:chat').parent = 'DomNode:log:root'
    ('DomNode:log:chat').tag = 'pre'
    ('Nav:log').filled = True
    ('LogTab:main').on = True
    ('LogChat:main').on = True

LogTab.ns getter: ${'Link:page'}['ns']
LogTab.text getter: join(this.lines or [], '\n') + (('\n' if this.lines else '') + str(this.note) if this.note else '')
-- the button shows while there are older lines than the first one shown
LogTab.more getter: this.first != None and this.first > 0
LogTab.more on-setter log-view-more:
  WHEN this.on == True:
    ('DomNode:log:older').hidden = not this.more
-- the lines are kept at the bottom after they are drawn, unless the person scrolled up (`near` false; no scroll seen yet counts as near) or older lines were just put above (`holding`)
LogTab.text on-setter log-view-text:
  WHEN this.on == True and this.near != False and not this.holding:
    ('DomNode:log:text').text = this.text
    ('DomNode:log:root').scroll = 'end'
  ELSE WHEN this.on == True:
    ('DomNode:log:text').text = this.text
LogTab.on on-setter log-view-first:
  WHEN this.on == True:
    ('DomNode:log:text').text = this.text
-- near the bottom within the chat's own `stick_px` (the owner's number); a pack write of `scroll` (the command 'end', no height) is not a measure; no chat view counts as near
DomNode.scroll on-setter log-view-scroll:
  WHEN this.eid == 'DomNode:log:root' and ${this.scroll}['height'] != None:
    ('LogTab:main').near = ${'View:chat'}['stick_px'] == None or ${this.scroll}['height'] - ${this.scroll}['top'] - ${this.scroll}['client'] < ${'View:chat'}['stick_px']
-- "Load older lines": the page before the first one shown (200 lines, the seat's page size); the same chain of calls, asked from max(0, first - 200)
DomNode.clicked on-setter log-view-older-click:
  WHEN this.eid == 'DomNode:log:older:btn' and not ${'LogTab:main'}['polling'] and ${'LogTab:main'}['more'] == True:
    n = (${'LogTab:main'}['seq'] or 0) + 1
    ('LogTab:main').seq = n
    ('LogTab:main').polling = True
    ('LogTab:main').older_out = True
    ('LogTab:main').holding = True
    ('LogTab:main').step = 'from'
    ('Fetch:log:from').request = {'timeout_s': 10, 'id': 'log-from-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': ${'LogTab:main'}['ns'] + '::LogAsk:main', 'prop': 'from', 'value': max(0, ${'LogTab:main'}['first'] - 200)}}})}

-- the receipt of a call, read once: ok = the seat answered 2xx and the call has no error; `text` is what the door's tool answered
Fetch.mq getter:
  rq = this.request_result
  bd = json(str(${rq}['body'] or ''))
  jd = bd if bd is Dict else {}
  hs = ${rq}['http_status']
  cs = ${${jd}['result']}['content'] or []
  er = ${jd}['error']
  {'ok': ${rq}['status'] == 'ok' and hs != None and hs >= 200 and hs < 300 and not er and not ${${jd}['result']}['isError'], 'text': ${cs[0]}['text'] if len(cs) > 0 else None, 'why': (str(${er}['message'] if er is Dict else (er or ${${jd}['result']}['content'])) if (er or ${${jd}['result']}['isError']) else 'the seat answered ' + str(hs)) if ${rq}['status'] == 'ok' else str(${rq}['head'] or 'the request failed')} if rq != None else None

-- the seat's view and what it holds, as the link brings them (read only while the tab is on and the link is up: the read is the subscription)
LogTab.view getter: 'membrane::LogView:' + str(this.ns) if this.ns != None else None
LogTab.live getter: this.on == True and ${'Link:page'}['up'] == True and this.view != None
LogTab.head getter: ${this.view}['head'] if this.live else None
LogTab.vrows getter: ${this.view}['rows'] if this.live else None

-- an ask starts on the shell's tick, while the tab is in front, the link is up and none is running; the first one finds the head
Shell.tick on-setter log-view-poll:
  WHEN this.open and ${'Nav:log'}['active'] == True and ${'LogTab:main'}['ns'] != None and ${'Link:page'}['up'] == True and not ${'LogTab:main'}['polling'] and not ${'Conn:page'}['hidden'] and this.tick - (${'LogTab:main'}['last_poll'] or 0) >= this.status_ms / 1000 and ${'LogTab:main'}['phase'] == None:
    n = (${'LogTab:main'}['seq'] or 0) + 1
    ('LogTab:main').seq = n
    ('LogTab:main').polling = True
    ('LogTab:main').phase = 'head'
    ('LogTab:main').step = 'n'
    ('Fetch:log:n').request = {'timeout_s': 10, 'id': 'log-n-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': ${'LogTab:main'}['ns'] + '::LogAsk:main', 'prop': 'n', 'value': n}}})}
  ELSE WHEN this.open and ${'Nav:log'}['active'] == True and ${'LogTab:main'}['ns'] != None and ${'Link:page'}['up'] == True and not ${'LogTab:main'}['polling'] and not ${'Conn:page'}['hidden'] and this.tick - (${'LogTab:main'}['last_poll'] or 0) >= this.status_ms / 1000 and ${'LogTab:main'}['phase'] == 'follow':
    n = (${'LogTab:main'}['seq'] or 0) + 1
    ('LogTab:main').seq = n
    ('LogTab:main').polling = True
    ('LogTab:main').step = 'from'
    ('Fetch:log:from').request = {'timeout_s': 10, 'id': 'log-from-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': ${'LogTab:main'}['ns'] + '::LogAsk:main', 'prop': 'from', 'value': ${'LogTab:main'}['last'] + 1}}})}

-- the two writes of an ask, one after the other, by their receipts; the answer is the view's `rows` (below)
Fetch.mq on-setter log-view-step:
  WHEN startswith(this.eid, 'Fetch:log:') and this.mq != None and not ${this.mq}['ok']:
    ('LogTab:main').note = 'the seat did not answer the log tab (' + this.eid + '): ' + str(${this.mq}['why'])
    ('LogTab:main').polling = False
    ('LogTab:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:log:from' and this.mq != None and ${'LogTab:main'}['step'] == 'from':
    ('LogTab:main').step = 'n'
    ('Fetch:log:n').request = {'timeout_s': 10, 'id': 'log-n-' + str(${'LogTab:main'}['seq']), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': ${'LogTab:main'}['seq'], 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': ${'LogTab:main'}['ns'] + '::LogAsk:main', 'prop': 'n', 'value': ${'LogTab:main'}['seq']}}})}
  ELSE WHEN this.eid == 'Fetch:log:n' and this.mq != None and ${'LogTab:main'}['step'] == 'n' and ${'LogTab:main'}['phase'] == 'head':
    ('LogTab:main').step = None
    ('LogTab:main').note = None
    ('LogTab:main').found = True
  ELSE WHEN this.eid == 'Fetch:log:n' and this.mq != None and ${'LogTab:main'}['step'] == 'n':
    ('LogTab:main').step = None
    ('LogTab:main').note = None
    ('LogTab:main').polling = False
    ('LogTab:main').last_poll = clock

-- the first ask found the head: the page shows the last 200 lines, so the next ask is from the line after `head - 199`. The head may come with the receipt or after it, whichever is last
LogTab.found on-setter log-view-found:
  WHEN this.found == True and this.phase == 'head' and (this.head is Int or this.head is Float):
    this.last = max(0, this.head - 199) - 1
    this.first = max(0, this.head - 199)
    this.phase = 'follow'
    this.found = False
    this.polling = False
    this.last_poll = 0
LogTab.head on-setter log-view-head:
  WHEN this.found == True and this.phase == 'head' and (this.head is Int or this.head is Float):
    this.last = max(0, this.head - 199) - 1
    this.first = max(0, this.head - 199)
    this.phase = 'follow'
    this.found = False
    this.polling = False
    this.last_poll = 0

-- the rows of the last ask arrive as the view's `rows`: older lines when "Load older lines" asked, the lines after the last one shown otherwise
LogTab.vrows on-setter log-view-rows:
  WHEN this.vrows is List and this.phase == 'follow' and this.older_out == True:
    ow = [r for r in this.vrows if ${r}['n'] < this.first]
    this.older_out = False
    this.pages = (this.pages or 1) + 1
    this.first = min([${r}['n'] for r in ow]) if len(ow) > 0 else this.first
    this.lines = concat([str(${r}['n']) + ' ' + str(${r}['eid']) + '.' + str(${r}['prop']) + ' ' + str(${r}['op']) + ' by ' + str(${r}['writer']) for r in ow], this.lines or [])
    this.note = None
    this.polling = False
    this.last_poll = clock
  ELSE WHEN this.vrows is List and this.phase == 'follow':
    rw = [r for r in this.vrows if ${r}['n'] > (this.last if this.last != None else -1)]
    nl = tail(concat(this.lines or [], [str(${r}['n']) + ' ' + str(${r}['eid']) + '.' + str(${r}['prop']) + ' ' + str(${r}['op']) + ' by ' + str(${r}['writer']) for r in rw]), 200 * (this.pages or 1))
    this.holding = False
    this.last = max([${r}['n'] for r in rw]) if len(rw) > 0 else this.last
    this.first = (max([${r}['n'] for r in rw]) - len(nl) + 1) if len(rw) > 0 else this.first
    this.lines = nl
    this.note = None

-- THE RAW CHAT WITH THE MODEL, under the log lines: the seat's own `ModelChat:main`, a value the link brings (`membrane::ModelChat:main.text`, bounded by the link's value size: the oldest text drops first, packs/model_chat.c1f),
-- read while the tab is in front and the link is up. Its own state `LogChat:main`.
LogChat.text getter: ${'membrane::ModelChat:main'}['text'] if ${'Link:page'}['up'] == True and ${'Nav:log'}['active'] == True else None
LogChat.shown getter: str(this.text or '') or '(nothing yet: no model has been asked anything)'
LogChat.full getter: this.shown + (('\n' + str(this.note)) if this.note else '')
LogChat.full on-setter log-view-chat-show:
  WHEN ${'Nav:log'}['filled'] == True:
    ('DomNode:log:chat').text = this.full
LogChat.on on-setter log-view-chat-first:
  WHEN this.on == True:
    ('DomNode:log:chat').text = this.full
