#!/bin/sh
# Start the FULL-set seat: the standalone cliffvm on every shipped pack (membrane/packs, boot first) serving the current page (membrane/ui),
# the claude CLI as the only model backend, the router off. The step before the swap (docs/release-parity.md, docs/cliffvm.md "The full-set seat").
# Builds nothing: build the binary once with `cargo build --release --no-default-features --features bin` in native/.
#   scripts/seat-full [--data-dir <dir>] [--port <n>] [--open] [--fact name=value ...]
# --data-dir  where the seat keeps its store, its door secret and its page log (default ./.cliffvm/full); --port the door's port (default 4310)
# --fact is repeatable: each one is passed on to `cliffvm run` as a Boot fact, AFTER the defaults below, so it wins (e.g. --fact operator=ann).
# The door secret is <data-dir>/door.secret, generated on the first run (64 hex characters, mode 0600) and kept. A page fetched from this machine
# is given its owner cookie; anything else needs a JWT signed with that secret.
# CLIFFVM names the binary, CLAUDE_BIN the claude CLI (else the one on PATH). Run it from anywhere; it works from the repo root.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
data=./.cliffvm/full
port=4310
open_page=0
facts=''   # the operator's --fact arguments, one per line (a fact has no newline)
while [ $# -gt 0 ]; do
  case "$1" in
    --data-dir) data=${2:?--data-dir needs a folder}; shift 2 ;;
    --port) port=${2:?--port needs a number}; shift 2 ;;
    --open) open_page=1; shift ;;
    --fact) facts="$facts${facts:+
}${2:?--fact needs name=value}"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "scripts/seat-full: unknown option $1 (--data-dir <dir> --port <n> --open --fact name=value)" >&2; exit 2 ;;
  esac
done
bin=${CLIFFVM:-}
[ -n "$bin" ] || { [ -x "$root/native/target/release/cliffvm" ] && bin=$root/native/target/release/cliffvm; } || true
[ -n "$bin" ] || bin=$(command -v cliffvm || true)
if [ -z "$bin" ]; then
  echo "scripts/seat-full: cliffvm is not built yet. Build it once:" >&2
  echo "  (cd $root/native && cargo build --release --no-default-features --features bin)" >&2
  echo "or point CLIFFVM at the binary." >&2
  exit 1
fi
claude=${CLAUDE_BIN:-$(command -v claude || true)}
mkdir -p "$data"
data=$(cd "$data" && pwd)
secret=$data/door.secret
if [ ! -s "$secret" ]; then
  # first run: a random secret (32 bytes as 64 hex characters; the door wants at least 32 bytes), readable by this person only
  ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$secret" )
  chmod 600 "$secret"
  echo "seat-full: made the door secret $secret (mode 600)"
fi
cd "$root"
# the defaults: claude is the only model (a rung of the router's registry, picked for every mind), the router is off, the local backend
# is the default Ollama address (nothing needs to run there: a refused connection is an empty tag list)
minds='{"loops":"claude","cortex":"claude","workers":"claude","seat_default":"claude","loops_auth":"chat","cortex_auth":"chat","workers_auth":"chat","think":"auto"}'
cloud='[{"name":"claude","backend":"claude-agent"}]'
set -- membrane/packs/boot.c1f membrane/packs --store "$data/seat.sqlite" --port "$port" --ui-dir membrane/ui \
  --fact "door_secret_file=$secret" --fact "seat_data_dir=$data" --fact "minds=$minds" --fact "seat_backend=http://127.0.0.1:11434" \
  --fact "router_on=false" --fact "cloud_models=$cloud"
if [ -n "$claude" ]; then
  set -- "$@" --fact "chat_claude_bin=$claude"
else
  echo "scripts/seat-full: the chat answers through the claude CLI. Name it with CLAUDE_BIN=/path/to/claude scripts/seat-full." >&2
fi
if [ -n "$facts" ]; then
  oldifs=$IFS; IFS='
'
  for f in $facts; do set -- "$@" --fact "$f"; done
  IFS=$oldifs
fi
url="http://127.0.0.1:$port/"
echo "seat-full: $url  (data $data)"
if [ "$open_page" = 1 ] && [ "$(uname)" = Darwin ]; then (sleep 2; open "$url") & fi
exec "$bin" run "$@"
